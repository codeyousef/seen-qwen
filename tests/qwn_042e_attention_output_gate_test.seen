import seen_qwen.backend.cuda.reference_primitives.{QwenCudaBufferView,
    QWEN_CUDA_REFERENCE_ABI_VERSION, qwenCudaAttentionOutputGate}

fun main() r: Int {
    let empty = QwenCudaBufferView{
        abiVersion: QWEN_CUDA_REFERENCE_ABI_VERSION,
        deviceOrdinal: 0 as Int32,
        address: 0 as UInt64,
        byteLength: 0 as UInt64 }
    let invalid = qwenCudaAttentionOutputGate(
        null, empty, empty, empty,
        0 as UInt64, 24 as UInt64, 256 as UInt64)
    if not invalid.isErr() { return 1 }
    println("PASS: QWN-042E checked attention output-gate projection boundary")
    return 0
}

main()
