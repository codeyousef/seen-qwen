import core.error.{AsciiString}
import core.operation_context.{OperationContext, OperationLimits}
import fs.file.{File}
import fs.operations.{createDirectoryPath, removeSingle}
import fs.types.{DirectIoPolicy, OpenOptions, Path}
import io.file.{readText}
import seen_qwen.formats.sqw_reader.{SqwReader, SqwReaderPolicy}
import seen_qwen.formats.sqw_writer.{SqwWriter}
import seen_qwen.converter.conversion_evidence.{QwenConversionIdentity,
    QwenTensorChecksum, QwenTensorEvidence, releaseQwenJournalText,
    renderQwenResumeJournal}
import seen_qwen.converter.conversion_finalizer.{finalizeQwenConversion}
import seen_qwen.converter.conversion_plan.{buildQwen38ConversionPlan}
import seen_qwen.model.config.{parseQwen38Config}
import seen_qwen.model.tensor_catalog.{parseQwenTensorCatalog}
import str.string.{replaceFirst}

extern "C" fun seen_string_release_owned(value: String) r: Void

let SOURCE: String = ".seen/ci/output/qwn_032d/valid.sqw"
let CORRUPT_SOURCE: String = ".seen/ci/output/qwn_032d/corrupt_payload.sqw"
let TRUNCATED_SOURCE: String = ".seen/ci/output/qwn_032d/truncated.sqw"
let REORDERED_JOURNAL: String =
    ".seen/ci/output/qwn_032d/reordered_journal.json"
let DESTINATION: String = ".seen/ci/output/qwn_032d/runtime/promoted.sqw"
let MODEL_LOCK: String =
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
let SOURCE_LOCK: String =
    "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
let CONVERSION_POLICY: String =
    "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
let CATALOG: String =
    "5f466d43bae3059e54f0bfe183d0e82c822242f45a834d778414d3e5b5248f1f"
let COMPATIBILITY: String =
    "f39aebda1fdafc20d04b6c6a0072a491afea3f8f9ab836fd173ead0d1fe1ea33"
let WHOLE_SHA256: String =
    "4de515a72a029f7e03847485d40fc6a0a8975aa07d81f984a4cbb5f14da4c9a1"
let MIDDLE_NAME: String =
    "model.language_model.layers.38.linear_attn.in_proj_z.weight"
let LAST_NAME: String = "mtp.pre_fc_norm_hidden.weight"

fun require(condition: Bool, message: String) r: Void {
    if not condition { abort(message) }
}

fun context() r: OperationContext {
    return OperationContext{
        cancellation: false, monotonicDeadline: 0 as Int64,
        limits: OperationLimits{
            maxTargets: 8, maxIdentityBytes: 128, maxVersionBytes: 128,
            maxManifestBytes: 16777216, maxPathBytes: 4095,
            maxGraphModules: 4096, maxGraphEdges: 65536,
            maxGraphDepth: 128,
        },
        traceId: AsciiString{ value: "qwn-032d" },
    }
}

fun policy() r: SqwReaderPolicy {
    return SqwReaderPolicy.exact(MODEL_LOCK, SOURCE_LOCK,
        CONVERSION_POLICY, CATALOG, WHOLE_SHA256, 866 as UInt32, 4)
}

fun discardPath(path: String) r: Void {
    let parsed = Path.fromString(path)
    if parsed.isErr() { return }
    let _discarded = removeSingle(parsed.unwrap(), false)
}

fun ensureOutputDirectory() r: Void {
    let parsed = Path.fromString(".seen/ci/output/qwn_032d/runtime")
    require(parsed.isOkay(), "finalizer output path must be valid")
    let created = createDirectoryPath(context(), parsed.unwrap(),
        448 as UInt64)
    if created.isErr() {
        require(created.unwrapErr().code == "fs.exists",
            "create or reuse finalizer output directory")
    }
}

fun readFixture(path: String) r: Array<Int> {
    let parsed = Path.fromString(path)
    require(parsed.isOkay(), "fixture path must be valid")
    let opened = File.open(context(), parsed.unwrap(), OpenOptions.readOnly(),
        DirectIoPolicy.Off)
    require(opened.isOkay(), "open bounded finalizer fixture")
    let file = opened.unwrap()
    let metadata = file.metadata(context())
    require(metadata.isOkay() and metadata.unwrap().size > (0 as UInt64) and
        metadata.unwrap().size <= (2097152 as UInt64),
        "finalizer fixture must remain within 2 MiB")
    let bytes = Array<Int>()
    var index = 0
    while index < (metadata.unwrap().size as Int) {
        bytes.push(0); index = index + 1
    }
    let read = file.readAt(context(), 0 as UInt64, bytes, 0, bytes.length())
    require(read.isOkay() and read.unwrap() == bytes.length(),
        "read complete finalizer fixture")
    require(file.close().isOkay(), "close finalizer fixture")
    return bytes
}

fun writeInChunks(borrow writer: SqwWriter, bytes: Array<Int>) r: Void {
    var offset = 0
    while offset < bytes.length() {
        var count = 65536
        if count > bytes.length() - offset { count = bytes.length() - offset }
        let chunk = Array<Int>()
        var index = 0
        while index < count {
            chunk.push(bytes[offset + index]); index = index + 1
        }
        require(writer.write(chunk).isOkay(), "write bounded SQW fixture chunk")
        chunk.free(); offset = offset + count
    }
}

fun stagedWriter(source: String) r: SqwWriter {
    let bytes = readFixture(source)
    let begun = SqwWriter.begin(DESTINATION, bytes.length() as UInt64,
        65536, true, context(), policy())
    require(begun.isOkay(), "create same-directory finalizer staging owner")
    let writer = begun.unwrap()
    writeInChunks(writer, bytes)
    bytes.free()
    return writer
}

fun incompatibleWriter(source: String) r: SqwWriter {
    let bytes = readFixture(source)
    let incompatiblePolicy = SqwReaderPolicy.exact(MODEL_LOCK, SOURCE_LOCK,
        CONVERSION_POLICY, CATALOG, WHOLE_SHA256, 865 as UInt32, 4)
    let begun = SqwWriter.begin(DESTINATION, bytes.length() as UInt64,
        65536, true, context(), incompatiblePolicy)
    require(begun.isOkay(), "create incompatible finalizer staging owner")
    let writer = begun.unwrap()
    writeInChunks(writer, bytes)
    bytes.free()
    return writer
}

fun stringBytes(value: String) r: Array<Int> {
    let bytes = Array<Int>()
    var index = 0
    while index < value.length() {
        bytes.push(value.byteAt(index)); index = index + 1
    }
    return bytes
}

fun convertedBytes(ordinal: Int) r: Array<Int> {
    let bytes = Array<Int>()
    bytes.push(ordinal & 255)
    bytes.push((ordinal >> 8) & 255)
    return bytes
}

fun fullEvidence(borrow catalog: QwenTensorCatalog)
    r: Array<QwenTensorEvidence> {
    let evidence = Array<QwenTensorEvidence>()
    var catalogIndex = 0
    var ordinal = 0
    while catalogIndex < catalog.length() {
        let included = catalog.shouldExtractAt(catalogIndex)
        require(included.isOkay(), "catalog classification remains available")
        if included.unwrap() {
            let name = catalog.nameAt(catalogIndex).unwrap()
            let source = stringBytes(name)
            let converted = convertedBytes(ordinal)
            let checksum = QwenTensorChecksum.begin(ordinal, name,
                source.length() as UInt64,
                converted.length() as UInt64).unwrap()
            checksum.updateSource(source).unwrap()
            checksum.updateConverted(converted).unwrap()
            evidence.push(checksum.finish().unwrap())
            checksum.close(); source.free(); converted.free()
            ordinal = ordinal + 1
        }
        catalogIndex = catalogIndex + 1
    }
    require(ordinal == 866, "build evidence for all 866 included tensors")
    return evidence
}

fun releaseEvidence(evidence: Array<QwenTensorEvidence>) r: Void {
    var index = 0
    while index < evidence.length() {
        evidence[index].close(); index = index + 1
    }
    evidence.free()
}

fun verifyDestination(journalText: String) r: Void {
    let opened = SqwReader.open(DESTINATION, policy())
    require(opened.isOkay(), "promoted artifact passes independent full readback")
    let reader = opened.unwrap()
    require(reader.length() == 866 and
        reader.nameAt(0).unwrap() == "lm_head.weight" and
        reader.nameAt(433).unwrap() == MIDDLE_NAME and
        reader.nameAt(865).unwrap() == LAST_NAME,
        "promoted artifact preserves first, middle, and last canonical tensors")
    require(reader.sourceSha256At(0).isOkay() and
        reader.convertedSha256At(433).isOkay() and
        reader.convertedBytesAt(865).unwrap() == (2 as UInt64),
        "promoted artifact exposes independently owned tensor evidence")
    require(reader.sourceSha256At(-1).unwrapErr().code == "sqw.bounds" and
        reader.convertedSha256At(866).unwrapErr().code == "sqw.bounds" and
        reader.convertedBytesAt(866).unwrapErr().code == "sqw.bounds",
        "independent evidence accessors enforce both index bounds")
    require(reader.evidenceText(journalText.length() - 1).unwrapErr().code ==
        "sqw.evidence_range", "evidence readback obeys its caller byte bound")
    let embedded = reader.evidenceText(1048576).unwrap()
    require(embedded == journalText,
        "promoted artifact embeds the exact completed journal")
    seen_string_release_owned(embedded)
    require(reader.close().isOkay(), "close promoted finalizer reader")
    require(reader.sourceSha256At(0).unwrapErr().code == "sqw.closed" and
        reader.convertedSha256At(0).unwrapErr().code == "sqw.closed" and
        reader.convertedBytesAt(0).unwrapErr().code == "sqw.closed" and
        reader.evidenceText(1048576).unwrapErr().code == "sqw.closed",
        "reader close invalidates every borrowed evidence access path")
}

fun main() r: Int {
    ensureOutputDirectory(); discardPath(DESTINATION)
    let config = parseQwen38Config(
        readText("tests/fixtures/qwen3_8_config.json")).unwrap()
    let catalog = parseQwenTensorCatalog(
        readText("tests/fixtures/qwen3_8_model.safetensors.index.json")).unwrap()
    let plan = buildQwen38ConversionPlan(config, catalog,
        4294967296 as UInt64, 67108864 as UInt64, 134217728 as UInt64,
        1048576 as UInt64, 1048576 as UInt64, 268435456 as UInt64,
        68719476736 as UInt64).unwrap()
    let identity = QwenConversionIdentity.exact(MODEL_LOCK, SOURCE_LOCK,
        CONVERSION_POLICY, plan.planFingerprint, COMPATIBILITY).unwrap()
    let evidence = fullEvidence(catalog)
    let rendered = renderQwenResumeJournal(identity, plan, catalog,
        evidence).unwrap()

    let sealedOwner = stagedWriter(SOURCE)
    require(sealedOwner.seal().unwrap() and
        not sealedOwner.seal().unwrap() and
        sealedOwner.sealedPath().isOkay(),
        "seal staging durably and idempotently without promotion")
    let rejectedWrite = Array<Int>()
    rejectedWrite.push(1)
    require(sealedOwner.write(rejectedWrite).unwrapErr().code ==
        "sqw.writer_state", "sealed staging rejects subsequent writes")
    rejectedWrite.free()
    require(sealedOwner.abort().unwrap(), "clean explicitly sealed staging owner")

    let writer = stagedWriter(SOURCE)
    let finalized = finalizeQwenConversion(writer, rendered, identity, plan,
        catalog)
    if finalized.isErr() {
        let error = finalized.unwrapErr()
        abort("positive finalization failed: " + error.code + "/" +
            error.field + " cause=" + error.cause)
    }
    require(finalized.unwrap(),
        "independently validate and atomically promote SQW")
    require(not finalizeQwenConversion(writer, rendered, identity, plan,
        catalog).unwrap(), "repeat completed promotion idempotently")
    verifyDestination(rendered)

    let empty = Array<QwenTensorEvidence>()
    let incompleteJournal = renderQwenResumeJournal(identity, plan, catalog,
        empty).unwrap()
    empty.free()
    let incomplete = stagedWriter(SOURCE)
    require(finalizeQwenConversion(incomplete, incompleteJournal, identity,
        plan, catalog).unwrapErr().code == "qwen.finalize.incomplete",
        "reject incomplete evidence before sealing or promotion")
    require(incomplete.abort().unwrap(), "clean incomplete staging owner")

    let reorderedText = readText(REORDERED_JOURNAL)
    let reordered = stagedWriter(SOURCE)
    let reorderedResult = finalizeQwenConversion(reordered, reorderedText,
        identity, plan, catalog)
    require(reorderedResult.isErr() and
        reorderedResult.unwrapErr().code == "qwen.finalize.journal" and
        reorderedResult.unwrapErr().cause == "qwen.convert.order",
        "reject a reordered complete journal before sealing or promotion")
    require(reordered.abort().unwrap(), "clean reordered-journal staging owner")

    let incompatible = incompatibleWriter(SOURCE)
    require(finalizeQwenConversion(incompatible, rendered, identity, plan,
        catalog).unwrapErr().code == "qwen.finalize.compatibility",
        "reject an incompatible reader policy before sealing or promotion")
    require(incompatible.abort().unwrap(), "clean incompatible staging owner")

    let mismatchedJournal = replaceFirst(rendered,
        evidence[0].sourceSha256, MODEL_LOCK)
    let mismatch = stagedWriter(SOURCE)
    require(finalizeQwenConversion(mismatch, mismatchedJournal, identity,
        plan, catalog).unwrapErr().code == "qwen.finalize.evidence",
        "reject valid but nonmatching embedded tensor evidence")
    require(mismatch.abort().unwrap(), "clean evidence-mismatch staging owner")
    verifyDestination(rendered)

    let corrupt = stagedWriter(CORRUPT_SOURCE)
    let corruptResult = finalizeQwenConversion(corrupt, rendered, identity,
        plan, catalog)
    require(corruptResult.isErr() and
        corruptResult.unwrapErr().code == "qwen.finalize.readback",
        "reject payload corruption during independent readback")
    require(corrupt.abort().unwrap(), "clean corrupt staging owner")
    verifyDestination(rendered)

    let truncated = stagedWriter(TRUNCATED_SOURCE)
    let truncatedResult = finalizeQwenConversion(truncated, rendered,
        identity, plan, catalog)
    require(truncatedResult.isErr() and
        truncatedResult.unwrapErr().code == "qwen.finalize.readback" and
        truncatedResult.unwrapErr().cause == "sqw.truncated",
        "reject truncation during independent readback")
    require(truncated.abort().unwrap(), "clean truncated staging owner")
    verifyDestination(rendered)

    discardPath(DESTINATION)
    releaseQwenJournalText(incompleteJournal)
    seen_string_release_owned(reorderedText)
    seen_string_release_owned(mismatchedJournal)
    releaseQwenJournalText(rendered)
    releaseEvidence(evidence)
    plan.close(); catalog.close()
    println("PASS: QWN-032D independent readback and atomic promotion")
    return 0
}

main()
