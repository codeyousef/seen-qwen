import crypto.sha256.{sha256File}
import io.file.{readTextChecked}
import json.parser.{destroyJsonParseResult}
import json.strict.{StrictJsonLimits, parseStrictJson}
import json.value.{JsonValue}
import math.math.{abs}
import seen_qwen.model.cpu_gdn.{cpuCausalDepthwiseConv,
    cpuGdnGatedRmsNorm, cpuGdnRecurrent, createCpuCausalConvState,
    createCpuGdnState}
import seen_qwen.model.cpu_reference.{CpuTensor, createCpuTensor}

extern "C" fun seen_string_release_owned(value: String) r: Void

fun require(condition: Bool, message: String) r: Void {
    if not condition { abort(message) }
}

fun gdnTestNear(actual: Float, expected: Float,
    tolerance: Float = 0.00002) r: Bool {
    return abs(actual - expected) <= tolerance
}

fun gdnTestShape2(first: UInt64, second: UInt64) r: Array<UInt64> {
    let shape = Array<UInt64>(); shape.push(first); shape.push(second); return shape
}

fun gdnTestShape3(first: UInt64, second: UInt64, third: UInt64)
    r: Array<UInt64> {
    let shape = Array<UInt64>()
    shape.push(first); shape.push(second); shape.push(third); return shape
}

fun gdnJsonNumbers(root: JsonValue, name: String, expectedLength: Int)
    r: Array<Float> {
    let field = root.get(name)
    require(not field.isNone() and field.unwrap().isArray() and
        field.unwrap().length() == expectedLength, "load exact GDN oracle array " + name)
    let values = Array<Float>()
    var index = 0
    while index < expectedLength {
        let value = field.unwrap().getAt(index)
        require(not value.isNone() and value.unwrap().isNumber(),
            "require numeric GDN oracle entry")
        values.push(value.unwrap().getNumber()); index = index + 1
    }
    return values
}

fun gdnMake2(values: Array<Float>, first: UInt64, second: UInt64,
    limit: UInt64 = 8192 as UInt64) r: CpuTensor {
    let shape = gdnTestShape2(first, second)
    let result = createCpuTensor(shape, values, limit); shape.free()
    require(result.isOkay(), "create bounded rank-two GDN tensor")
    return result.unwrap()
}

fun gdnMake3(values: Array<Float>, first: UInt64, second: UInt64,
    third: UInt64, limit: UInt64 = 8192 as UInt64) r: CpuTensor {
    let shape = gdnTestShape3(first, second, third)
    let result = createCpuTensor(shape, values, limit); shape.free()
    require(result.isOkay(), "create bounded rank-three GDN tensor")
    return result.unwrap()
}

fun gdnSliceRows(values: Array<Float>, start: Int, count: Int, width: Int)
    r: Array<Float> {
    let result = Array<Float>()
    var row = 0
    while row < count {
        var column = 0
        while column < width {
            result.push(values[(start + row) * width + column]); column = column + 1
        }
        row = row + 1
    }
    return result
}

fun gdnAppend(target: Array<Float>, source: Array<Float>) r: Void {
    var index = 0
    while index < source.length() {
        target.push(source[index]); index = index + 1
    }
}

fun gdnRequireValues(actual: Array<Float>, expected: Array<Float>,
    message: String, tolerance: Float = 0.00002) r: Void {
    require(actual.length() == expected.length(), message + " length")
    var index = 0
    while index < expected.length() {
        require(gdnTestNear(actual[index], expected[index], tolerance), message)
        index = index + 1
    }
}

fun main() r: Int {
    let oraclePath = "tests/fixtures/qwn_024c_cpu_gdn_oracle.json"
    let oracleHash = sha256File(oraclePath, 131072)
    require(oracleHash.isOkay() and oracleHash.unwrap() ==
        "a323c959cfa1c419b640ed52ef5025f043eddb57de6d4f157085e021f8c97fb1",
        "match content-addressed CPU GDN oracle")
    let hashText = oracleHash.unwrap(); seen_string_release_owned(hashText)
    let read = readTextChecked(oraclePath)
    require(read.success, "read CPU GDN oracle")
    let parsed = parseStrictJson(read.content, StrictJsonLimits{
        maxInputBytes: 131072, maxDepth: 8, maxValues: 6000, maxStringBytes: 256
    })
    require(parsed.isOkay(), "strictly parse CPU GDN oracle")
    let document = parsed.unwrap(); let root = document.value.unwrap()
    let mixedValues = gdnJsonNumbers(root, "mixed", 720)
    let convWeightValues = gdnJsonNumbers(root, "conv_weight", 320)
    let expectedConvolution = gdnJsonNumbers(root, "convolution", 720)
    let queryValues = gdnJsonNumbers(root, "query", 432)
    let keyValues = gdnJsonNumbers(root, "key", 432)
    let valueValues = gdnJsonNumbers(root, "value", 432)
    let betaValues = gdnJsonNumbers(root, "beta", 54)
    let decayValues = gdnJsonNumbers(root, "log_decay", 54)
    let gateValues = gdnJsonNumbers(root, "gate", 432)
    let normWeight = gdnJsonNumbers(root, "norm_weight", 8)
    let expectedGated = gdnJsonNumbers(root, "gated_norm", 432)
    let expectedFinalState = gdnJsonNumbers(root, "recurrent_final", 384)
    destroyJsonParseResult(document, true); seen_string_release_owned(read.content)

    let mixed = gdnMake2(mixedValues, 9 as UInt64, 80 as UInt64)
    let convWeight = gdnMake2(convWeightValues, 80 as UInt64, 4 as UInt64)
    let convState = createCpuCausalConvState(80 as UInt64, 4 as UInt64,
        320 as UInt64).unwrap()
    let fullConv = cpuCausalDepthwiseConv(mixed, convWeight, convState,
        0 as UInt64, 8192 as UInt64)
    require(fullConv.isOkay(), "run full causal depthwise convolution")
    gdnRequireValues(fullConv.unwrap().values, expectedConvolution,
        "match pinned PyTorch SiLU convolution", 0.00003)

    let chunkConvState = createCpuCausalConvState(80 as UInt64, 4 as UInt64,
        320 as UInt64).unwrap()
    let chunkedConvValues = Array<Float>()
    var convStart = 0
    let convChunkSizes = Array<Int>(); convChunkSizes.push(2); convChunkSizes.push(3)
    convChunkSizes.push(1); convChunkSizes.push(3)
    var convChunk = 0
    while convChunk < convChunkSizes.length() {
        let count = convChunkSizes[convChunk]
        let chunkValues = gdnSliceRows(mixedValues, convStart, count, 80)
        let chunkInput = gdnMake2(chunkValues, count as UInt64, 80 as UInt64)
        let result = cpuCausalDepthwiseConv(chunkInput, convWeight, chunkConvState,
            convStart as UInt64, 8192 as UInt64)
        require(result.isOkay(), "run bounded causal convolution chunk")
        gdnAppend(chunkedConvValues, result.unwrap().values)
        result.unwrap().close(); chunkInput.close(); chunkValues.free()
        convStart = convStart + count; convChunk = convChunk + 1
    }
    gdnRequireValues(chunkedConvValues, fullConv.unwrap().values,
        "preserve convolution across arbitrary chunk boundaries", 0.0)
    gdnRequireValues(chunkConvState.history, convState.history,
        "preserve exact final convolution history", 0.0)

    let query = gdnMake3(queryValues, 9 as UInt64, 6 as UInt64, 8 as UInt64)
    let key = gdnMake3(keyValues, 9 as UInt64, 6 as UInt64, 8 as UInt64)
    let value = gdnMake3(valueValues, 9 as UInt64, 6 as UInt64, 8 as UInt64)
    let beta = gdnMake2(betaValues, 9 as UInt64, 6 as UInt64)
    let decay = gdnMake2(decayValues, 9 as UInt64, 6 as UInt64)
    let gate = gdnMake3(gateValues, 9 as UInt64, 6 as UInt64, 8 as UInt64)
    let gdnState = createCpuGdnState(6 as UInt64, 8 as UInt64, 8 as UInt64,
        384 as UInt64).unwrap()
    let fullCore = cpuGdnRecurrent(query, key, value, beta, decay, gdnState,
        0 as UInt64, 8192 as UInt64)
    require(fullCore.isOkay(), "run full GDN recurrent sequence")
    gdnRequireValues(gdnState.values, expectedFinalState,
        "match pinned PyTorch FP32 final recurrent state", 0.00003)
    let fullGated = cpuGdnGatedRmsNorm(fullCore.unwrap(), gate, normWeight,
        0.000001, 8192 as UInt64)
    require(fullGated.isOkay(), "apply GDN gated RMS normalization")
    gdnRequireValues(fullGated.unwrap().values, expectedGated,
        "match pinned PyTorch gated RMS normalization", 0.00004)

    let chunkState = createCpuGdnState(6 as UInt64, 8 as UInt64, 8 as UInt64,
        384 as UInt64).unwrap()
    let chunkedCoreValues = Array<Float>()
    let recurrentChunkSizes = Array<Int>()
    var decodeChunk = 0
    while decodeChunk < 9 {
        recurrentChunkSizes.push(1); decodeChunk = decodeChunk + 1
    }
    var recurrentStart = 0; var recurrentChunk = 0
    while recurrentChunk < recurrentChunkSizes.length() {
        let count = recurrentChunkSizes[recurrentChunk]
        let chunkQueryValues = gdnSliceRows(queryValues, recurrentStart, count, 48)
        let chunkKeyValues = gdnSliceRows(keyValues, recurrentStart, count, 48)
        let chunkValueValues = gdnSliceRows(valueValues, recurrentStart, count, 48)
        let chunkBetaValues = gdnSliceRows(betaValues, recurrentStart, count, 6)
        let chunkDecayValues = gdnSliceRows(decayValues, recurrentStart, count, 6)
        let chunkQuery = gdnMake3(chunkQueryValues, count as UInt64, 6 as UInt64,
            8 as UInt64)
        let chunkKey = gdnMake3(chunkKeyValues, count as UInt64, 6 as UInt64,
            8 as UInt64)
        let chunkValue = gdnMake3(chunkValueValues, count as UInt64, 6 as UInt64,
            8 as UInt64)
        let chunkBeta = gdnMake2(chunkBetaValues, count as UInt64, 6 as UInt64)
        let chunkDecay = gdnMake2(chunkDecayValues, count as UInt64, 6 as UInt64)
        let result = cpuGdnRecurrent(chunkQuery, chunkKey, chunkValue, chunkBeta,
            chunkDecay, chunkState, recurrentStart as UInt64, 8192 as UInt64)
        require(result.isOkay(), "run bounded recurrent GDN chunk")
        gdnAppend(chunkedCoreValues, result.unwrap().values)
        result.unwrap().close(); chunkQuery.close(); chunkKey.close(); chunkValue.close()
        chunkBeta.close(); chunkDecay.close()
        chunkQueryValues.free(); chunkKeyValues.free(); chunkValueValues.free()
        chunkBetaValues.free(); chunkDecayValues.free()
        recurrentStart = recurrentStart + count; recurrentChunk = recurrentChunk + 1
    }
    gdnRequireValues(chunkedCoreValues, fullCore.unwrap().values,
        "make token decode identical to full recurrent execution", 0.0)
    gdnRequireValues(chunkState.values, gdnState.values,
        "make chunked and full final GDN state identical", 0.0)

    let badConvPosition = cpuCausalDepthwiseConv(mixed, convWeight, chunkConvState,
        0 as UInt64, 8192 as UInt64)
    require(badConvPosition.isErr() and badConvPosition.unwrapErr().code ==
        "qwen.cpu.position", "reject non-sequential convolution chunk")
    let badGdnPosition = cpuGdnRecurrent(query, key, value, beta, decay, chunkState,
        0 as UInt64, 8192 as UInt64)
    require(badGdnPosition.isErr() and badGdnPosition.unwrapErr().code ==
        "qwen.cpu.position", "reject non-sequential recurrent chunk")
    let transactionConvState = createCpuCausalConvState(80 as UInt64,
        4 as UInt64, 320 as UInt64).unwrap()
    let originalMixed = mixed.values[0]; let originalConvWeight = convWeight.values[3]
    mixed.values[0] = 3.0e38; convWeight.values[3] = 3.0e38
    let overflowingConv = cpuCausalDepthwiseConv(mixed, convWeight,
        transactionConvState, 0 as UInt64, 8192 as UInt64)
    require(overflowingConv.isErr() and transactionConvState.processed ==
        (0 as UInt64) and transactionConvState.history[0] == 0.0,
        "leave convolution state unchanged after numerical failure")
    mixed.values[0] = originalMixed; convWeight.values[3] = originalConvWeight
    let transactionGdnState = createCpuGdnState(6 as UInt64, 8 as UInt64,
        8 as UInt64, 384 as UInt64).unwrap()
    let originalQuery = query.values[0]; let originalValue = value.values[0]
    query.values[0] = 3.0e38; value.values[0] = 3.0e38
    let overflowingGdn = cpuGdnRecurrent(query, key, value, beta, decay,
        transactionGdnState, 0 as UInt64, 8192 as UInt64)
    require(overflowingGdn.isErr() and transactionGdnState.processed ==
        (0 as UInt64) and transactionGdnState.values[0] == 0.0,
        "leave recurrent state unchanged after numerical failure")
    query.values[0] = originalQuery; value.values[0] = originalValue
    let originalDecay = decay.values[0]; decay.values[0] = 1.0
    require(cpuGdnRecurrent(query, key, value, beta, decay,
        transactionGdnState, 0 as UInt64, 8192 as UInt64).isErr() and
        transactionGdnState.processed == (0 as UInt64),
        "reject growth decay before mutating recurrent state")
    decay.values[0] = originalDecay
    let originalHistory = chunkConvState.history[chunkConvState.history.length() - 1]
    mixed.values[mixed.values.length() - 1] = 99.0
    require(chunkConvState.history[chunkConvState.history.length() - 1] == originalHistory,
        "convolution state owns copied history")
    chunkState.values.pop()
    let forged = cpuGdnRecurrent(query, key, value, beta, decay, chunkState,
        9 as UInt64, 8192 as UInt64)
    require(forged.isErr() and forged.unwrapErr().code == "qwen.cpu.invalid-state" and
        forged.unwrapErr().exitCode == 11, "reject forged GDN state before storage access")
    chunkState.values.push(0.0)

    require(convState.reset().isOkay() and convState.processed == (0 as UInt64),
        "reset convolution state deterministically")
    require(gdnState.reset().isOkay() and gdnState.processed == (0 as UInt64),
        "reset recurrent state deterministically")
    convState.close(); convState.close(); gdnState.close(); gdnState.close()
    require(cpuCausalDepthwiseConv(mixed, convWeight, convState, 0 as UInt64,
        8192 as UInt64).isErr(), "reject convolution use after close")
    require(cpuGdnRecurrent(query, key, value, beta, decay, gdnState,
        0 as UInt64, 8192 as UInt64).isErr(), "reject recurrent use after close")

    fullConv.unwrap().close(); fullCore.unwrap().close(); fullGated.unwrap().close()
    chunkConvState.close(); chunkState.close()
    transactionConvState.close(); transactionGdnState.close()
    mixed.close(); convWeight.close(); query.close(); key.close(); value.close()
    beta.close(); decay.close(); gate.close()
    mixedValues.free(); convWeightValues.free(); expectedConvolution.free()
    queryValues.free(); keyValues.free(); valueValues.free(); betaValues.free()
    decayValues.free(); gateValues.free(); normWeight.free(); expectedGated.free()
    expectedFinalState.free(); chunkedConvValues.free(); convChunkSizes.free()
    chunkedCoreValues.free(); recurrentChunkSizes.free()
    println("PASS: QWN-024C CPU causal convolution, recurrent GDN, and chunk state")
    return 0
}

main()
