import accelerator.cuda.mod.{CudaAllocation}
import seen_qwen.backend.cuda.reference_primitives.{QwenCudaKvCache,
    QwenCudaBufferView, QWEN_CUDA_REFERENCE_ABI_VERSION}

fun main() r: Int {
    let cache = QwenCudaKvCache{
        keyAllocation: CudaAllocation{ handle: 1 as UInt64,
            data: 1 as *Void, byteLength: 28672 as UInt64,
            device: 0 as Int32 },
        valueAllocation: CudaAllocation{ handle: 2 as UInt64,
            data: 2 as *Void, byteLength: 28672 as UInt64,
            device: 0 as Int32 },
        capacity: 7 as UInt64, used: 5 as UInt64,
        kvHeads: 4 as UInt64, headDim: 256 as UInt64,
        byteLength: 28672 as UInt64, deviceOrdinal: 0 as Int32,
        closed: false
    }
    let output = QwenCudaBufferView{
        abiVersion: QWEN_CUDA_REFERENCE_ABI_VERSION,
        deviceOrdinal: 0 as Int32, address: 3 as UInt64,
        byteLength: 24576 as UInt64
    }
    if cache.length() != (5 as UInt64) { return 1 }
    if output.byteLength != (24 as UInt64) * (256 as UInt64) *
        (4 as UInt64) { return 2 }
    println("PASS: QWN-042C fixed-width grouped-query decode declaration")
    return 0
}

main()
