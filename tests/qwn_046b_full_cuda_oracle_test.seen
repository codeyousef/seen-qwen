import crypto.sha256.{sha256File}
import env.env.{args}
import io.file.{readTextChecked}
import json.parser.{destroyJsonParseResult}
import json.strict.{StrictJsonLimits, parseStrictJson}
import memory.allocation.{memoryStats}
import seen_qwen.formats.sqw_reader.{SqwReader, SqwReaderPolicy}
import seen_qwen.runtime.full_model_memory.{QWEN_FULL_MAX_CONTEXT}
import seen_qwen.runtime.full_model_cuda.{createQwenFullCudaResidency}

extern "C" fun seen_string_release_owned(value: String) r: Void

fun require(condition: Bool, message: String) r: Void {
    if not condition { abort(message) }
}

fun printIntegerMetric(label: String, value: Int) r: Void {
    let valueText = (value as Int64).toString()
    let line = label + valueText
    println(line)
    seen_string_release_owned(line)
    seen_string_release_owned(valueText)
}

fun printFloatMetric(label: String, value: Float) r: Void {
    let valueText = value.toString()
    let line = label + valueText
    println(line)
    seen_string_release_owned(line)
    seen_string_release_owned(valueText)
}

fun main() r: Int {
    let arguments = args()
    require(arguments.length() == 3,
        "require the exact SQW artifact and frozen oracle paths")
    let allocatorBaseline = memoryStats()
    let oracleHash = sha256File(arguments[2], 262144)
    require(oracleHash.isOkay() and oracleHash.unwrap() ==
        "42ba8e0b9d5adec7c5ce1708bfc60d7b9911c126af9e6703b35efd108fedc921",
        "match the content-addressed full-model oracle manifest")
    let oracleHashText = oracleHash.unwrap()
    oracleHash.releaseContainer()
    seen_string_release_owned(oracleHashText)
    let read = readTextChecked(arguments[2])
    require(read.success and read.content.length() <= 262144,
        "read the bounded full-model oracle manifest")
    let parsed = parseStrictJson(read.content, StrictJsonLimits{
        maxInputBytes: 262144, maxDepth: 12, maxValues: 16384,
        maxStringBytes: 512
    })
    require(parsed.isOkay(), "strictly parse the full-model oracle manifest")
    let document = parsed.unwrap()
    let root = document.value.unwrap()
    let prompts = root.get("prompts").unwrap()
    require(prompts.length() == 8,
        "retain every frozen full-model prompt record")

    let policy = SqwReaderPolicy.qwen38(
        "399b6f25f8cd20ae5d233040005f0ebb82b7e5b396e0eb91214dbe94b828c3be",
        "f43b83cd9174a91a2ccb2669dc1751c83b9c6730593abe6004bc185855cc78bb",
        "64d442eb87722f5fbc0a38a780d07e011dc51554956f1c6f2cb1e04611a2d6c5",
        "0d9bd0167c58831a2016374c44e835db5c8f4d22a0f565ac55715ab57c6840f0",
        4)
    let opened = SqwReader.open(arguments[1], policy)
    require(opened.isOkay(), "open the exact validated complete-model SQW")
    let reader = opened.unwrap()
    opened.releaseContainer()
    policy.free()
    let made = createQwenFullCudaResidency(0 as Int32,
        QWEN_FULL_MAX_CONTEXT)
    require(made.isOkay(), "create the 188-position complete-model residency")
    let residency = made.unwrap()
    made.releaseContainer()
    let loaded = residency.loadValidatedQ4Weights(reader)
    require(loaded.isOkay() and
        residency.executionTensors.length() == 1027,
        "bind the fixed 64-layer execution tensor map")
    loaded.releaseContainer()

    var comparedPrompts = 0
    var promptIndex = 0
    while promptIndex < prompts.length() {
        let prompt = prompts.getAt(promptIndex).unwrap()
        let role = prompt.get("greedy_sequence_role").unwrap().getString()
        if role == "128-step" {
            let reset = residency.resetExecution()
            require(reset.isOkay(), "reset all recurrent and cache state")
            reset.releaseContainer()
            let inputValues = prompt.get("input_token_ids").unwrap()
            let expectedTokens = prompt.get("greedy_token_ids").unwrap()
            let expectedLogits = prompt.get(
                "greedy_selected_logits_f32").unwrap()
            require(inputValues.length() > 0 and inputValues.length() <= 60 and
                expectedTokens.length() == 128 and
                expectedLogits.length() == 128,
                "bound each frozen 128-step oracle")
            let inputTokens = Array<Int32>()
            var inputIndex = 0
            while inputIndex < inputValues.length() {
                inputTokens.push(inputValues.getAt(inputIndex).unwrap().
                    getNumber() as Int32)
                inputIndex = inputIndex + 1
            }
            let prefill = residency.executeTokens(inputTokens, false)
            require(prefill.isOkay(), "execute the frozen prompt prefill")
            let first = prefill.unwrap()
            prefill.releaseContainer()
            var actualToken = first.tokenId
            var actualLogit = first.selectedLogit as Float
            first.free()
            var firstTokenDivergence = -1
            var firstLogitDivergence = -1
            var maximumSelectedLogitError: Float = 0.0
            var step = 0
            while step < 128 {
                let expectedToken = expectedTokens.getAt(step).unwrap().
                    getNumber() as Int32
                let expectedLogit = expectedLogits.getAt(step).unwrap().
                    getNumber()
                require(actualLogit == actualLogit and
                    abs(actualLogit) < 3.4028235e38,
                    "reject NaN or infinity in a selected CUDA logit")
                if actualToken != expectedToken and
                    firstTokenDivergence < 0 {
                    firstTokenDivergence = step
                }
                let selectedError = abs(actualLogit - expectedLogit)
                if selectedError > 0.0 and firstLogitDivergence < 0 {
                    firstLogitDivergence = step
                }
                if selectedError > maximumSelectedLogitError {
                    maximumSelectedLogitError = selectedError
                }
                if step < 127 {
                    let decodeInput = Array<Int32>()
                    decodeInput.push(actualToken)
                    let decoded = residency.executeTokens(decodeInput, true)
                    require(decoded.isOkay(),
                        "execute every bounded one-token decode transition")
                    let next = decoded.unwrap()
                    decoded.releaseContainer()
                    actualToken = next.tokenId
                    actualLogit = next.selectedLogit as Float
                    next.free()
                    decodeInput.free()
                }
                step = step + 1
            }
            require(residency.position ==
                (inputValues.length() + 127) as UInt64,
                "commit the exact prompt plus 127 decode inputs")
            if inputValues.length() == 60 {
                let boundaryInput = Array<Int32>()
                boundaryInput.push(actualToken)
                let boundary = residency.executeTokens(boundaryInput, true)
                require(boundary.isOkay() and
                    residency.position == QWEN_FULL_MAX_CONTEXT,
                    "admit the exact 188-position execution boundary")
                let boundaryStep = boundary.unwrap()
                boundary.releaseContainer()
                boundaryStep.free()
                let rejected = residency.executeTokens(boundaryInput, true)
                require(rejected.isErr() and
                    residency.position == QWEN_FULL_MAX_CONTEXT,
                    "reject execution above 188 without mutating state")
                let rejectedError = rejected.unwrapErr()
                rejected.releaseContainer()
                rejectedError.free()
                boundaryInput.free()
            }
            printIntegerMetric(
                "QWN-046B first token divergence step: ",
                firstTokenDivergence)
            printIntegerMetric(
                "QWN-046B first selected-logit divergence step: ",
                firstLogitDivergence)
            printFloatMetric(
                "QWN-046B maximum selected-logit absolute error: ",
                maximumSelectedLogitError)
            inputTokens.free()
            comparedPrompts = comparedPrompts + 1
        }
        promptIndex = promptIndex + 1
    }
    require(comparedPrompts == 2,
        "execute both frozen thinking-on and thinking-off sequences")

    let readerClosed = reader.close()
    require(readerClosed.isOkay(), "close the complete SQW reader")
    readerClosed.releaseContainer()
    reader.free()
    let residencyClosed = residency.close()
    require(residencyClosed.isOkay(), "close the complete-model executor")
    residencyClosed.releaseContainer()
    let closedAgain = residency.close()
    require(closedAgain.isOkay() and closedAgain.unwrap() == false,
        "close the executor deterministically and idempotently")
    closedAgain.releaseContainer()
    residency.free()
    destroyJsonParseResult(document, true)
    seen_string_release_owned(read.content)
    let allocatorAfter = memoryStats()
    require(allocatorAfter.usedBytes == allocatorBaseline.usedBytes and
        allocatorAfter.allocationFailures ==
            allocatorBaseline.allocationFailures,
        "return Seen allocator usage to the warmed pre-reader baseline")
    arguments.free()
    println("PASS: QWN-046B two-prompt 128-step CUDA oracle capture")
    return 0
}

main()
