import seen_qwen.backend.cuda.reference_primitives.{QWEN_CUDA_REFERENCE_ABI_VERSION,
    QwenCudaBufferView}

fun main() r: Int {
    let output = QwenCudaBufferView{
        abiVersion: QWEN_CUDA_REFERENCE_ABI_VERSION,
        deviceOrdinal: 0 as Int32,
        address: 0 as UInt64,
        byteLength: 49152 as UInt64
    }
    if output.abiVersion != QWEN_CUDA_REFERENCE_ABI_VERSION { return 1 }
    if output.byteLength != (2 as UInt64) * (48 as UInt64) *
        (128 as UInt64) * (4 as UInt64) { return 2 }
    println("PASS: QWN-041D fixed-width gated GDN output declaration")
    return 0
}

main()
