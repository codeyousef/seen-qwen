import crypto.sha256.{sha256File}
import io.file.{readTextChecked}
import json.parser.{destroyJsonParseResult}
import json.strict.{StrictJsonLimits, parseStrictJson}
import json.value.{JsonValue}
import math.math.{abs}
import seen_qwen.model.cpu_attention.{appendCpuKvCache,
    cpuApplyAttentionGate, cpuApplyPartialRotary, cpuGroupedQueryAttention,
    createCpuKvCache}
import seen_qwen.model.cpu_reference.{CpuTensor, createCpuTensor}

extern "C" fun seen_string_release_owned(value: String) r: Void

fun require(condition: Bool, message: String) r: Void {
    if not condition { abort(message) }
}

fun near(actual: Float, expected: Float, tolerance: Float = 0.00001) r: Bool {
    return abs(actual - expected) <= tolerance
}

fun attentionTestShape3(first: UInt64, second: UInt64, third: UInt64)
    r: Array<UInt64> {
    let shape = Array<UInt64>()
    shape.push(first); shape.push(second); shape.push(third)
    return shape
}

fun jsonNumbers(root: JsonValue, name: String, expectedLength: Int)
    r: Array<Float> {
    let field = root.get(name)
    require(not field.isNone() and field.unwrap().isArray() and
        field.unwrap().length() == expectedLength, "load exact oracle array " + name)
    let values = Array<Float>()
    var index = 0
    while index < expectedLength {
        let value = field.unwrap().getAt(index)
        require(not value.isNone() and value.unwrap().isNumber(),
            "require numeric oracle entry")
        values.push(value.unwrap().getNumber())
        index = index + 1
    }
    return values
}

fun makeTensor(values: Array<Float>, first: UInt64, second: UInt64,
    third: UInt64, limit: UInt64 = 4096 as UInt64) r: CpuTensor {
    let shape = attentionTestShape3(first, second, third)
    let result = createCpuTensor(shape, values, limit)
    shape.free()
    require(result.isOkay(), "create bounded attention tensor")
    return result.unwrap()
}

fun sliceToken(values: Array<Float>, token: Int, width: Int) r: Array<Float> {
    let sliced = Array<Float>()
    var index = 0
    while index < width {
        sliced.push(values[token * width + index]); index = index + 1
    }
    return sliced
}

fun requireValues(actual: Array<Float>, expected: Array<Float>, message: String)
    r: Void {
    require(actual.length() == expected.length(), message + " length")
    var index = 0
    while index < expected.length() {
        require(near(actual[index], expected[index]), message)
        index = index + 1
    }
}

fun main() r: Int {
    let oraclePath = "tests/fixtures/qwn_024b_cpu_attention_oracle.json"
    let oracleHash = sha256File(oraclePath, 65536)
    require(oracleHash.isOkay() and oracleHash.unwrap() ==
        "f7d1daf7e1d1bd5cf919ef7f1d8b866350d3632b999dfe731ad23cbdc28f9797",
        "match content-addressed CPU attention oracle")
    let oracleHashText = oracleHash.unwrap()
    seen_string_release_owned(oracleHashText)
    let read = readTextChecked(oraclePath)
    require(read.success, "read CPU attention oracle")
    let parsed = parseStrictJson(read.content, StrictJsonLimits{
        maxInputBytes: 32768, maxDepth: 8, maxValues: 2048, maxStringBytes: 256
    })
    require(parsed.isOkay(), "strictly parse CPU attention oracle")
    let document = parsed.unwrap()
    let root = document.value.unwrap()
    let queryValues = jsonNumbers(root, "query", 144)
    let keyValues = jsonNumbers(root, "key", 72)
    let valueValues = jsonNumbers(root, "value", 72)
    let gateValues = jsonNumbers(root, "gate", 144)
    let expectedProbabilities = jsonNumbers(root, "probabilities", 18)
    let expectedAttended = jsonNumbers(root, "attended", 144)
    destroyJsonParseResult(document, true)
    seen_string_release_owned(read.content)

    let query = makeTensor(queryValues, 3 as UInt64, 2 as UInt64, 24 as UInt64)
    let key = makeTensor(keyValues, 3 as UInt64, 1 as UInt64, 24 as UInt64)
    let value = makeTensor(valueValues, 3 as UInt64, 1 as UInt64, 24 as UInt64)
    let gate = makeTensor(gateValues, 3 as UInt64, 2 as UInt64, 24 as UInt64)
    let cache = createCpuKvCache(3 as UInt64, 1 as UInt64, 24 as UInt64,
        128 as UInt64).unwrap()
    require(appendCpuKvCache(cache, key, value, 0 as UInt64,
        256 as UInt64).isOkay(), "append full bounded prefill KV block")
    let originalKey = key.values[0]; let originalValue = value.values[0]
    key.values[0] = 99.0; value.values[0] = 99.0
    require(not near(cache.keys[0], 99.0) and not near(cache.values[0], 99.0),
        "cache owns copied key/value storage")
    key.values[0] = originalKey; value.values[0] = originalValue
    let prefillResult = cpuGroupedQueryAttention(query, cache, 0 as UInt64,
        4096 as UInt64)
    require(prefillResult.isOkay(), "run causal grouped-query prefill")
    let prefill = prefillResult.unwrap()
    requireValues(prefill.attended.values, expectedAttended,
        "match pinned PyTorch FP32 attended oracle")
    requireValues(prefill.probabilities.values, expectedProbabilities,
        "match pinned PyTorch FP32 softmax and causal-mask oracle")
    require(prefill.probabilities.values[2] == 0.0 and
        prefill.probabilities.values[11] == 0.0,
        "write exact zero probability above the causal diagonal")

    let zeroGateValues = Array<Float>()
    var zeroIndex = 0
    while zeroIndex < 144 { zeroGateValues.push(0.0); zeroIndex = zeroIndex + 1 }
    let zeroGate = makeTensor(zeroGateValues, 3 as UInt64, 2 as UInt64, 24 as UInt64)
    let gated = cpuApplyAttentionGate(prefill.attended, zeroGate,
        4096 as UInt64).unwrap()
    require(near(gated.values[0], prefill.attended.values[0] * 0.5) and
        near(gated.values[143], prefill.attended.values[143] * 0.5),
        "apply the Qwen sigmoid output gate")
    let oracleGated = cpuApplyAttentionGate(prefill.attended, gate,
        4096 as UInt64)
    require(oracleGated.isOkay(), "apply pinned full-attention gate geometry")

    require(cache.reset().isOkay() and cache.length() == (0 as UInt64) and
        cache.keys.length() == 0 and cache.values.length() == 0,
        "reset cache deterministically")
    let decodedValues = Array<Float>()
    var token = 0
    while token < 3 {
        let oneQueryValues = sliceToken(queryValues, token, 48)
        let oneKeyValues = sliceToken(keyValues, token, 24)
        let oneValueValues = sliceToken(valueValues, token, 24)
        let oneQuery = makeTensor(oneQueryValues, 1 as UInt64, 2 as UInt64,
            24 as UInt64)
        let oneKey = makeTensor(oneKeyValues, 1 as UInt64, 1 as UInt64,
            24 as UInt64)
        let oneValue = makeTensor(oneValueValues, 1 as UInt64, 1 as UInt64,
            24 as UInt64)
        require(appendCpuKvCache(cache, oneKey, oneValue, token as UInt64,
            128 as UInt64).isOkay(), "append one decode KV position")
        let decoded = cpuGroupedQueryAttention(oneQuery, cache, token as UInt64,
            4096 as UInt64).unwrap()
        var outputIndex = 0
        while outputIndex < decoded.attended.values.length() {
            decodedValues.push(decoded.attended.values[outputIndex])
            outputIndex = outputIndex + 1
        }
        decoded.close(); oneQuery.close(); oneKey.close(); oneValue.close()
        oneQueryValues.free(); oneKeyValues.free(); oneValueValues.free()
        token = token + 1
    }
    requireValues(decodedValues, expectedAttended,
        "make token decode identical to causal prefill across cache boundaries")

    let ropeQueryValues = Array<Float>()
    ropeQueryValues.push(1.0); ropeQueryValues.push(2.0)
    ropeQueryValues.push(3.0); ropeQueryValues.push(4.0)
    ropeQueryValues.push(-1.0); ropeQueryValues.push(0.5)
    ropeQueryValues.push(7.0); ropeQueryValues.push(8.0)
    let ropeKeyValues = Array<Float>()
    ropeKeyValues.push(0.25); ropeKeyValues.push(-0.75)
    ropeKeyValues.push(5.0); ropeKeyValues.push(6.0)
    let ropeQuery = makeTensor(ropeQueryValues, 1 as UInt64, 2 as UInt64,
        4 as UInt64, 16 as UInt64)
    let ropeKey = makeTensor(ropeKeyValues, 1 as UInt64, 1 as UInt64,
        4 as UInt64, 16 as UInt64)
    let rotary = cpuApplyPartialRotary(ropeQuery, ropeKey, 1 as UInt64,
        2 as UInt64, 10000000.0, 128 as UInt64, 16 as UInt64)
    require(rotary.isOkay(), "apply bounded partial text RoPE")
    let rotated = rotary.unwrap()
    require(near(rotated.query.values[0], -1.14263964) and
        near(rotated.query.values[1], 1.92207563) and
        rotated.query.values[2] == 3.0 and rotated.query.values[3] == 4.0,
        "match rotate-half text RoPE and preserve pass-through dimensions")
    require(near(rotated.key.values[0], 0.76617813) and
        near(rotated.key.values[1], -0.19485976),
        "apply identical text positions to KV heads")

    let nonSequential = appendCpuKvCache(cache, key, value, 0 as UInt64,
        256 as UInt64)
    require(nonSequential.isErr() and nonSequential.unwrapErr().code ==
        "qwen.cpu.position", "reject non-sequential cache append")
    let fullAppend = appendCpuKvCache(cache, key, value, 3 as UInt64,
        256 as UInt64)
    require(fullAppend.isErr() and fullAppend.unwrapErr().code ==
        "qwen.cpu.capacity", "reject cache capacity overflow")
    require(cpuGroupedQueryAttention(query, cache, 1 as UInt64,
        4096 as UInt64).isErr(), "reject a query block not ending at cache length")
    require(cpuApplyPartialRotary(ropeQuery, ropeKey, 128 as UInt64,
        2 as UInt64, 10000000.0, 128 as UInt64, 16 as UInt64).isErr(),
        "reject RoPE position overflow")
    let incompatibleCache = createCpuKvCache(1 as UInt64, 2 as UInt64,
        2 as UInt64, 8 as UInt64).unwrap()
    let incompatibleKeyValues = Array<Float>()
    incompatibleKeyValues.push(1.0); incompatibleKeyValues.push(0.0)
    incompatibleKeyValues.push(0.0); incompatibleKeyValues.push(1.0)
    let incompatibleValueValues = Array<Float>()
    incompatibleValueValues.push(1.0); incompatibleValueValues.push(2.0)
    incompatibleValueValues.push(3.0); incompatibleValueValues.push(4.0)
    let incompatibleQueryValues = Array<Float>()
    var incompatibleIndex = 0
    while incompatibleIndex < 6 {
        incompatibleQueryValues.push(1.0); incompatibleIndex = incompatibleIndex + 1
    }
    let incompatibleKey = makeTensor(incompatibleKeyValues, 1 as UInt64,
        2 as UInt64, 2 as UInt64, 8 as UInt64)
    let incompatibleValue = makeTensor(incompatibleValueValues, 1 as UInt64,
        2 as UInt64, 2 as UInt64, 8 as UInt64)
    let incompatibleQuery = makeTensor(incompatibleQueryValues, 1 as UInt64,
        3 as UInt64, 2 as UInt64, 8 as UInt64)
    require(appendCpuKvCache(incompatibleCache, incompatibleKey,
        incompatibleValue, 0 as UInt64, 8 as UInt64).isOkay() and
        cpuGroupedQueryAttention(incompatibleQuery, incompatibleCache,
            0 as UInt64, 8 as UInt64).isErr(),
        "reject query heads not divisible by KV heads")
    cache.used = 4 as UInt64
    let forged = cpuGroupedQueryAttention(query, cache, 1 as UInt64,
        4096 as UInt64)
    require(forged.isErr() and forged.unwrapErr().code ==
        "qwen.cpu.invalid-state" and forged.unwrapErr().exitCode == 11,
        "reject forged cache geometry before reading storage")
    cache.used = 3 as UInt64

    prefill.close(); gated.close(); oracleGated.unwrap().close()
    rotated.close(); rotated.close(); cache.close(); cache.close()
    let closed = appendCpuKvCache(cache, key, value, 0 as UInt64,
        256 as UInt64)
    require(closed.isErr() and closed.unwrapErr().code == "qwen.cpu.closed",
        "reject use after deterministic cache cleanup")
    query.close(); key.close(); value.close(); gate.close(); zeroGate.close()
    ropeQuery.close(); ropeKey.close()
    incompatibleCache.close(); incompatibleKey.close(); incompatibleValue.close()
    incompatibleQuery.close()
    queryValues.free(); keyValues.free(); valueValues.free(); gateValues.free()
    expectedProbabilities.free(); expectedAttended.free(); zeroGateValues.free()
    decodedValues.free(); ropeQueryValues.free(); ropeKeyValues.free()
    incompatibleKeyValues.free(); incompatibleValueValues.free()
    incompatibleQueryValues.free()
    println("PASS: QWN-024B CPU text RoPE, GQA, causal mask, and KV cache")
    return 0
}

main()
