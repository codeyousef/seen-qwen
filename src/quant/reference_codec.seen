///
/// Deterministic finite BF16, IEEE binary16, and Q8_SYM_G64 reference codecs.
///
/// Inputs are rounded to IEEE binary32 before conversion. Both encoders use
/// round-to-nearest, ties-to-even. Signed zero and finite subnormals are
/// preserved; NaN, infinity, and conversion overflow fail closed. Encoded
/// buffers own their UInt16 payload and close deterministically/idempotently.
/// Q8 buffers additionally own one signed byte per logical value and one FP16
/// scale per row-major group of at most 64 values.
///
/// Contract test: FEL-1419 / QWN-031A
///

import core.result.{Result}
import inference.scalars.{BFloat16, Float16}
import math.math.{abs, copysign, isfinite}

pub class ReferenceCodecError {
    var code: String
    var operation: String
    var message: String
    var exitCode: Int
    var retryable: Bool
}

/// Pointer-safe scalar result payload. Seen 0.18.1 cannot lower a generic
/// Result<Float, E> payload correctly (SeenLang FEL-1550).
pub class ReferenceFloatValue {
    var value: Float
}

/// Pointer-safe fixed-width bit result payload. Seen 0.18.1 also mis-lowers
/// Result<UInt32, E> construction under the generic scalar ABI (FEL-1550).
class ReferenceBits32 {
    var bits: UInt32
}

pub class Reference16Buffer {
    var codec: String
    var words: Array<UInt16>
    var closed: Bool

    fun length() r: Int {
        if this.closed { return 0 }
        return this.words.length()
    }

    fun close() r: Void {
        if this.closed { return }
        this.words.free()
        this.closed = true
    }
}

pub class ReferenceQ8Buffer {
    var codec: String
    var rowElements: UInt64
    var logicalElements: UInt64
    var codes: Array<UInt8>
    var scales: Array<UInt16>
    var closed: Bool

    fun length() r: UInt64 {
        if this.closed { return 0 as UInt64 }
        return this.logicalElements
    }

    fun groupCount() r: UInt64 {
        if this.closed { return 0 as UInt64 }
        return this.scales.length() as UInt64
    }

    fun close() r: Void {
        if this.closed { return }
        this.codes.free()
        this.scales.free()
        this.rowElements = 0 as UInt64
        this.logicalElements = 0 as UInt64
        this.closed = true
    }
}

pub class ReferenceQ4Buffer {
    var codec: String
    var rowElements: UInt64
    var logicalElements: UInt64
    var bytes: Array<UInt8>
    var scales: Array<UInt16>
    var closed: Bool

    fun length() r: UInt64 {
        if this.closed { return 0 as UInt64 }
        return this.logicalElements
    }

    fun groupCount() r: UInt64 {
        if this.closed { return 0 as UInt64 }
        return this.scales.length() as UInt64
    }

    fun close() r: Void {
        if this.closed { return }
        this.bytes.free()
        this.scales.free()
        this.rowElements = 0 as UInt64
        this.logicalElements = 0 as UInt64
        this.closed = true
    }
}

fun codecError(code: String, operation: String, message: String,
    exitCode: Int) r: ReferenceCodecError {
    return ReferenceCodecError{ code: code, operation: operation,
        message: message, exitCode: exitCode, retryable: false }
}

fun float32Bits(value: Float32) r: UInt32 {
    let widened = value as Float
    var sign: UInt32 = 0 as UInt32
    if copysign(1.0, widened) < 0.0 {
        sign = 0x80000000 as UInt32
    }
    let magnitude = abs(widened)
    if magnitude == 0.0 { return sign }
    var normalized = magnitude
    var exponent = 0
    while normalized >= 2.0 {
        normalized = normalized / 2.0
        exponent = exponent + 1
    }
    while normalized < 1.0 {
        normalized = normalized * 2.0
        exponent = exponent - 1
    }
    let significandInt = (normalized * 8388608.0) as Int
    let significand = significandInt as UInt32
    if exponent >= -126 {
        let exponentBits = ((exponent + 127) as UInt32) << (23 as UInt32)
        return sign | exponentBits | (significand - (0x800000 as UInt32))
    }
    let shift = (-126 - exponent) as UInt32
    return sign | (significand >> shift)
}

fun finiteFloat32Bits(value: Float, operation: String)
    r: Result<ReferenceBits32, ReferenceCodecError> {
    if not isfinite(value) {
        return Err<ReferenceBits32, ReferenceCodecError>(codecError(
            "qwen.codec.input", operation,
            "source value must be finite", 2))
    }
    let rounded = value as Float32
    if not isfinite(rounded as Float) {
        return Err<ReferenceBits32, ReferenceCodecError>(codecError(
            "qwen.codec.range", operation,
            "source value is outside finite binary32 range", 2))
    }
    let bits = float32Bits(rounded)
    if ((bits >> (23 as UInt32)) & (0xFF as UInt32)) ==
        (0xFF as UInt32) {
        return Err<ReferenceBits32, ReferenceCodecError>(codecError(
            "qwen.codec.range", operation,
            "source value is outside finite binary32 range", 2))
    }
    return Ok<ReferenceBits32, ReferenceCodecError>(ReferenceBits32{
        bits: bits
    })
}

pub fun encodeBFloat16(value: Float)
    r: Result<BFloat16, ReferenceCodecError> {
    let source = finiteFloat32Bits(value, "bf16.encode")
    if source.isErr() {
        return Err<BFloat16, ReferenceCodecError>(source.unwrapErr())
    }
    let bits = source.unwrap().bits
    let retainedLeastBit = (bits >> (16 as UInt32)) & (1 as UInt32)
    let rounded = bits + (0x7FFF as UInt32) + retainedLeastBit
    let encoded = (rounded >> (16 as UInt32)) as UInt16
    if (encoded & (0x7F80 as UInt16)) == (0x7F80 as UInt16) {
        return Err<BFloat16, ReferenceCodecError>(codecError(
            "qwen.codec.range", "bf16.encode",
            "finite source overflows BF16", 2))
    }
    return Ok<BFloat16, ReferenceCodecError>(BFloat16{ bits: encoded })
}

pub fun decodeBFloat16(value: BFloat16)
    r: Result<ReferenceFloatValue, ReferenceCodecError> {
    if (value.bits & (0x7F80 as UInt16)) == (0x7F80 as UInt16) {
        return Err<ReferenceFloatValue, ReferenceCodecError>(codecError(
            "qwen.codec.input", "bf16.decode",
            "encoded BF16 value must be finite", 2))
    }
    let exponent = ((value.bits as Int) >> 7) & 0xFF
    let mantissa = (value.bits as Int) & 0x7F
    var decoded = mantissa as Float
    var power = -133
    if exponent != 0 {
        decoded = (128 + mantissa) as Float
        power = exponent - 134
    }
    while power > 0 {
        decoded = decoded * 2.0
        power = power - 1
    }
    while power < 0 {
        decoded = decoded / 2.0
        power = power + 1
    }
    if (value.bits & (0x8000 as UInt16)) != (0 as UInt16) {
        decoded = -decoded
    }
    return Ok<ReferenceFloatValue, ReferenceCodecError>(ReferenceFloatValue{
        value: decoded
    })
}

fun roundRightEven(value: UInt32, shift: Int) r: UInt32 {
    let shiftWidth = shift as UInt32
    let truncated = value >> shiftWidth
    let mask = ((1 as UInt32) << shiftWidth) - (1 as UInt32)
    let remainder = value & mask
    let halfway = (1 as UInt32) << ((shift - 1) as UInt32)
    if remainder > halfway or
        (remainder == halfway and
         (truncated & (1 as UInt32)) == (1 as UInt32)) {
        return truncated + (1 as UInt32)
    }
    return truncated
}

pub fun encodeFloat16(value: Float)
    r: Result<Float16, ReferenceCodecError> {
    let source = finiteFloat32Bits(value, "f16.encode")
    if source.isErr() {
        return Err<Float16, ReferenceCodecError>(source.unwrapErr())
    }
    let bits = source.unwrap().bits
    let sign = ((bits >> (16 as UInt32)) & (0x8000 as UInt32))
    let exponent = ((bits >> (23 as UInt32)) & (0xFF as UInt32)) as Int
    let mantissa = bits & (0x7FFFFF as UInt32)
    let unbiased = exponent - 127

    if unbiased > 15 {
        return Err<Float16, ReferenceCodecError>(codecError(
            "qwen.codec.range", "f16.encode",
            "finite source overflows F16", 2))
    }
    if unbiased >= -14 {
        var halfExponent = unbiased + 15
        var halfMantissa = roundRightEven(mantissa, 13)
        if halfMantissa == (0x400 as UInt32) {
            halfMantissa = 0 as UInt32
            halfExponent = halfExponent + 1
        }
        if halfExponent >= 31 {
            return Err<Float16, ReferenceCodecError>(codecError(
                "qwen.codec.range", "f16.encode",
                "finite source overflows F16", 2))
        }
        let encoded = sign | ((halfExponent as UInt32) << (10 as UInt32)) |
            halfMantissa
        return Ok<Float16, ReferenceCodecError>(Float16{
            bits: encoded as UInt16
        })
    }
    if unbiased < -25 {
        return Ok<Float16, ReferenceCodecError>(Float16{
            bits: sign as UInt16
        })
    }
    let significand = (0x800000 as UInt32) | mantissa
    let subnormal = roundRightEven(significand, -unbiased - 1)
    return Ok<Float16, ReferenceCodecError>(Float16{
        bits: (sign | subnormal) as UInt16
    })
}

pub fun decodeFloat16(value: Float16)
    r: Result<ReferenceFloatValue, ReferenceCodecError> {
    let exponent = ((value.bits as Int) >> 10) & 0x1F
    let mantissa = (value.bits as Int) & 0x3FF
    if exponent == 0x1F {
        return Err<ReferenceFloatValue, ReferenceCodecError>(codecError(
            "qwen.codec.input", "f16.decode",
            "encoded F16 value must be finite", 2))
    }
    var decoded = mantissa as Float
    var power = -24
    if exponent != 0 {
        decoded = (1024 + mantissa) as Float
        power = exponent - 25
    }
    while power > 0 {
        decoded = decoded * 2.0
        power = power - 1
    }
    while power < 0 {
        decoded = decoded / 2.0
        power = power + 1
    }
    if (value.bits & (0x8000 as UInt16)) != (0 as UInt16) {
        decoded = -decoded
    }
    return Ok<ReferenceFloatValue, ReferenceCodecError>(ReferenceFloatValue{
        value: decoded
    })
}

fun validateEncodeLimit(values: Array<Float>, elementLimit: UInt64,
    operation: String) r: Result<UInt64, ReferenceCodecError> {
    if elementLimit == (0 as UInt64) {
        return Err<UInt64, ReferenceCodecError>(codecError(
            "qwen.codec.input", operation,
            "element limit must be positive", 2))
    }
    let length = values.length() as UInt64
    if length > elementLimit {
        return Err<UInt64, ReferenceCodecError>(codecError(
            "qwen.codec.limit", operation,
            "input exceeds the explicit element limit", 2))
    }
    return Ok<UInt64, ReferenceCodecError>(length)
}

fun validateDecodeBuffer(buffer: Reference16Buffer, codec: String,
    elementLimit: UInt64, operation: String)
    r: Result<UInt64, ReferenceCodecError> {
    if buffer.closed {
        return Err<UInt64, ReferenceCodecError>(codecError(
            "qwen.codec.closed", operation,
            "encoded buffer is closed", 11))
    }
    if buffer.codec != codec {
        return Err<UInt64, ReferenceCodecError>(codecError(
            "qwen.codec.mismatch", operation,
            "encoded buffer codec does not match decoder", 3))
    }
    if elementLimit == (0 as UInt64) {
        return Err<UInt64, ReferenceCodecError>(codecError(
            "qwen.codec.input", operation,
            "element limit must be positive", 2))
    }
    let length = buffer.words.length() as UInt64
    if length > elementLimit {
        return Err<UInt64, ReferenceCodecError>(codecError(
            "qwen.codec.limit", operation,
            "encoded buffer exceeds the explicit element limit", 2))
    }
    return Ok<UInt64, ReferenceCodecError>(length)
}

pub fun encodeBFloat16Buffer(values: Array<Float>, elementLimit: UInt64)
    r: Result<Reference16Buffer, ReferenceCodecError> {
    let valid = validateEncodeLimit(values, elementLimit, "bf16.encode-buffer")
    if valid.isErr() {
        return Err<Reference16Buffer, ReferenceCodecError>(valid.unwrapErr())
    }
    let words = Array<UInt16>()
    var index = 0
    while index < values.length() {
        let encoded = encodeBFloat16(values[index])
        if encoded.isErr() {
            words.free()
            return Err<Reference16Buffer, ReferenceCodecError>(
                encoded.unwrapErr())
        }
        words.push(encoded.unwrap().bits)
        index = index + 1
    }
    return Ok<Reference16Buffer, ReferenceCodecError>(Reference16Buffer{
        codec: "BF16", words: words, closed: false
    })
}

pub fun encodeFloat16Buffer(values: Array<Float>, elementLimit: UInt64)
    r: Result<Reference16Buffer, ReferenceCodecError> {
    let valid = validateEncodeLimit(values, elementLimit, "f16.encode-buffer")
    if valid.isErr() {
        return Err<Reference16Buffer, ReferenceCodecError>(valid.unwrapErr())
    }
    let words = Array<UInt16>()
    var index = 0
    while index < values.length() {
        let encoded = encodeFloat16(values[index])
        if encoded.isErr() {
            words.free()
            return Err<Reference16Buffer, ReferenceCodecError>(
                encoded.unwrapErr())
        }
        words.push(encoded.unwrap().bits)
        index = index + 1
    }
    return Ok<Reference16Buffer, ReferenceCodecError>(Reference16Buffer{
        codec: "F16", words: words, closed: false
    })
}

pub fun decodeBFloat16Buffer(buffer: Reference16Buffer,
    elementLimit: UInt64) r: Result<Array<Float>, ReferenceCodecError> {
    let valid = validateDecodeBuffer(buffer, "BF16", elementLimit,
        "bf16.decode-buffer")
    if valid.isErr() {
        return Err<Array<Float>, ReferenceCodecError>(valid.unwrapErr())
    }
    let values = Array<Float>()
    var index = 0
    while index < buffer.words.length() {
        let decoded = decodeBFloat16(BFloat16{ bits: buffer.words[index] })
        if decoded.isErr() {
            values.free()
            return Err<Array<Float>, ReferenceCodecError>(decoded.unwrapErr())
        }
        values.push(decoded.unwrap().value)
        index = index + 1
    }
    return Ok<Array<Float>, ReferenceCodecError>(values)
}

pub fun decodeFloat16Buffer(buffer: Reference16Buffer,
    elementLimit: UInt64) r: Result<Array<Float>, ReferenceCodecError> {
    let valid = validateDecodeBuffer(buffer, "F16", elementLimit,
        "f16.decode-buffer")
    if valid.isErr() {
        return Err<Array<Float>, ReferenceCodecError>(valid.unwrapErr())
    }
    let values = Array<Float>()
    var index = 0
    while index < buffer.words.length() {
        let decoded = decodeFloat16(Float16{ bits: buffer.words[index] })
        if decoded.isErr() {
            values.free()
            return Err<Array<Float>, ReferenceCodecError>(decoded.unwrapErr())
        }
        values.push(decoded.unwrap().value)
        index = index + 1
    }
    return Ok<Array<Float>, ReferenceCodecError>(values)
}

fun q8GroupsPerRow(rowElements: UInt64, operation: String)
    r: Result<UInt64, ReferenceCodecError> {
    if rowElements == (0 as UInt64) {
        return Err<UInt64, ReferenceCodecError>(codecError(
            "qwen.codec.input", operation,
            "row element count must be positive", 2))
    }
    if rowElements > (0xFFFFFFFFFFFFFFC0 as UInt64) {
        return Err<UInt64, ReferenceCodecError>(codecError(
            "qwen.codec.range", operation,
            "row group geometry overflows UInt64", 2))
    }
    return Ok<UInt64, ReferenceCodecError>(
        (rowElements + (63 as UInt64)) / (64 as UInt64))
}

fun q8ExpectedGroups(logicalElements: UInt64, rowElements: UInt64,
    elementLimit: UInt64, operation: String)
    r: Result<UInt64, ReferenceCodecError> {
    if elementLimit == (0 as UInt64) {
        return Err<UInt64, ReferenceCodecError>(codecError(
            "qwen.codec.input", operation,
            "element limit must be positive", 2))
    }
    if logicalElements > elementLimit or rowElements > elementLimit {
        return Err<UInt64, ReferenceCodecError>(codecError(
            "qwen.codec.limit", operation,
            "Q8 geometry exceeds the explicit element limit", 2))
    }
    let groupsPerRow = q8GroupsPerRow(rowElements, operation)
    if groupsPerRow.isErr() {
        return Err<UInt64, ReferenceCodecError>(groupsPerRow.unwrapErr())
    }
    if logicalElements % rowElements != (0 as UInt64) {
        return Err<UInt64, ReferenceCodecError>(codecError(
            "qwen.codec.geometry", operation,
            "logical element count must contain complete rows", 2))
    }
    let rows = logicalElements / rowElements
    if rows > (0 as UInt64) and
        groupsPerRow.unwrap() > (0xFFFFFFFFFFFFFFFF as UInt64) / rows {
        return Err<UInt64, ReferenceCodecError>(codecError(
            "qwen.codec.range", operation,
            "Q8 scale geometry overflows UInt64", 2))
    }
    return Ok<UInt64, ReferenceCodecError>(rows * groupsPerRow.unwrap())
}

fun q8RoundEven(value: Float) r: Int {
    let negative = value < 0.0
    let magnitude = if negative { -value } else { value }
    var rounded = magnitude as Int
    let remainder = magnitude - (rounded as Float)
    if remainder > 0.5 or (remainder == 0.5 and rounded % 2 != 0) {
        rounded = rounded + 1
    }
    if negative { return -rounded }
    return rounded
}

fun q8CodeByte(value: Int) r: UInt8 {
    if value < 0 { return (value + 256) as UInt8 }
    return value as UInt8
}

fun q8SignedCode(value: UInt8) r: Int {
    let widened = value as Int
    if widened > 127 { return widened - 256 }
    return widened
}

pub fun encodeQ8SymG64Buffer(values: Array<Float>, rowElements: UInt64,
    elementLimit: UInt64) r: Result<ReferenceQ8Buffer, ReferenceCodecError> {
    let logicalElements = values.length() as UInt64
    let expectedGroups = q8ExpectedGroups(logicalElements, rowElements,
        elementLimit, "q8.encode-buffer")
    if expectedGroups.isErr() {
        return Err<ReferenceQ8Buffer, ReferenceCodecError>(
            expectedGroups.unwrapErr())
    }
    let codes = Array<UInt8>()
    let scales = Array<UInt16>()
    let groupsPerRow = q8GroupsPerRow(rowElements,
        "q8.encode-buffer").unwrap()
    let rows = logicalElements / rowElements
    var row: UInt64 = 0 as UInt64
    while row < rows {
        var group: UInt64 = 0 as UInt64
        while group < groupsPerRow {
            let first = row * rowElements + group * (64 as UInt64)
            var count = rowElements - group * (64 as UInt64)
            if count > (64 as UInt64) { count = 64 as UInt64 }
            var maxAbs: Float = 0.0
            var offset: UInt64 = 0 as UInt64
            while offset < count {
                let source = finiteFloat32Bits(values[(first + offset) as Int],
                    "q8.encode-buffer")
                if source.isErr() {
                    codes.free(); scales.free()
                    return Err<ReferenceQ8Buffer, ReferenceCodecError>(
                        source.unwrapErr())
                }
                let rounded = values[(first + offset) as Int] as Float32
                let magnitude = abs(rounded as Float)
                if magnitude > maxAbs { maxAbs = magnitude }
                offset = offset + (1 as UInt64)
            }
            if maxAbs == 0.0 {
                scales.push(0 as UInt16)
                offset = 0 as UInt64
                while offset < count {
                    codes.push(0 as UInt8)
                    offset = offset + (1 as UInt64)
                }
            } else {
                let scale = (maxAbs as Float32) / (127.0 as Float32)
                let storedScale = encodeFloat16(scale as Float)
                if storedScale.isErr() or storedScale.unwrap().bits ==
                    (0 as UInt16) {
                    codes.free(); scales.free()
                    return Err<ReferenceQ8Buffer, ReferenceCodecError>(
                        codecError("qwen.codec.range", "q8.encode-buffer",
                            "nonzero Q8 group scale is not representable as finite FP16", 2))
                }
                scales.push(storedScale.unwrap().bits)
                offset = 0 as UInt64
                while offset < count {
                    let source = values[(first + offset) as Int] as Float32
                    var quantized = q8RoundEven(
                        (source / scale) as Float)
                    if quantized < -127 { quantized = -127 }
                    if quantized > 127 { quantized = 127 }
                    codes.push(q8CodeByte(quantized))
                    offset = offset + (1 as UInt64)
                }
            }
            group = group + (1 as UInt64)
        }
        row = row + (1 as UInt64)
    }
    return Ok<ReferenceQ8Buffer, ReferenceCodecError>(ReferenceQ8Buffer{
        codec: "Q8_SYM_G64", rowElements: rowElements,
        logicalElements: logicalElements, codes: codes, scales: scales,
        closed: false
    })
}

pub fun decodeQ8SymG64Buffer(buffer: ReferenceQ8Buffer,
    elementLimit: UInt64) r: Result<Array<Float>, ReferenceCodecError> {
    if buffer.closed {
        return Err<Array<Float>, ReferenceCodecError>(codecError(
            "qwen.codec.closed", "q8.decode-buffer",
            "encoded buffer is closed", 11))
    }
    if buffer.codec != "Q8_SYM_G64" {
        return Err<Array<Float>, ReferenceCodecError>(codecError(
            "qwen.codec.mismatch", "q8.decode-buffer",
            "encoded buffer codec does not match decoder", 3))
    }
    let expectedGroups = q8ExpectedGroups(buffer.logicalElements,
        buffer.rowElements, elementLimit, "q8.decode-buffer")
    if expectedGroups.isErr() {
        return Err<Array<Float>, ReferenceCodecError>(
            expectedGroups.unwrapErr())
    }
    if buffer.codes.length() as UInt64 != buffer.logicalElements or
        buffer.scales.length() as UInt64 != expectedGroups.unwrap() {
        return Err<Array<Float>, ReferenceCodecError>(codecError(
            "qwen.codec.geometry", "q8.decode-buffer",
            "Q8 payload or scale length is not canonical", 2))
    }
    let values = Array<Float>()
    let groupsPerRow = q8GroupsPerRow(buffer.rowElements,
        "q8.decode-buffer").unwrap()
    let rows = buffer.logicalElements / buffer.rowElements
    var row: UInt64 = 0 as UInt64
    while row < rows {
        var group: UInt64 = 0 as UInt64
        while group < groupsPerRow {
            let first = row * buffer.rowElements + group * (64 as UInt64)
            var count = buffer.rowElements - group * (64 as UInt64)
            if count > (64 as UInt64) { count = 64 as UInt64 }
            let scaleBits = buffer.scales[(row * groupsPerRow + group) as Int]
            let decodedScale = decodeFloat16(Float16{ bits: scaleBits })
            if decodedScale.isErr() or decodedScale.unwrap().value < 0.0 {
                values.free()
                return Err<Array<Float>, ReferenceCodecError>(codecError(
                    "qwen.codec.input", "q8.decode-buffer",
                    "Q8 scale must be finite and nonnegative", 2))
            }
            let scale = decodedScale.unwrap().value
            var offset: UInt64 = 0 as UInt64
            while offset < count {
                let quantized = q8SignedCode(
                    buffer.codes[(first + offset) as Int])
                if quantized == -128 or (scale == 0.0 and quantized != 0) {
                    values.free()
                    return Err<Array<Float>, ReferenceCodecError>(codecError(
                        "qwen.codec.input", "q8.decode-buffer",
                        "Q8 code is not canonical for its scale", 2))
                }
                values.push((quantized as Float) * scale)
                offset = offset + (1 as UInt64)
            }
            group = group + (1 as UInt64)
        }
        row = row + (1 as UInt64)
    }
    return Ok<Array<Float>, ReferenceCodecError>(values)
}

fun q4ExpectedBytes(logicalElements: UInt64, rowElements: UInt64,
    operation: String) r: Result<UInt64, ReferenceCodecError> {
    if rowElements > (0xFFFFFFFFFFFFFFFE as UInt64) {
        return Err<UInt64, ReferenceCodecError>(codecError(
            "qwen.codec.range", operation,
            "Q4 row payload geometry overflows UInt64", 2))
    }
    let rows = logicalElements / rowElements
    let bytesPerRow = (rowElements + (1 as UInt64)) / (2 as UInt64)
    if rows > (0 as UInt64) and
        bytesPerRow > (0xFFFFFFFFFFFFFFFF as UInt64) / rows {
        return Err<UInt64, ReferenceCodecError>(codecError(
            "qwen.codec.range", operation,
            "Q4 payload geometry overflows UInt64", 2))
    }
    return Ok<UInt64, ReferenceCodecError>(rows * bytesPerRow)
}

fun q4CodeNibble(value: Int) r: UInt8 {
    if value < 0 { return (value + 16) as UInt8 }
    return value as UInt8
}

fun q4SignedCode(value: UInt8) r: Int {
    let widened = value as Int
    if widened > 7 { return widened - 16 }
    return widened
}

pub fun encodeQ4SymG64Buffer(values: Array<Float>, rowElements: UInt64,
    elementLimit: UInt64) r: Result<ReferenceQ4Buffer, ReferenceCodecError> {
    let logicalElements = values.length() as UInt64
    let expectedGroups = q8ExpectedGroups(logicalElements, rowElements,
        elementLimit, "q4.encode-buffer")
    if expectedGroups.isErr() {
        return Err<ReferenceQ4Buffer, ReferenceCodecError>(
            expectedGroups.unwrapErr())
    }
    let expectedBytes = q4ExpectedBytes(logicalElements, rowElements,
        "q4.encode-buffer")
    if expectedBytes.isErr() {
        return Err<ReferenceQ4Buffer, ReferenceCodecError>(
            expectedBytes.unwrapErr())
    }
    let bytes = Array<UInt8>()
    let scales = Array<UInt16>()
    let groupsPerRow = q8GroupsPerRow(rowElements,
        "q4.encode-buffer").unwrap()
    let rows = logicalElements / rowElements
    var row: UInt64 = 0 as UInt64
    while row < rows {
        var group: UInt64 = 0 as UInt64
        while group < groupsPerRow {
            let first = row * rowElements + group * (64 as UInt64)
            var count = rowElements - group * (64 as UInt64)
            if count > (64 as UInt64) { count = 64 as UInt64 }
            var maxAbs: Float = 0.0
            var offset: UInt64 = 0 as UInt64
            while offset < count {
                let source = finiteFloat32Bits(values[(first + offset) as Int],
                    "q4.encode-buffer")
                if source.isErr() {
                    bytes.free(); scales.free()
                    return Err<ReferenceQ4Buffer, ReferenceCodecError>(
                        source.unwrapErr())
                }
                let rounded = values[(first + offset) as Int] as Float32
                let magnitude = abs(rounded as Float)
                if magnitude > maxAbs { maxAbs = magnitude }
                offset = offset + (1 as UInt64)
            }
            var scale: Float32 = 0.0 as Float32
            if maxAbs == 0.0 {
                scales.push(0 as UInt16)
            } else {
                scale = (maxAbs as Float32) / (7.0 as Float32)
                let storedScale = encodeFloat16(scale as Float)
                if storedScale.isErr() or storedScale.unwrap().bits ==
                    (0 as UInt16) {
                    bytes.free(); scales.free()
                    return Err<ReferenceQ4Buffer, ReferenceCodecError>(
                        codecError("qwen.codec.range", "q4.encode-buffer",
                            "nonzero Q4 group scale is not representable as finite FP16", 2))
                }
                scales.push(storedScale.unwrap().bits)
            }
            offset = 0 as UInt64
            while offset < count {
                var low = 0
                var high = 0
                if maxAbs != 0.0 {
                    low = q8RoundEven(((values[(first + offset) as Int] as
                        Float32) / scale) as Float)
                    if low < -8 { low = -8 }
                    if low > 7 { low = 7 }
                    if offset + (1 as UInt64) < count {
                        high = q8RoundEven(((values[(first + offset +
                            (1 as UInt64)) as Int] as Float32) / scale) as Float)
                        if high < -8 { high = -8 }
                        if high > 7 { high = 7 }
                    }
                }
                bytes.push(q4CodeNibble(low) |
                    (q4CodeNibble(high) << (4 as UInt8)))
                offset = offset + (2 as UInt64)
            }
            group = group + (1 as UInt64)
        }
        row = row + (1 as UInt64)
    }
    return Ok<ReferenceQ4Buffer, ReferenceCodecError>(ReferenceQ4Buffer{
        codec: "Q4_SYM_G64", rowElements: rowElements,
        logicalElements: logicalElements, bytes: bytes, scales: scales,
        closed: false
    })
}

pub fun decodeQ4SymG64Buffer(buffer: ReferenceQ4Buffer,
    elementLimit: UInt64) r: Result<Array<Float>, ReferenceCodecError> {
    if buffer.closed {
        return Err<Array<Float>, ReferenceCodecError>(codecError(
            "qwen.codec.closed", "q4.decode-buffer",
            "encoded buffer is closed", 11))
    }
    if buffer.codec != "Q4_SYM_G64" {
        return Err<Array<Float>, ReferenceCodecError>(codecError(
            "qwen.codec.mismatch", "q4.decode-buffer",
            "encoded buffer codec does not match decoder", 3))
    }
    let expectedGroups = q8ExpectedGroups(buffer.logicalElements,
        buffer.rowElements, elementLimit, "q4.decode-buffer")
    if expectedGroups.isErr() {
        return Err<Array<Float>, ReferenceCodecError>(
            expectedGroups.unwrapErr())
    }
    let expectedBytes = q4ExpectedBytes(buffer.logicalElements,
        buffer.rowElements, "q4.decode-buffer")
    if expectedBytes.isErr() {
        return Err<Array<Float>, ReferenceCodecError>(expectedBytes.unwrapErr())
    }
    if buffer.bytes.length() as UInt64 != expectedBytes.unwrap() or
        buffer.scales.length() as UInt64 != expectedGroups.unwrap() {
        return Err<Array<Float>, ReferenceCodecError>(codecError(
            "qwen.codec.geometry", "q4.decode-buffer",
            "Q4 payload or scale length is not canonical", 2))
    }
    let values = Array<Float>()
    let groupsPerRow = q8GroupsPerRow(buffer.rowElements,
        "q4.decode-buffer").unwrap()
    let bytesPerRow = (buffer.rowElements + (1 as UInt64)) / (2 as UInt64)
    let rows = buffer.logicalElements / buffer.rowElements
    var row: UInt64 = 0 as UInt64
    while row < rows {
        if buffer.rowElements % (2 as UInt64) != (0 as UInt64) {
            let lastByte = buffer.bytes[(row * bytesPerRow + bytesPerRow -
                (1 as UInt64)) as Int]
            if (lastByte >> (4 as UInt8)) != (0 as UInt8) {
                values.free()
                return Err<Array<Float>, ReferenceCodecError>(codecError(
                    "qwen.codec.input", "q4.decode-buffer",
                    "Q4 row tail padding nibble must be zero", 2))
            }
        }
        var group: UInt64 = 0 as UInt64
        while group < groupsPerRow {
            let first = group * (64 as UInt64)
            var count = buffer.rowElements - first
            if count > (64 as UInt64) { count = 64 as UInt64 }
            let scaleBits = buffer.scales[(row * groupsPerRow + group) as Int]
            let decodedScale = decodeFloat16(Float16{ bits: scaleBits })
            if decodedScale.isErr() or decodedScale.unwrap().value < 0.0 {
                values.free()
                return Err<Array<Float>, ReferenceCodecError>(codecError(
                    "qwen.codec.input", "q4.decode-buffer",
                    "Q4 scale must be finite and nonnegative", 2))
            }
            let scale = decodedScale.unwrap().value
            var offset: UInt64 = 0 as UInt64
            while offset < count {
                let logical = first + offset
                let packed = buffer.bytes[(row * bytesPerRow +
                    logical / (2 as UInt64)) as Int]
                let nibble = if logical % (2 as UInt64) == (0 as UInt64) {
                    packed & (15 as UInt8)
                } else {
                    (packed >> (4 as UInt8)) & (15 as UInt8)
                }
                let quantized = q4SignedCode(nibble)
                if scale == 0.0 and quantized != 0 {
                    values.free()
                    return Err<Array<Float>, ReferenceCodecError>(codecError(
                        "qwen.codec.input", "q4.decode-buffer",
                        "Q4 code is not canonical for its scale", 2))
                }
                values.push((quantized as Float) * scale)
                offset = offset + (1 as UInt64)
            }
            group = group + (1 as UInt64)
        }
        row = row + (1 as UInt64)
    }
    return Ok<Array<Float>, ReferenceCodecError>(values)
}
