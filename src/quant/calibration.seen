fun expectedPayloadKinds() r: Array<String> {
    let values = Array<String>()
    var index = 0
    while index < QWEN_CALIBRATION_SAMPLE_COUNT {
        let recipe = index == 0 or index == 1 or index == 5 or index == 8 or
            index == 9 or index == 10
        values.push(if recipe { "canonical-token-recipe" } else {
            "rendered-utf8"
        })
        index = index + 1
    }
    return values
}

