pub class QwenCalibrationLock {
    var document: JsonParseResult
    var lockSha256: String
    var sampleCount: Int
    var aggregateTokens: Int
    var closed: Bool

    fun sampleIdAt(index: Int) r: Result<String, QwenCalibrationError> {
        if this.closed {
            return Err<String, QwenCalibrationError>(calibrationError(
                "qwen.calibration.closed", "lock", "calibration lock is closed"))
        }
        if index < 0 or index >= this.sampleCount {
            return Err<String, QwenCalibrationError>(calibrationError(
                "qwen.calibration.bounds", "sample", "sample index is outside the lock"))
        }
        let root = this.document.value.unwrap()
        let samples = calibrationField(root, "samples").unwrap()
        let sample = samples.getAt(index).unwrap()
        return Ok<String, QwenCalibrationError>(
            calibrationField(sample, "id").unwrap().getString())
    }

    fun sourceIdAt(index: Int) r: Result<String, QwenCalibrationError> {
        if this.closed {
            return Err<String, QwenCalibrationError>(calibrationError(
                "qwen.calibration.closed", "lock", "calibration lock is closed"))
        }
        if index < 0 or index >= QWEN_CALIBRATION_SOURCE_COUNT {
            return Err<String, QwenCalibrationError>(calibrationError(
                "qwen.calibration.bounds", "source", "source index is outside the lock"))
        }
        let root = this.document.value.unwrap()
        let sources = calibrationField(root, "sources").unwrap()
        let source = sources.getAt(index).unwrap()
        return Ok<String, QwenCalibrationError>(
            calibrationField(source, "id").unwrap().getString())
    }

    fun close() r: Void {
        if this.closed { return }
        destroyJsonParseResult(this.document, true)
        seen_string_release_owned(this.lockSha256)
        this.sampleCount = 0
        this.aggregateTokens = 0
        this.closed = true
    }
}

fun validateModel(root: JsonValue) r: Bool {
    let value = calibrationField(root, "model")
    if value.isNone() { return false }
    let fields = modelFields()
    let exact = calibrationExactFields(value.unwrap(), fields)
    fields.free()
    if not exact { return false }
    let model = value.unwrap()
    return calibrationStringEquals(model, "model_id", "Qwen/Qwen3.8-27B") and
        calibrationStringEquals(model, "model_revision",
            "1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0") and
        calibrationStringEquals(model, "license", "Apache-2.0") and
        calibrationStringEquals(model, "tensor_index_sha256",
            "77042094076611b69791a610065f28b7013b8c621795fa86ddccc8bac7d1b9df") and
        calibrationStringEquals(model, "tokenizer_revision",
            "1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0") and
        calibrationStringEquals(model, "tokenizer_oracle_sha256",
            "0b5c8911aa07565c03e036c54bfdf731263d983c6513344377d7d1454f3bcf0a") and
        calibrationBoolEquals(model, "trust_remote_code", false)
}

fun validateSources(root: JsonValue) r: Bool {
    let value = calibrationField(root, "sources")
    if value.isNone() or not value.unwrap().isArray() or
        value.unwrap().length() != QWEN_CALIBRATION_SOURCE_COUNT {
        return false
    }
    let ids = expectedSourceIds(); let kinds = expectedSourceKinds()
    let paths = expectedSourcePaths(); let byteCounts = expectedSourceBytes()
    let digests = expectedSourceDigests()
    var valid = true
    var index = 0
    while index < QWEN_CALIBRATION_SOURCE_COUNT and valid {
        let entryValue = value.unwrap().getAt(index)
        let fields = sourceFields()
        let exact = not entryValue.isNone() and
            calibrationExactFields(entryValue.unwrap(), fields)
        fields.free()
        if not exact { valid = false } else {
            let entry = entryValue.unwrap()
            let revision = "sha256:" + digests[index]
            valid = calibrationStringEquals(entry, "id", ids[index]) and
                calibrationStringEquals(entry, "kind", kinds[index]) and
                calibrationStringEquals(entry, "path", paths[index]) and
                calibrationStringEquals(entry, "revision", revision) and
                calibrationStringEquals(entry, "license", "Apache-2.0") and
                calibrationStringEquals(entry, "bytes", byteCounts[index]) and
                calibrationStringEquals(entry, "sha256", digests[index]) and
                calibrationBoolEquals(entry, "runtime_executable", false) and
                calibrationBoolEquals(entry, "private_data", false)
            seen_string_release_owned(revision)
        }
        index = index + 1
    }
    ids.free(); kinds.free(); paths.free(); byteCounts.free(); digests.free()
    return valid
}

fun validateSamples(root: JsonValue) r: Bool {
    let value = calibrationField(root, "samples")
    if value.isNone() or not value.unwrap().isArray() or
        value.unwrap().length() != QWEN_CALIBRATION_SAMPLE_COUNT {
        return false
    }
    let ids = expectedSampleIds(); let sources = expectedSampleSources()
    let kinds = expectedPayloadKinds(); let digests = expectedSampleDigests()
    let tokens = expectedSampleTokens(); let roles = expectedSampleRoles()
    var valid = true
    var total = 0
    var index = 0
    while index < QWEN_CALIBRATION_SAMPLE_COUNT and valid {
        let entryValue = value.unwrap().getAt(index)
        let fields = sampleFields()
        let exact = not entryValue.isNone() and
            calibrationExactFields(entryValue.unwrap(), fields)
        fields.free()
        if not exact { valid = false } else {
            let entry = entryValue.unwrap()
            let digestValue = calibrationField(entry, "payload_sha256")
            valid = calibrationStringEquals(entry, "id", ids[index]) and
                calibrationStringEquals(entry, "source_id", sources[index]) and
                calibrationStringEquals(entry, "payload_kind", kinds[index]) and
                not digestValue.isNone() and digestValue.unwrap().isString() and
                calibrationDigestValid(digestValue.unwrap().getString()) and
                calibrationStringEquals(entry, "payload_sha256", digests[index]) and
                calibrationIntEquals(entry, "token_count", tokens[index]) and
                calibrationStringEquals(entry, "role", roles[index])
            total = total + tokens[index]
        }
        index = index + 1
    }
    ids.free(); sources.free(); kinds.free(); digests.free(); tokens.free()
    roles.free()
    return valid and total == QWEN_CALIBRATION_AGGREGATE_TOKENS
}

fun validateBoundsAndCoverage(root: JsonValue) r: Bool {
    let boundsValue = calibrationField(root, "bounds")
    let coverageValue = calibrationField(root, "coverage")
    if boundsValue.isNone() or coverageValue.isNone() { return false }
    let boundedFields = boundsFields()
    let boundedExact = calibrationExactFields(boundsValue.unwrap(), boundedFields)
    boundedFields.free()
    let coveredFields = coverageFields()
    let coveredExact = calibrationExactFields(coverageValue.unwrap(), coveredFields)
    coveredFields.free()
    if not boundedExact or not coveredExact { return false }
    let bounds = boundsValue.unwrap()
    if not calibrationIntEquals(bounds, "source_count", 4) or
        not calibrationIntEquals(bounds, "sample_count", 14) or
        not calibrationIntEquals(bounds, "aggregate_tokens", 426873) or
        not calibrationIntEquals(bounds, "max_sample_tokens", 262144) or
        not calibrationStringEquals(bounds, "max_generated_bytes", "8388608") or
        not calibrationIntEquals(bounds, "workers", 1) {
        return false
    }
    let coverage = coverageValue.unwrap()
    let names = coverageFields()
    var index = 0
    var valid = true
    while index < names.length() and valid {
        valid = calibrationBoolEquals(coverage, names[index], true)
        index = index + 1
    }
    names.free()
    return valid
}

pub fun parseQwenCalibrationLock(text: String)
    r: Result<QwenCalibrationLock, QwenCalibrationError> {
    if text.length() < 2 or text.length() > 65536 {
        return Err<QwenCalibrationLock, QwenCalibrationError>(calibrationError(
            "qwen.calibration.bounds", "lock", "calibration lock is empty or exceeds 64 KiB"))
    }
    let parsed = parseStrictJson(text, StrictJsonLimits{
        maxInputBytes: 65536, maxDepth: 12, maxValues: 1024,
        maxStringBytes: 512,
    })
    if parsed.isErr() {
        return Err<QwenCalibrationLock, QwenCalibrationError>(calibrationError(
            "qwen.calibration.json", "lock", "calibration lock is not strict bounded JSON"))
    }
    let document = parsed.unwrap()
    if document.value.isNone() or not document.value.unwrap().isObject() {
        destroyJsonParseResult(document, true)
        return Err<QwenCalibrationLock, QwenCalibrationError>(calibrationError(
            "qwen.calibration.schema", "lock", "calibration lock root must be an object"))
    }
    let root = document.value.unwrap()
    let fields = rootFields()
    let exact = calibrationExactFields(root, fields)
    fields.free()
    if not exact {
        destroyJsonParseResult(document, true)
        return Err<QwenCalibrationLock, QwenCalibrationError>(calibrationError(
            "qwen.calibration.schema", "lock", "calibration lock fields differ from the closed v1 schema"))
    }
    if not calibrationStringEquals(root, "schema",
            "seen-qwen-calibration-lock-v1") or
        not calibrationStringEquals(root, "version", "1") or
        not calibrationStringEquals(root, "classification",
            "calibration-input-lock") or
        not calibrationStringEquals(root, "privacy",
            "public-and-project-authored-no-private-user-data") or
        not calibrationStringEquals(root, "ordering",
            "lexicographic-sample-id") or not validateModel(root) {
        destroyJsonParseResult(document, true)
        return Err<QwenCalibrationLock, QwenCalibrationError>(calibrationError(
            "qwen.calibration.compatibility", "identity", "calibration identity differs from the frozen contract"))
    }
    if not validateSources(root) {
        destroyJsonParseResult(document, true)
        return Err<QwenCalibrationLock, QwenCalibrationError>(calibrationError(
            "qwen.calibration.provenance", "sources", "source provenance is missing, reordered, runtime-executable, private, or incompatible"))
    }
    if not validateSamples(root) {
        destroyJsonParseResult(document, true)
        return Err<QwenCalibrationLock, QwenCalibrationError>(calibrationError(
            "qwen.calibration.corpus", "samples", "samples are missing, duplicate, reordered, corrupt, or outside bounds"))
    }
    if not validateBoundsAndCoverage(root) {
        destroyJsonParseResult(document, true)
        return Err<QwenCalibrationLock, QwenCalibrationError>(calibrationError(
            "qwen.calibration.coverage", "coverage", "corpus bounds or required coverage differ from the frozen contract"))
    }
    let digest = sha256(text)
    if digest.isErr() {
        destroyJsonParseResult(document, true)
        return Err<QwenCalibrationLock, QwenCalibrationError>(calibrationError(
            "qwen.calibration.checksum", "lock", "failed to hash the validated calibration lock"))
    }
    return Ok<QwenCalibrationLock, QwenCalibrationError>(QwenCalibrationLock{
        document: document, lockSha256: digest.unwrap(),
        sampleCount: QWEN_CALIBRATION_SAMPLE_COUNT,
        aggregateTokens: QWEN_CALIBRATION_AGGREGATE_TOKENS,
        closed: false,
    })
}
