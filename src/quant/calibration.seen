///
/// Closed, bounded calibration-corpus lock for Qwen3.8-27B.
///
/// The lock admits only the already certified QWN-022B/QWN-025B corpus and
/// project-authored deterministic token recipes. It contains no private data,
/// executable expressions, network locations, or runtime fallback policy.
/// Borrowed sample/source strings remain valid only while the returned lock
/// owns its strict-JSON document.
///

import core.result.{Result}
import crypto.sha256.{sha256}
import json.parser.{JsonParseResult, destroyJsonParseResult}
import json.strict.{StrictJsonLimits, parseStrictJson}
import json.value.{JsonValue}

extern "C" fun seen_string_release_owned(value: String) r: Void

let QWEN_CALIBRATION_SAMPLE_COUNT: Int = 14
let QWEN_CALIBRATION_SOURCE_COUNT: Int = 4
let QWEN_CALIBRATION_AGGREGATE_TOKENS: Int = 426873
let QWEN_CALIBRATION_MAX_SAMPLE_TOKENS: Int = 262144

pub class QwenCalibrationError {
    var code: String
    var field: String
    var message: String
}

fun calibrationError(code: String, field: String, message: String)
    r: QwenCalibrationError {
    return QwenCalibrationError{ code: code, field: field, message: message }
}

fun calibrationField(object: JsonValue, field: String) r: JsonValue? {
    if not object.isObject() { return null }
    var index = 0
    while index < object.length() {
        let key = object.keyAt(index)
        let value = object.valueAt(index)
        if key.isNone() or value.isNone() { return null }
        if key.unwrap() == field { return value.unwrap() }
        index = index + 1
    }
    return null
}

fun calibrationExactFields(object: JsonValue, fields: Array<String>) r: Bool {
    if not object.isObject() or object.length() != fields.length() {
        return false
    }
    var index = 0
    while index < object.length() {
        let key = object.keyAt(index)
        let value = object.valueAt(index)
        if key.isNone() or value.isNone() { return false }
        var known = false
        var fieldIndex = 0
        while fieldIndex < fields.length() {
            if key.unwrap() == fields[fieldIndex] { known = true }
            fieldIndex = fieldIndex + 1
        }
        if not known { return false }
        index = index + 1
    }
    return true
}

fun calibrationStringEquals(object: JsonValue, field: String,
    expected: String) r: Bool {
    let value = calibrationField(object, field)
    return not value.isNone() and value.unwrap().isString() and
        value.unwrap().getString() == expected
}

fun calibrationBoolEquals(object: JsonValue, field: String,
    expected: Bool) r: Bool {
    let value = calibrationField(object, field)
    return not value.isNone() and value.unwrap().isBool() and
        value.unwrap().getBool() == expected
}

fun calibrationIntEquals(object: JsonValue, field: String,
    expected: Int) r: Bool {
    let value = calibrationField(object, field)
    return not value.isNone() and value.unwrap().isNumber() and
        value.unwrap().getNumber() == expected.toFloat() and
        value.unwrap().getInt() == expected
}

fun calibrationDigestValid(value: String) r: Bool {
    if value.length() != 64 { return false }
    var index = 0
    while index < value.length() {
        let byte = value.byteAt(index)
        let digit = byte >= 48 and byte <= 57
        let lower = byte >= 97 and byte <= 102
        if not digit and not lower { return false }
        index = index + 1
    }
    return true
}

fun rootFields() r: Array<String> {
    let fields = Array<String>()
    fields.push("schema"); fields.push("version")
    fields.push("classification"); fields.push("privacy")
    fields.push("ordering"); fields.push("model")
    fields.push("sources"); fields.push("samples")
    fields.push("bounds"); fields.push("coverage")
    return fields
}

fun modelFields() r: Array<String> {
    let fields = Array<String>()
    fields.push("model_id"); fields.push("model_revision")
    fields.push("license"); fields.push("tensor_index_sha256")
    fields.push("tokenizer_revision")
    fields.push("tokenizer_oracle_sha256")
    fields.push("trust_remote_code")
    return fields
}

fun sourceFields() r: Array<String> {
    let fields = Array<String>()
    fields.push("id"); fields.push("kind"); fields.push("path")
    fields.push("revision"); fields.push("license"); fields.push("bytes")
    fields.push("sha256"); fields.push("runtime_executable")
    fields.push("private_data")
    return fields
}

fun sampleFields() r: Array<String> {
    let fields = Array<String>()
    fields.push("id"); fields.push("source_id")
    fields.push("payload_kind"); fields.push("payload_sha256")
    fields.push("token_count"); fields.push("role")
    return fields
}

fun boundsFields() r: Array<String> {
    let fields = Array<String>()
    fields.push("source_count"); fields.push("sample_count")
    fields.push("aggregate_tokens"); fields.push("max_sample_tokens")
    fields.push("max_generated_bytes"); fields.push("workers")
    return fields
}

fun coverageFields() r: Array<String> {
    let fields = Array<String>()
    fields.push("natural_language"); fields.push("code")
    fields.push("arabic"); fields.push("multilingual")
    fields.push("long_document"); fields.push("long_context_retrieval")
    fields.push("thinking_enabled"); fields.push("thinking_disabled")
    fields.push("high_variance_activation_probe")
    fields.push("low_variance_activation_probe")
    return fields
}

