import env.env.{args}
import seen_qwen.cli.command.{QwenCliError, QWEN_CLI_HELP, QWEN_CLI_INSPECT,
    QWEN_CLI_CONVERT, QWEN_CLI_VERIFY, QWEN_CLI_VERSION,
    QWEN_EXIT_UNSUPPORTED, parseQwenCli, qwenCliHelp,
    renderQwenCliDiagnostic}
import seen_qwen.cli.inspect.{inspectQwenModel}
import seen_qwen.cli.convert_verify.{convertQwenModel, verifyQwenEngine}

extern "C" fun seen_string_release_owned(value: String) r: Void

fun qwenCliRequestsJson(arguments: Array<String>) r: Bool {
    var index = 0
    while index + 1 < arguments.length() {
        if arguments[index] == "--diagnostic-format" and
            arguments[index + 1] == "json" { return true }
        index = index + 1
    }
    return false
}

fun main() r: Int {
    let arguments = args()
    let parsed = parseQwenCli(arguments)
    if parsed.isErr() {
        let error = parsed.unwrapErr()
        let rendered = renderQwenCliDiagnostic(error,
            if qwenCliRequestsJson(arguments) { "json" } else { "human" })
        println(rendered)
        let code = error.exitCode
        seen_string_release_owned(rendered)
        error.free(); parsed.releaseContainer()
        arguments.free()
        return code
    }
    let invocation = parsed.unwrap()
    parsed.releaseContainer()
    if invocation.kind == QWEN_CLI_HELP {
        let help = qwenCliHelp()
        println(help)
        seen_string_release_owned(help)
        invocation.close(); invocation.free(); arguments.free()
        return 0
    }
    if invocation.kind == QWEN_CLI_VERSION {
        println("seen-qwen 0.15.0-dev")
        invocation.close(); invocation.free(); arguments.free()
        return 0
    }
    if invocation.kind == QWEN_CLI_INSPECT {
        let inspected = inspectQwenModel(invocation.modelLock,
            invocation.output, invocation.device)
        if inspected.isErr() {
            let inspectError = inspected.unwrapErr()
            let diagnostic = QwenCliError{ code: inspectError.code,
                field: inspectError.field, message: inspectError.message,
                exitCode: inspectError.exitCode }
            let rendered = renderQwenCliDiagnostic(diagnostic,
                invocation.diagnosticFormat)
            println(rendered)
            let code = inspectError.exitCode
            seen_string_release_owned(rendered)
            diagnostic.free(); inspectError.free(); inspected.releaseContainer()
            invocation.close(); invocation.free(); arguments.free()
            return code
        }
        let report = inspected.unwrap(); inspected.releaseContainer()
        println("seen-qwen: inspect: wrote verified source report")
        report.close(); report.free()
        invocation.close(); invocation.free(); arguments.free()
        return 0
    }
    if invocation.kind == QWEN_CLI_CONVERT {
        let converted = convertQwenModel(invocation.modelLock,
            invocation.outputRoot, invocation.quantProfile,
            invocation.quantizationConfig, invocation.calibrationLock,
            invocation.jobs, invocation.maxHostMemory, invocation.resume,
            invocation.verifyOnly)
        if converted.isErr() {
            let commandError = converted.unwrapErr()
            let diagnostic = QwenCliError{ code: commandError.code,
                field: commandError.field, message: commandError.message,
                exitCode: commandError.exitCode }
            let rendered = renderQwenCliDiagnostic(diagnostic,
                invocation.diagnosticFormat)
            println(rendered)
            let code = commandError.exitCode
            seen_string_release_owned(rendered)
            diagnostic.free(); commandError.free(); converted.releaseContainer()
            invocation.close(); invocation.free(); arguments.free()
            return code
        }
        converted.releaseContainer()
        println("seen-qwen: convert: source and artifact contract passed")
        invocation.close(); invocation.free(); arguments.free()
        return 0
    }
    if invocation.kind == QWEN_CLI_VERIFY {
        let verified = verifyQwenEngine(invocation.engine, invocation.suite,
            invocation.output)
        if verified.isErr() {
            let commandError = verified.unwrapErr()
            let diagnostic = QwenCliError{ code: commandError.code,
                field: commandError.field, message: commandError.message,
                exitCode: commandError.exitCode }
            let rendered = renderQwenCliDiagnostic(diagnostic,
                invocation.diagnosticFormat)
            println(rendered)
            let code = commandError.exitCode
            seen_string_release_owned(rendered)
            diagnostic.free(); commandError.free(); verified.releaseContainer()
            invocation.close(); invocation.free(); arguments.free()
            return code
        }
        verified.releaseContainer()
        println("seen-qwen: verify: artifact smoke suite passed")
        invocation.close(); invocation.free(); arguments.free()
        return 0
    }
    let command = invocation.command
    let error = "seen-qwen: qwen.cli.command-not-installed: command: " +
        command + " is parsed but its implementation leaf is not installed"
    println(error)
    seen_string_release_owned(error)
    invocation.close(); invocation.free(); arguments.free()
    return QWEN_EXIT_UNSUPPORTED
}

main()
