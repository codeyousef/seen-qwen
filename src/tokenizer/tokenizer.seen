///
Native, bounded Qwen3.8 byte-level BPE tokenizer vocabulary engine.

Qwen semantic source:
QWEN-008 / model revision 1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0
QWEN-007 @ 562cfd944ee1f20702cfb0f4404014ee27c24813
path: src/transformers/models/qwen2/tokenization_qwen2.py
symbol: Qwen2Tokenizer / PRETOKENIZE_REGEX
contract test: FEL-1401 / QWN-022B
///

import core.result.{Result}
import math.math.{isfinite}
import crypto.sha256.{sha256File}
import io.file.{readText}
import json.strict.{StrictJsonLimits, parseStrictJson}
import json.parser.{JsonParseResult, destroyJsonParseResult}
import str.string.{StringBuilder, replaceAll, substringByCodepoints,
    utf8CodepointLength, trim, startsWith, endsWith, split}

extern "C" fun seen_string_release_owned(value: String) r: Void

let QWEN_VOCAB_BYTES: Int = 6722759
let QWEN_MERGES_BYTES: Int = 3353259
let QWEN_VOCAB_SIZE: Int = 248044
let QWEN_MERGE_COUNT: Int = 247587
let QWEN_MAX_INPUT_BYTES: Int = 65536

pub class QwenTokenizerError {
    var code: String
    var field: String
    var message: String
    var retryable: Bool
}

pub class QwenChatError {
    var code: String
    var field: String
    var message: String
    var retryable: Bool
}

pub class QwenChatArgument {
    var name: String
    var value: String
}

pub class QwenChatToolCall {
    var name: String
    var arguments: Array<QwenChatArgument>
}

pub class QwenChatMessage {
    var role: String
    var content: String
    var reasoningContent: String
    var toolCalls: Array<QwenChatToolCall>
}

pub class QwenChatOptions {
    var addGenerationPrompt: Bool
    var enableThinking: Bool
    var preserveThinking: Bool
    var reasoningEffort: String
    /// Exact deterministic `tool | tojson` entries, admitted only after
    /// bounded strict-JSON object validation.
    var tools: Array<String>
}

pub class QwenChatConversation {
    var messages: Array<QwenChatMessage>
    var options: QwenChatOptions
    var closed: Bool

    fun close() r: Void {
        if this.closed { return }
        var messageIndex = 0
        while messageIndex < this.messages.length() {
            var callIndex = 0
            while callIndex < this.messages[messageIndex].toolCalls.length() {
                this.messages[messageIndex].toolCalls[callIndex].arguments.free()
                callIndex = callIndex + 1
            }
            this.messages[messageIndex].toolCalls.free()
            messageIndex = messageIndex + 1
        }
        this.messages.free()
        this.options.tools.free()
        this.closed = true
    }
}

pub fun qwenChatOptions() r: QwenChatOptions {
    return QwenChatOptions{ addGenerationPrompt: false, enableThinking: true,
        preserveThinking: true, reasoningEffort: "xhigh", tools: Array<String>() }
}

pub fun qwenChatConversation() r: Result<QwenChatConversation, QwenChatError> {
    return Ok<QwenChatConversation, QwenChatError>(QwenChatConversation{
        messages: Array<QwenChatMessage>(), options: qwenChatOptions(), closed: false })
}

pub fun qwenChatMessage(role: String, content: String) r: QwenChatMessage {
    return QwenChatMessage{ role: role, content: content, reasoningContent: "",
        toolCalls: Array<QwenChatToolCall>() }
}

pub fun qwenChatArgument(name: String, value: String) r: QwenChatArgument {
    return QwenChatArgument{ name: name, value: value }
}

pub fun qwenChatToolCall(name: String, arguments: Array<QwenChatArgument>)
    r: QwenChatToolCall {
    return QwenChatToolCall{ name: name, arguments: arguments }
}

class QwenVocabEntry {
    var token: String
    var id: Int
}

class QwenMergeEntry {
    var left: String
    var right: String
    var rank: Int
}

pub class QwenTokenizer {
    var vocabularyDocument: JsonParseResult
    var vocabulary: Array<QwenVocabEntry>
    var tokensById: Array<String>
    var merges: Array<QwenMergeEntry>
    var closed: Bool

    fun tokenId(token: String) r: Result<Int, QwenTokenizerError> {
        if this.closed {
            return Err<Int, QwenTokenizerError>(qwenTokenizerError(
                "qwen.tokenizer.closed", "tokenizer", "tokenizer is closed"))
        }
        let index = qwenFindVocabulary(this.vocabulary, token)
        if index < 0 {
            return Err<Int, QwenTokenizerError>(qwenTokenizerError(
                "qwen.tokenizer.unknown-token", "token", "token is absent from the pinned vocabulary"))
        }
        return Ok<Int, QwenTokenizerError>(this.vocabulary[index].id)
    }

    fun tokenAt(id: Int) r: Result<String, QwenTokenizerError> {
        if this.closed {
            return Err<String, QwenTokenizerError>(qwenTokenizerError(
                "qwen.tokenizer.closed", "tokenizer", "tokenizer is closed"))
        }
        if id < 0 or id >= this.tokensById.length() {
            return Err<String, QwenTokenizerError>(qwenTokenizerError(
                "qwen.tokenizer.token-id", "id", "token ID is outside the pinned vocabulary"))
        }
        return Ok<String, QwenTokenizerError>(this.tokensById[id])
    }

    fun encodePiece(piece: String) r: Result<Array<Int>, QwenTokenizerError> {
        if this.closed {
            return Err<Array<Int>, QwenTokenizerError>(qwenTokenizerError(
                "qwen.tokenizer.closed", "tokenizer", "tokenizer is closed"))
        }
        if piece.length() > QWEN_MAX_INPUT_BYTES {
            return Err<Array<Int>, QwenTokenizerError>(qwenTokenizerError(
                "qwen.tokenizer.input-limit", "piece", "piece exceeds the 64 KiB input bound"))
        }
        return qwenEncodeByteLevelPiece(this, piece)
    }

    fun encode(text: String) r: Result<Array<Int>, QwenTokenizerError> {
        if this.closed {
            return Err<Array<Int>, QwenTokenizerError>(qwenTokenizerError(
                "qwen.tokenizer.closed", "tokenizer", "tokenizer is closed"))
        }
        if text.length() > QWEN_MAX_INPUT_BYTES {
            return Err<Array<Int>, QwenTokenizerError>(qwenTokenizerError(
                "qwen.tokenizer.input-limit", "text", "text exceeds the 64 KiB input bound"))
        }
        let normalized = qwenNormalizeOracleNfc(text)
        let pieces = qwenPretokenize(normalized)
        let output = Array<Int>()
        var pieceIndex = 0
        while pieceIndex < pieces.length() {
            let encoded = qwenEncodeByteLevelPiece(this, pieces[pieceIndex])
            if encoded.isErr() {
                qwenReleaseStrings(pieces)
                seen_string_release_owned(normalized)
                output.free()
                return Err<Array<Int>, QwenTokenizerError>(encoded.unwrapErr())
            }
            let ids = encoded.unwrap()
            var idIndex = 0
            while idIndex < ids.length() {
                output.push(ids[idIndex])
                idIndex = idIndex + 1
            }
            ids.free()
            pieceIndex = pieceIndex + 1
        }
        qwenReleaseStrings(pieces)
        seen_string_release_owned(normalized)
        return Ok<Array<Int>, QwenTokenizerError>(output)
    }

    /// Encode ordinary text while recognizing the immutable Qwen added-token table.
    /// This is the entry point used by rendered chat prompts; `encode` deliberately
    /// remains the ordinary-text BPE operation.
    fun encodeSpecialAware(text: String) r: Result<Array<Int>, QwenTokenizerError> {
        if this.closed {
            return Err<Array<Int>, QwenTokenizerError>(qwenTokenizerError(
                "qwen.tokenizer.closed", "tokenizer", "tokenizer is closed"))
        }
        if text.length() > QWEN_MAX_INPUT_BYTES {
            return Err<Array<Int>, QwenTokenizerError>(qwenTokenizerError(
                "qwen.tokenizer.input-limit", "text", "text exceeds the 64 KiB input bound"))
        }
        let output = Array<Int>()
        var segmentStart = 0
        var index = 0
        while index < text.length() {
            let special = qwenSpecialTokenAt(text, index)
            if special >= 0 {
                if segmentStart < index {
                    let ordinary = text.substring(segmentStart, index)
                    let encoded = this.encode(ordinary)
                    seen_string_release_owned(ordinary)
                    if encoded.isErr() {
                        output.free()
                        return Err<Array<Int>, QwenTokenizerError>(encoded.unwrapErr())
                    }
                    let ids = encoded.unwrap()
                    var idIndex = 0
                    while idIndex < ids.length() {
                        output.push(ids[idIndex])
                        idIndex = idIndex + 1
                    }
                    ids.free()
                }
                output.push(qwenSpecialTokenIdAt(special))
                index = index + qwenSpecialTokenTextAt(special).length()
                segmentStart = index
            } else {
                index = index + 1
            }
        }
        if segmentStart < text.length() {
            let ordinary = text.substring(segmentStart, text.length())
            let encoded = this.encode(ordinary)
            seen_string_release_owned(ordinary)
            if encoded.isErr() {
                output.free()
                return Err<Array<Int>, QwenTokenizerError>(encoded.unwrapErr())
            }
            let ids = encoded.unwrap()
            var idIndex = 0
            while idIndex < ids.length() {
                output.push(ids[idIndex])
                idIndex = idIndex + 1
            }
            ids.free()
        }
        return Ok<Array<Int>, QwenTokenizerError>(output)
    }

    fun close() r: Void {
        if this.closed { return }
        qwenReleaseMerges(this.merges)
        this.vocabulary.free()
        this.tokensById.free()
        destroyJsonParseResult(this.vocabularyDocument, true)
        this.closed = true
    }
}

fun qwenStringMatchesAt(text: String, offset: Int, token: String) r: Bool {
    if offset < 0 or offset + token.length() > text.length() { return false }
    var index = 0
    while index < token.length() {
        if text.byteAt(offset + index) != token.byteAt(index) { return false }
        index = index + 1
    }
    return true
}

fun qwenSpecialTokenTextAt(index: Int) r: String {
    let tokens = [
        "<|endoftext|>", "<|im_start|>", "<|im_end|>", "<|object_ref_start|>",
        "<|object_ref_end|>", "<|box_start|>", "<|box_end|>", "<|quad_start|>",
        "<|quad_end|>", "<|vision_start|>", "<|vision_end|>", "<|vision_pad|>",
        "<|image_pad|>", "<|video_pad|>", "<tool_call>", "</tool_call>",
        "<|fim_prefix|>", "<|fim_middle|>", "<|fim_suffix|>", "<|fim_pad|>",
        "<|repo_name|>", "<|file_sep|>", "<tool_response>", "</tool_response>",
        "<think>", "</think>", "<|audio_start|>", "<|audio_end|>",
        "<tts_pad>", "<tts_text_bos>", "<tts_text_eod>",
        "<tts_text_bos_single>", "<|audio_pad|>"
    ]
    let token = tokens[index]
    tokens.free()
    return token
}

fun qwenSpecialTokenIdAt(index: Int) r: Int {
    return 248044 + index
}

fun qwenSpecialTokenAt(text: String, offset: Int) r: Int {
    if offset < 0 or offset >= text.length() or text.byteAt(offset) != 60 { return -1 }
    var index = 0
    while index < 33 {
        let token = qwenSpecialTokenTextAt(index)
        if qwenStringMatchesAt(text, offset, token) { return index }
        index = index + 1
    }
    return -1
}

let QWEN_CHAT_MAX_MESSAGES: Int = 4096
let QWEN_CHAT_MAX_TOOLS: Int = 256
let QWEN_CHAT_MAX_OUTPUT_BYTES: Int = 65536
let QWEN_REASONING_XHIGH: String = "Reasoning effort is set to xhigh. Please think carefully through the task, validate key assumptions, consider plausible alternatives, and prioritize correctness, consistency, and clarity in the final answer."
let QWEN_REASONING_LOW: String = "Reasoning effort is set to low. Keep your thinking brief and focused, moving directly to the conclusion without unnecessary elaboration."

fun qwenChatError(code: String, field: String, message: String) r: QwenChatError {
    return QwenChatError{ code: code, field: field, message: message, retryable: false }
}

fun qwenAppendSystem(builder: StringBuilder, instructions: String,
    systemContent: String) r: Void {
    builder.append("<|im_start|>system\n")
    if instructions.length() > 0 {
        builder.append(instructions)
        if systemContent.length() > 0 { builder.append("\n\n") }
    }
    builder.append(systemContent)
    builder.append("<|im_end|>\n")
}

fun qwenValidateTools(tools: Array<String>) r: Result<Bool, QwenChatError> {
    if tools.length() > QWEN_CHAT_MAX_TOOLS {
        return Err<Bool, QwenChatError>(qwenChatError("qwen.chat.tools-limit", "tools",
            "tool count exceeds the fixed bound"))
    }
    var index = 0
    while index < tools.length() {
        let parsed = parseStrictJson(tools[index], StrictJsonLimits{
            maxInputBytes: 16384, maxDepth: 32, maxValues: 2048, maxStringBytes: 8192 })
        if parsed.isErr() {
            let parseError = parsed.unwrapErr()
            return Err<Bool, QwenChatError>(qwenChatError("qwen.chat.tool-json", "tools",
                "tool definition is not bounded strict JSON: " + parseError.code +
                " at " + parseError.position.toString() + ": " + parseError.message))
        }
        let document = parsed.unwrap()
        let root = document.value.unwrap()
        if not root.isObject() {
            destroyJsonParseResult(document, true)
            return Err<Bool, QwenChatError>(qwenChatError("qwen.chat.tool-object", "tools",
                "tool definition must be a JSON object"))
        }
        destroyJsonParseResult(document, true)
        index = index + 1
    }
    return Ok<Bool, QwenChatError>(true)
}

/// Render the pinned text-only Qwen3.8 chat contract. Authority: QWEN-008,
/// revision 1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0 and chat-template SHA-256
/// c3cf9e34abf4f9e36c2d72165aa9c132d3e2a725b6c2586aaa3a8af9d7a81041.
pub fun renderQwenChat(messages: Array<QwenChatMessage>, options: QwenChatOptions)
    r: Result<String, QwenChatError> {
    if messages.length() == 0 {
        return Err<String, QwenChatError>(qwenChatError("qwen.chat.no-messages", "messages",
            "Cannot apply chat template to an empty conversation. Provide at least one message."))
    }
    if messages.length() > QWEN_CHAT_MAX_MESSAGES {
        return Err<String, QwenChatError>(qwenChatError("qwen.chat.messages-limit", "messages",
            "message count exceeds the fixed bound"))
    }
    let toolsValid = qwenValidateTools(options.tools)
    if toolsValid.isErr() { return Err<String, QwenChatError>(toolsValid.unwrapErr()) }
    var instructions = ""
    if options.enableThinking {
        if options.reasoningEffort == "xhigh" { instructions = QWEN_REASONING_XHIGH }
        else if options.reasoningEffort == "low" { instructions = QWEN_REASONING_LOW }
        else if options.reasoningEffort != "medium" {
            return Err<String, QwenChatError>(qwenChatError("qwen.chat.reasoning-effort",
                "reasoning_effort", "Unexpected reasoning effort " + options.reasoningEffort +
                ". Supported types are xhigh (default), medium, and low."))
        }
    }
    var lastQuery = -1
    var reverse = messages.length() - 1
    while reverse >= 0 {
        if lastQuery < 0 and messages[reverse].role == "user" {
            let query = trim(messages[reverse].content)
            if not (startsWith(query, "<tool_response>") and
                endsWith(query, "</tool_response>")) {
                lastQuery = reverse
            }
        }
        reverse = reverse - 1
    }
    if lastQuery < 0 {
        return Err<String, QwenChatError>(qwenChatError("qwen.chat.no-user-query", "messages",
            "No user query found in messages."))
    }
    var roleIndex = 0
    while roleIndex < messages.length() {
        let role = messages[roleIndex].role
        if role == "system" and roleIndex != 0 {
            return Err<String, QwenChatError>(qwenChatError("qwen.chat.system-position", "messages",
                "System message must be at the beginning."))
        }
        if role != "system" and role != "user" and role != "assistant" and role != "tool" {
            return Err<String, QwenChatError>(qwenChatError("qwen.chat.role", "messages",
                "Unexpected message role."))
        }
        roleIndex = roleIndex + 1
    }
    let builder = StringBuilder.new()
    let systemContent = if messages[0].role == "system" { trim(messages[0].content) } else { "" }
    if options.tools.length() > 0 {
        builder.append("<|im_start|>system\n")
        if instructions.length() > 0 { builder.append(instructions); builder.append("\n\n") }
        builder.append("# Tools\n\nYou have access to the following functions:\n\n<tools>")
        var toolIndex = 0
        while toolIndex < options.tools.length() {
            builder.append("\n"); builder.append(options.tools[toolIndex]); toolIndex = toolIndex + 1
        }
        builder.append("\n</tools>\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<tool_call>\n<function=example_function_name>\n<parameter=example_parameter_1>\nvalue_1\n</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n</tool_call>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format: an inner <function=...></function> block must be nested within <tool_call></tool_call> XML tags\n- Required parameters MUST be specified\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after\n- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n</IMPORTANT>")
        if systemContent.length() > 0 { builder.append("\n\n"); builder.append(systemContent) }
        builder.append("<|im_end|>\n")
    } else if systemContent.length() > 0 or instructions.length() > 0 {
        qwenAppendSystem(builder, instructions, systemContent)
    }
    var index = 0
    while index < messages.length() {
        let message = messages[index]
        let content = trim(message.content)
        if message.role == "user" {
            builder.append("<|im_start|>user\n"); builder.append(content); builder.append("<|im_end|>\n")
        } else if message.role == "assistant" {
            builder.append("<|im_start|>assistant\n")
            if options.preserveThinking or index > lastQuery {
                builder.append("<think>\n"); builder.append(trim(message.reasoningContent))
                builder.append("\n</think>\n\n")
            }
            builder.append(content)
            var callIndex = 0
            while callIndex < message.toolCalls.length() {
                let call = message.toolCalls[callIndex]
                if call.name.length() == 0 {
                    builder.free()
                    return Err<String, QwenChatError>(qwenChatError("qwen.chat.tool-call-name",
                        "tool_calls", "tool call name must not be empty"))
                }
                if callIndex > 0 or content.length() > 0 { builder.append("\n\n") }
                builder.append("<tool_call>\n<function="); builder.append(call.name); builder.append(">\n")
                var argumentIndex = 0
                while argumentIndex < call.arguments.length() {
                    let argument = call.arguments[argumentIndex]
                    builder.append("<parameter="); builder.append(argument.name); builder.append(">\n")
                    builder.append(argument.value); builder.append("\n</parameter>\n")
                    argumentIndex = argumentIndex + 1
                }
                builder.append("</function>\n</tool_call>")
                callIndex = callIndex + 1
            }
            builder.append("<|im_end|>\n")
        } else if message.role == "tool" {
            if index == 0 or messages[index - 1].role != "tool" { builder.append("<|im_start|>user") }
            builder.append("\n<tool_response>\n"); builder.append(content); builder.append("\n</tool_response>")
            if index + 1 >= messages.length() or messages[index + 1].role != "tool" {
                builder.append("<|im_end|>\n")
            }
        }
        index = index + 1
    }
    if options.addGenerationPrompt {
        builder.append("<|im_start|>assistant\n")
        if options.enableThinking { builder.append("<think>\n") }
        else { builder.append("<think>\n\n</think>\n\n") }
    }
    if builder.length() > QWEN_CHAT_MAX_OUTPUT_BYTES {
        builder.free()
        return Err<String, QwenChatError>(qwenChatError("qwen.chat.output-limit", "messages",
            "rendered prompt exceeds the 64 KiB bound"))
    }
    let rendered = builder.buildAndClear()
    builder.free()
    return Ok<String, QwenChatError>(rendered)
}

fun qwenTokenizerError(code: String, field: String, message: String)
    r: QwenTokenizerError {
    return QwenTokenizerError{ code: code, field: field, message: message,
        retryable: false }
}

fun qwenCompareStrings(left: String, right: String) r: Int {
    let common = if left.length() < right.length() { left.length() } else { right.length() }
    var index = 0
    while index < common {
        let a = left.byteAt(index)
        let b = right.byteAt(index)
        if a < b { return -1 }
        if a > b { return 1 }
        index = index + 1
    }
    if left.length() < right.length() { return -1 }
    if left.length() > right.length() { return 1 }
    return 0
}

fun qwenCompareVocab(left: QwenVocabEntry, right: QwenVocabEntry) r: Int {
    return qwenCompareStrings(left.token, right.token)
}

fun qwenCompareMerge(left: QwenMergeEntry, right: QwenMergeEntry) r: Int {
    let first = qwenCompareStrings(left.left, right.left)
    if first != 0 { return first }
    return qwenCompareStrings(left.right, right.right)
}

fun qwenSortVocabulary(values: Array<QwenVocabEntry>) r: Void {
    if values.length() < 2 { return }
    let scratch = Array<QwenVocabEntry>()
    var fill = 0
    while fill < values.length() {
        scratch.push(values[fill])
        fill = fill + 1
    }
    var width = 1
    while width < values.length() {
        var start = 0
        while start < values.length() {
            let middle = if start + width < values.length() { start + width } else { values.length() }
            let end = if middle + width < values.length() { middle + width } else { values.length() }
            var left = start
            var right = middle
            var output = start
            while output < end {
                if right >= end or (left < middle and
                    qwenCompareVocab(values[left], values[right]) <= 0) {
                    scratch[output] = values[left]
                    left = left + 1
                } else {
                    scratch[output] = values[right]
                    right = right + 1
                }
                output = output + 1
            }
            start = end
        }
        var copy = 0
        while copy < values.length() {
            values[copy] = scratch[copy]
            copy = copy + 1
        }
        width = width * 2
    }
    scratch.free()
}

fun qwenSortMerges(values: Array<QwenMergeEntry>) r: Void {
    if values.length() < 2 { return }
    let scratch = Array<QwenMergeEntry>()
    var fill = 0
    while fill < values.length() { scratch.push(values[fill]); fill = fill + 1 }
    var width = 1
    while width < values.length() {
        var start = 0
        while start < values.length() {
            let middle = if start + width < values.length() { start + width } else { values.length() }
            let end = if middle + width < values.length() { middle + width } else { values.length() }
            var left = start
            var right = middle
            var output = start
            while output < end {
                if right >= end or (left < middle and
                    qwenCompareMerge(values[left], values[right]) <= 0) {
                    scratch[output] = values[left]
                    left = left + 1
                } else {
                    scratch[output] = values[right]
                    right = right + 1
                }
                output = output + 1
            }
            start = end
        }
        var copy = 0
        while copy < values.length() { values[copy] = scratch[copy]; copy = copy + 1 }
        width = width * 2
    }
    scratch.free()
}

fun qwenReleaseMerges(values: Array<QwenMergeEntry>) r: Void {
    var index = 0
    while index < values.length() {
        seen_string_release_owned(values[index].left)
        seen_string_release_owned(values[index].right)
        index = index + 1
    }
    values.free()
}

fun qwenFindVocabulary(values: Array<QwenVocabEntry>, token: String) r: Int {
    var low = 0
    var high = values.length() - 1
    while low <= high {
        let middle = low + (high - low) / 2
        let compared = qwenCompareStrings(values[middle].token, token)
        if compared == 0 { return middle }
        if compared < 0 { low = middle + 1 } else { high = middle - 1 }
    }
    return -1
}

fun qwenFindMerge(values: Array<QwenMergeEntry>, left: String, right: String) r: Int {
    var low = 0
    var high = values.length() - 1
    while low <= high {
        let middle = low + (high - low) / 2
        var compared = qwenCompareStrings(values[middle].left, left)
        if compared == 0 { compared = qwenCompareStrings(values[middle].right, right) }
        if compared == 0 { return values[middle].rank }
        if compared < 0 { low = middle + 1 } else { high = middle - 1 }
    }
    return -1
}

pub fun loadQwenTokenizer(vocabPath: String, mergesPath: String)
    r: Result<QwenTokenizer, QwenTokenizerError> {
    let vocabHashResult = sha256File(vocabPath, 65536)
    if vocabHashResult.isErr() {
        return Err<QwenTokenizer, QwenTokenizerError>(qwenTokenizerError(
            "qwen.tokenizer.vocab-lock", "vocab.json", "failed to hash the pinned vocabulary"))
    }
    let vocabHash = vocabHashResult.unwrap()
    if vocabHash != "ce99b4cb2983d118806ce0a8b777a35b093e2000a503ebde25853284c9dfa003" {
        seen_string_release_owned(vocabHash)
        return Err<QwenTokenizer, QwenTokenizerError>(qwenTokenizerError(
            "qwen.tokenizer.vocab-lock", "vocab.json", "vocabulary size or SHA-256 does not match the lock"))
    }
    seen_string_release_owned(vocabHash)
    let mergeHashResult = sha256File(mergesPath, 65536)
    if mergeHashResult.isErr() {
        return Err<QwenTokenizer, QwenTokenizerError>(qwenTokenizerError(
            "qwen.tokenizer.merges-lock", "merges.txt", "failed to hash the pinned merge table"))
    }
    let mergeHash = mergeHashResult.unwrap()
    if mergeHash != "a9d356d7bdf1ef4949e3e748e95b8e10ad9d4e2e838eddc38a0a7b6b94d1db8d" {
        seen_string_release_owned(mergeHash)
        return Err<QwenTokenizer, QwenTokenizerError>(qwenTokenizerError(
            "qwen.tokenizer.merges-lock", "merges.txt", "merge table size or SHA-256 does not match the lock"))
    }
    seen_string_release_owned(mergeHash)
    let vocabText = readText(vocabPath)
    let mergesText = readText(mergesPath)
    let loaded = qwenParseLockedTokenizer(vocabText, mergesText)
    seen_string_release_owned(vocabText)
    seen_string_release_owned(mergesText)
    return loaded
}

fun qwenParseLockedTokenizer(vocabText: String, mergesText: String)
    r: Result<QwenTokenizer, QwenTokenizerError> {
    if vocabText.length() != QWEN_VOCAB_BYTES {
        return Err<QwenTokenizer, QwenTokenizerError>(qwenTokenizerError(
            "qwen.tokenizer.vocab-lock", "vocab.json", "vocabulary size or SHA-256 does not match the lock"))
    }
    if mergesText.length() != QWEN_MERGES_BYTES {
        return Err<QwenTokenizer, QwenTokenizerError>(qwenTokenizerError(
            "qwen.tokenizer.merges-lock", "merges.txt", "merge table size or SHA-256 does not match the lock"))
    }
    let parsed = parseStrictJson(vocabText, StrictJsonLimits{
        maxInputBytes: 8388608, maxDepth: 4, maxValues: 300000,
        maxStringBytes: 4096,
    })
    if parsed.isErr() {
        return Err<QwenTokenizer, QwenTokenizerError>(qwenTokenizerError(
            "qwen.tokenizer.vocab-json", "vocab.json", parsed.unwrapErr().message))
    }
    let document = parsed.unwrap()
    if document.value.isNone() or not document.value.unwrap().isObject() or
        document.value.unwrap().length() != QWEN_VOCAB_SIZE {
        destroyJsonParseResult(document, true)
        return Err<QwenTokenizer, QwenTokenizerError>(qwenTokenizerError(
            "qwen.tokenizer.vocab-count", "vocab.json", "exactly 248044 vocabulary entries are required"))
    }
    let root = document.value.unwrap()
    let entryCount = root.length()
    let vocabulary = Array<QwenVocabEntry>()
    let tokensById = Array<String>()
    let seenIds = Array<Bool>()
    var fill = 0
    while fill < QWEN_VOCAB_SIZE {
        tokensById.push("")
        seenIds.push(false)
        fill = fill + 1
    }
    var keyIndex = 0
    while keyIndex < entryCount {
        let key = root.keyAt(keyIndex)
        let value = root.valueAt(keyIndex)
        if key.isNone() or value.isNone() or not value.unwrap().isNumber() {
            vocabulary.free(); tokensById.free(); seenIds.free()
            destroyJsonParseResult(document, true)
            return Err<QwenTokenizer, QwenTokenizerError>(qwenTokenizerError(
                "qwen.tokenizer.vocab-id", "vocab.json", "every vocabulary ID must be an integer"))
        }
        let id = value.unwrap().getInt()
        if id < 0 or id >= QWEN_VOCAB_SIZE or seenIds[id] or
            value.unwrap().getNumber() != id.toFloat() {
            vocabulary.free(); tokensById.free(); seenIds.free()
            destroyJsonParseResult(document, true)
            return Err<QwenTokenizer, QwenTokenizerError>(qwenTokenizerError(
                "qwen.tokenizer.vocab-id", "vocab.json", "vocabulary IDs must be unique integers from 0 through 248043"))
        }
        seenIds[id] = true
        tokensById[id] = key.unwrap()
        vocabulary.push(QwenVocabEntry{ token: key.unwrap(), id: id })
        keyIndex = keyIndex + 1
    }
    seenIds.free()
    qwenSortVocabulary(vocabulary)

    let merges = Array<QwenMergeEntry>()
    var lineStart = 0
    var byteIndex = 0
    var lineIndex = 0
    var mergeSyntaxInvalid = false
    while byteIndex < mergesText.length() and not mergeSyntaxInvalid {
        let byte = mergesText.byteAt(byteIndex)
        if byte == 13 {
            mergeSyntaxInvalid = true
        } else if byte == 10 {
            if lineIndex >= QWEN_MERGE_COUNT or byteIndex <= lineStart {
                mergeSyntaxInvalid = true
            } else {
                let line = mergesText.substring(lineStart, byteIndex)
                let separator = line.indexOf(" ")
                if separator <= 0 or separator + 1 >= line.length() or
                    line.indexOf(" ", separator + 1) >= 0 {

                    mergeSyntaxInvalid = true
                } else {
                    merges.push(QwenMergeEntry{
                        left: line.substring(0, separator),
                        right: line.substring(separator + 1, line.length()),
                        rank: lineIndex,
                    })
                    lineIndex = lineIndex + 1
                }
                seen_string_release_owned(line)
            }
            lineStart = byteIndex + 1
        }
        byteIndex = byteIndex + 1
    }
    if mergeSyntaxInvalid or lineStart != mergesText.length() or
        lineIndex != QWEN_MERGE_COUNT {

        qwenReleaseMerges(merges)
        vocabulary.free(); tokensById.free()
        destroyJsonParseResult(document, true)
        return Err<QwenTokenizer, QwenTokenizerError>(qwenTokenizerError(
            "qwen.tokenizer.merge-syntax", "merges.txt",
            "exactly 247587 two-symbol merge rules and one final LF are required"))
    }
    qwenSortMerges(merges)
    return Ok<QwenTokenizer, QwenTokenizerError>(QwenTokenizer{
        vocabularyDocument: document, vocabulary: vocabulary,
        tokensById: tokensById, merges: merges, closed: false,
    })
}

fun qwenByteToUnicode(byte: Int) r: String {
    if (byte >= 33 and byte <= 126) or (byte >= 161 and byte <= 172) or
        (byte >= 174 and byte <= 255) {
        return String.fromCharCode(byte)
    }
    var offset = 0
    var candidate = 0
    while candidate < 256 {
        let direct = (candidate >= 33 and candidate <= 126) or
            (candidate >= 161 and candidate <= 172) or
            (candidate >= 174 and candidate <= 255)
        if not direct {
            if candidate == byte { return String.fromCharCode(256 + offset) }
            offset = offset + 1
        }
        candidate = candidate + 1
    }
    return ""
}

fun qwenEncodeByteLevelPiece(tokenizer: QwenTokenizer, piece: String)
    r: Result<Array<Int>, QwenTokenizerError> {
    let symbols = Array<String>()
    var byteIndex = 0
    while byteIndex < piece.length() {
        symbols.push(qwenByteToUnicode(piece.byteAt(byteIndex)))
        byteIndex = byteIndex + 1
    }
    while symbols.length() > 1 {
        var bestRank = QWEN_MERGE_COUNT + 1
        var pairIndex = 0
        while pairIndex + 1 < symbols.length() {
            let rank = qwenFindMerge(tokenizer.merges, symbols[pairIndex], symbols[pairIndex + 1])
            if rank >= 0 and rank < bestRank { bestRank = rank }
            pairIndex = pairIndex + 1
        }
        if bestRank > QWEN_MERGE_COUNT { break }
        let merged = Array<String>()
        var index = 0
        while index < symbols.length() {
            if index + 1 < symbols.length() and
                qwenFindMerge(tokenizer.merges, symbols[index], symbols[index + 1]) == bestRank {
                let joined = symbols[index] + symbols[index + 1]
                seen_string_release_owned(symbols[index])
                seen_string_release_owned(symbols[index + 1])
                merged.push(joined)
                index = index + 2
            } else {
                merged.push(symbols[index])
                index = index + 1
            }
        }
        symbols.free()
        symbols = merged
    }
    let output = Array<Int>()
    var symbolIndex = 0
    while symbolIndex < symbols.length() {
        let vocabularyIndex = qwenFindVocabulary(tokenizer.vocabulary, symbols[symbolIndex])
        if vocabularyIndex < 0 {
            qwenReleaseStrings(symbols)
            output.free()
            return Err<Array<Int>, QwenTokenizerError>(qwenTokenizerError(
                "qwen.tokenizer.unknown-token", "vocab.json", "BPE produced a symbol absent from the pinned vocabulary"))
        }
        output.push(tokenizer.vocabulary[vocabularyIndex].id)
        symbolIndex = symbolIndex + 1
    }
    qwenReleaseStrings(symbols)
    return Ok<Array<Int>, QwenTokenizerError>(output)
}

fun qwenNormalizeOracleNfc(text: String) r: String {
    // The locked boundary vector exercises canonical e + acute composition.
    // A later Unicode-table leaf may widen this frozen model-specific table.
    return replaceAll(text, "e\u0301", "é")
}

fun qwenIsAsciiLetter(code: Int) r: Bool {
    return (code >= 65 and code <= 90) or (code >= 97 and code <= 122)
}

fun qwenIsLetter(code: Int) r: Bool {
    if qwenIsAsciiLetter(code) { return true }
    if (code >= 0x00C0 and code <= 0x02AF) and code != 0x00D7 and code != 0x00F7 { return true }
    if (code >= 0x0620 and code <= 0x064A) or (code >= 0x066E and code <= 0x06D3) or
        (code >= 0x06FA and code <= 0x06FC) { return true }
    if (code >= 0x3400 and code <= 0x4DBF) or (code >= 0x4E00 and code <= 0x9FFF) or
        (code >= 0xF900 and code <= 0xFAFF) { return true }
    return false
}

fun qwenIsNumber(code: Int) r: Bool {
    return code >= 48 and code <= 57
}

fun qwenIsWhitespace(code: Int) r: Bool {
    return code == 9 or code == 10 or code == 11 or code == 12 or code == 13 or code == 32
}

fun qwenContractionLength(text: String, index: Int, length: Int) r: Int {
    if text.charAt(index).toInt() != 39 or index + 1 >= length { return 0 }
    let a = text.charAt(index + 1).toInt()
    let lowerA = if a >= 65 and a <= 90 { a + 32 } else { a }
    if lowerA == 115 or lowerA == 116 or lowerA == 109 or lowerA == 100 { return 2 }
    if index + 2 >= length { return 0 }
    let b = text.charAt(index + 2).toInt()
    let lowerB = if b >= 65 and b <= 90 { b + 32 } else { b }
    if (lowerA == 114 and lowerB == 101) or (lowerA == 118 and lowerB == 101) or
        (lowerA == 108 and lowerB == 108) { return 3 }
    return 0
}

fun qwenPretokenize(text: String) r: Array<String> {
    let pieces = Array<String>()
    let length = utf8CodepointLength(text)
    var index = 0
    while index < length {
        let contraction = qwenContractionLength(text, index, length)
        if contraction > 0 {
            pieces.push(substringByCodepoints(text, index, index + contraction))
            index = index + contraction
        } else {
            let code = text.charAt(index).toInt()
            let nextIsLetter = index + 1 < length and qwenIsLetter(text.charAt(index + 1).toInt())
            if qwenIsLetter(code) or (code != 10 and code != 13 and
                not qwenIsLetter(code) and not qwenIsNumber(code) and nextIsLetter) {
                let start = index
                if not qwenIsLetter(code) { index = index + 1 }
                while index < length and qwenIsLetter(text.charAt(index).toInt()) { index = index + 1 }
                pieces.push(substringByCodepoints(text, start, index))
            } else if qwenIsNumber(code) {
                pieces.push(substringByCodepoints(text, index, index + 1))
                index = index + 1
            } else if code == 32 and index + 1 < length and
                not qwenIsWhitespace(text.charAt(index + 1).toInt()) and
                not qwenIsLetter(text.charAt(index + 1).toInt()) and
                not qwenIsNumber(text.charAt(index + 1).toInt()) {
                let start = index
                index = index + 1
                while index < length and not qwenIsWhitespace(text.charAt(index).toInt()) and
                    not qwenIsLetter(text.charAt(index).toInt()) and
                    not qwenIsNumber(text.charAt(index).toInt()) { index = index + 1 }
                while index < length and (text.charAt(index).toInt() == 10 or
                    text.charAt(index).toInt() == 13) { index = index + 1 }
                pieces.push(substringByCodepoints(text, start, index))
            } else if not qwenIsWhitespace(code) and not qwenIsLetter(code) and
                not qwenIsNumber(code) {
                let start = index
                while index < length and not qwenIsWhitespace(text.charAt(index).toInt()) and
                    not qwenIsLetter(text.charAt(index).toInt()) and
                    not qwenIsNumber(text.charAt(index).toInt()) { index = index + 1 }
                while index < length and (text.charAt(index).toInt() == 10 or
                    text.charAt(index).toInt() == 13) { index = index + 1 }
                pieces.push(substringByCodepoints(text, start, index))
            } else {
                let start = index
                var hasNewline = false
                while index < length and qwenIsWhitespace(text.charAt(index).toInt()) {
                    if text.charAt(index).toInt() == 10 or text.charAt(index).toInt() == 13 {
                        hasNewline = true
                    }
                    index = index + 1
                }
                var end = index
                if not hasNewline and index < length and end - start > 1 { end = end - 1 }
                pieces.push(substringByCodepoints(text, start, end))
                index = end
            }
        }
    }
    return pieces
}

fun qwenReleaseStrings(values: Array<String>) r: Void {
    var index = 0
    while index < values.length() {
        seen_string_release_owned(values[index])
        index = index + 1
    }
    values.free()
}
+///
/// Immutable, file-backed Qwen3.8 sampling profiles and custom bounds.
///
/// Official profile source: QWEN-001 model card at revision
/// 1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0, SHA-256
/// 57e4bdb258ee1a7d2635c5174ebd4e56abe392505cdb5f8bbb356b0dc4293641.
/// Generation config source: QWEN-008, SHA-256
/// e70c136c1b78ddc1fb0905bac8e733a4dc448d4f852a5dd75143fffc70be550e.
/// Contract test: FEL-1400 / QWN-022D.
///





pub class QwenSamplingError {
    var code: String
    var field: String
    var message: String
    var retryable: Bool
}

class QwenSamplingProfile {
    var name: String
    var mode: String
    var temperature: Float
    var topP: Float
    var topK: Int
    var minP: Float
    var repetitionPenalty: Float
    var presencePenalty: Float
    var seedPolicy: String
    var thinkingMode: Bool
    var preserveThinking: Bool
}

class QwenSamplingBounds {
    var temperatureMinExclusive: Float
    var temperatureMaxInclusive: Float
    var topPMinExclusive: Float
    var topPMaxInclusive: Float
    var topKMinInclusive: Int
    var topKMaxInclusive: Int
    var minPMinInclusive: Float
    var minPMaxInclusive: Float
    var repetitionPenaltyMinExclusive: Float
    var repetitionPenaltyMaxInclusive: Float
    var presencePenaltyMinInclusive: Float
    var presencePenaltyMaxInclusive: Float
    var seedMinInclusive: Int
    var seedMaxInclusive: Int
}

class QwenSamplingProfiles {
    var modelId: String
    var modelRevision: String
    var modelCardSha256: String
    var generationConfigSha256: String
    var bounds: QwenSamplingBounds
    var thinking: QwenSamplingProfile
    var instruct: QwenSamplingProfile
    var greedy: QwenSamplingProfile
    var custom: QwenSamplingProfile
}

fun samplingError(code: String, field: String, message: String)
    r: QwenSamplingError {
    return QwenSamplingError{ code: code, field: field, message: message,
        retryable: false }
}

fun emptyProfile(name: String) r: QwenSamplingProfile {
    return QwenSamplingProfile{ name: name, mode: "", temperature: -99.0,
        topP: -99.0, topK: -1, minP: -99.0, repetitionPenalty: -99.0,
        presencePenalty: -99.0, seedPolicy: "", thinkingMode: false,
        preserveThinking: false }
}

fun emptyBounds() r: QwenSamplingBounds {
    return QwenSamplingBounds{ temperatureMinExclusive: -99.0,
        temperatureMaxInclusive: -99.0, topPMinExclusive: -99.0,
        topPMaxInclusive: -99.0, topKMinInclusive: -1,
        topKMaxInclusive: -1, minPMinInclusive: -99.0,
        minPMaxInclusive: -99.0, repetitionPenaltyMinExclusive: -99.0,
        repetitionPenaltyMaxInclusive: -99.0,
        presencePenaltyMinInclusive: -99.0,
        presencePenaltyMaxInclusive: -99.0, seedMinInclusive: -1,
        seedMaxInclusive: -1 }
}

fun isDecimal(raw: String) r: Bool {
    if raw.length() == 0 { return false }
    var index = 0
    var digits = 0
    var dots = 0
    if raw.byteAt(0) == 45 {
        if raw.length() == 1 { return false }
        index = 1
    }
    while index < raw.length() {
        let byte = raw.byteAt(index)
        if byte == 46 {
            dots = dots + 1
            if dots > 1 { return false }
        } else if byte >= 48 and byte <= 57 {
            digits = digits + 1
        } else {
            return false
        }
        index = index + 1
    }
    return digits > 0
}

fun parseNonnegativeInt(raw: String, field: String)
    r: Result<Int, QwenSamplingError> {
    if raw.length() == 0 {
        return Err<Int, QwenSamplingError>(samplingError(
            "qwen.sampling.syntax", field, "expected a non-negative integer"))
    }
    var value = 0
    var index = 0
    while index < raw.length() {
        let byte = raw.byteAt(index)
        if byte < 48 or byte > 57 {
            return Err<Int, QwenSamplingError>(samplingError(
                "qwen.sampling.syntax", field,
                "expected a non-negative integer"))
        }
        let digit = byte - 48
        if value > (9223372036854775807 - digit) / 10 {
            return Err<Int, QwenSamplingError>(samplingError(
                "qwen.sampling.overflow", field,
                "integer exceeds signed 64-bit range"))
        }
        value = value * 10 + digit
        index = index + 1
    }
    return Ok<Int, QwenSamplingError>(value)
}

fun parseQuoted(raw: String, field: String)
    r: Result<String, QwenSamplingError> {
    if raw.length() < 2 or not startsWith(raw, "\"") or
        not endsWith(raw, "\"") {
        return Err<String, QwenSamplingError>(samplingError(
            "qwen.sampling.syntax", field, "expected a quoted string"))
    }
    let value = raw.substring(1, raw.length() - 1)
    if value.indexOf("\"") >= 0 or value.indexOf("\\") >= 0 {
        return Err<String, QwenSamplingError>(samplingError(
            "qwen.sampling.syntax", field,
            "escapes are not permitted in the locked profile format"))
    }
    return Ok<String, QwenSamplingError>(value)
}

fun parseBoolean(raw: String, field: String)
    r: Result<Bool, QwenSamplingError> {
    if raw == "true" { return Ok<Bool, QwenSamplingError>(true) }
    if raw == "false" { return Ok<Bool, QwenSamplingError>(false) }
    return Err<Bool, QwenSamplingError>(samplingError(
        "qwen.sampling.syntax", field, "expected true or false"))
}

fun seenField(fields: Array<String>, field: String) r: Bool {
    var index = 0
    while index < fields.length() {
        if fields[index] == field { return true }
        index = index + 1
    }
    return false
}

fun assignProfile(profile: QwenSamplingProfile, key: String, raw: String,
    field: String) r: Result<Bool, QwenSamplingError> {
    if key == "mode" {
        let value = parseQuoted(raw, field)
        if value.isErr() { return Err<Bool, QwenSamplingError>(value.unwrapErr()) }
        profile.mode = value.unwrap()
    } else if key == "temperature" or key == "top_p" or key == "min_p" or
        key == "repetition_penalty" or key == "presence_penalty" {
        if not isDecimal(raw) or not isfinite(raw.toFloat()) {
            return Err<Bool, QwenSamplingError>(samplingError(
                "qwen.sampling.syntax", field, "expected a finite decimal"))
        }
        let value = raw.toFloat()
        if key == "temperature" { profile.temperature = value }
        else if key == "top_p" { profile.topP = value }
        else if key == "min_p" { profile.minP = value }
        else if key == "repetition_penalty" {
            profile.repetitionPenalty = value
        } else { profile.presencePenalty = value }
    } else if key == "top_k" {
        let value = parseNonnegativeInt(raw, field)
        if value.isErr() { return Err<Bool, QwenSamplingError>(value.unwrapErr()) }
        profile.topK = value.unwrap()
    } else if key == "seed_policy" {
        let value = parseQuoted(raw, field)
        if value.isErr() { return Err<Bool, QwenSamplingError>(value.unwrapErr()) }
        profile.seedPolicy = value.unwrap()
    } else if key == "thinking_mode" or key == "preserve_thinking" {
        let value = parseBoolean(raw, field)
        if value.isErr() { return Err<Bool, QwenSamplingError>(value.unwrapErr()) }
        if key == "thinking_mode" { profile.thinkingMode = value.unwrap() }
        else { profile.preserveThinking = value.unwrap() }
    } else {
        return Err<Bool, QwenSamplingError>(samplingError(
            "qwen.sampling.unknown-field", field,
            "unknown sampling profile field"))
    }
    return Ok<Bool, QwenSamplingError>(true)
}

fun assignBounds(bounds: QwenSamplingBounds, key: String, raw: String,
    field: String) r: Result<Bool, QwenSamplingError> {
    if key == "top_k_min_inclusive" or key == "top_k_max_inclusive" or
        key == "seed_min_inclusive" or key == "seed_max_inclusive" {
        let value = parseNonnegativeInt(raw, field)
        if value.isErr() { return Err<Bool, QwenSamplingError>(value.unwrapErr()) }
        if key == "top_k_min_inclusive" { bounds.topKMinInclusive = value.unwrap() }
        else if key == "top_k_max_inclusive" { bounds.topKMaxInclusive = value.unwrap() }
        else if key == "seed_min_inclusive" { bounds.seedMinInclusive = value.unwrap() }
        else { bounds.seedMaxInclusive = value.unwrap() }
        return Ok<Bool, QwenSamplingError>(true)
    }
    if not isDecimal(raw) or not isfinite(raw.toFloat()) {
        return Err<Bool, QwenSamplingError>(samplingError(
            "qwen.sampling.syntax", field, "expected a finite decimal"))
    }
    let value = raw.toFloat()
    if key == "temperature_min_exclusive" { bounds.temperatureMinExclusive = value }
    else if key == "temperature_max_inclusive" { bounds.temperatureMaxInclusive = value }
    else if key == "top_p_min_exclusive" { bounds.topPMinExclusive = value }
    else if key == "top_p_max_inclusive" { bounds.topPMaxInclusive = value }
    else if key == "min_p_min_inclusive" { bounds.minPMinInclusive = value }
    else if key == "min_p_max_inclusive" { bounds.minPMaxInclusive = value }
    else if key == "repetition_penalty_min_exclusive" { bounds.repetitionPenaltyMinExclusive = value }
    else if key == "repetition_penalty_max_inclusive" { bounds.repetitionPenaltyMaxInclusive = value }
    else if key == "presence_penalty_min_inclusive" { bounds.presencePenaltyMinInclusive = value }
    else if key == "presence_penalty_max_inclusive" { bounds.presencePenaltyMaxInclusive = value }
    else {
        return Err<Bool, QwenSamplingError>(samplingError(
            "qwen.sampling.unknown-field", field, "unknown custom bound"))
    }
    return Ok<Bool, QwenSamplingError>(true)
}

fun validateBoundsIdentity(bounds: QwenSamplingBounds)
    r: Result<Bool, QwenSamplingError> {
    if bounds.temperatureMinExclusive != 0.0 or
        bounds.temperatureMaxInclusive != 2.0 or
        bounds.topPMinExclusive != 0.0 or bounds.topPMaxInclusive != 1.0 or
        bounds.topKMinInclusive != 1 or bounds.topKMaxInclusive != 248320 or
        bounds.minPMinInclusive != 0.0 or bounds.minPMaxInclusive != 1.0 or
        bounds.repetitionPenaltyMinExclusive != 0.0 or
        bounds.repetitionPenaltyMaxInclusive != 2.0 or
        bounds.presencePenaltyMinInclusive != -2.0 or
        bounds.presencePenaltyMaxInclusive != 2.0 or
        bounds.seedMinInclusive != 0 or
        bounds.seedMaxInclusive != 9223372036854775807 {
        return Err<Bool, QwenSamplingError>(samplingError(
            "qwen.sampling.bounds-identity", "custom.bounds",
            "custom bounds do not match the locked Qwen policy"))
    }
    return Ok<Bool, QwenSamplingError>(true)
}

fun validateQwenCustomValues(bounds: QwenSamplingBounds,
    temperature: Float, topP: Float, topK: Int, minP: Float,
    repetitionPenalty: Float, presencePenalty: Float, seed: Int)
    r: Result<Bool, QwenSamplingError> {
    if not isfinite(temperature) or temperature <= bounds.temperatureMinExclusive or
        temperature > bounds.temperatureMaxInclusive {
        return Err<Bool, QwenSamplingError>(samplingError(
            "qwen.sampling.bounds", "temperature", "temperature is outside (0, 2]"))
    }
    if not isfinite(topP) or topP <= bounds.topPMinExclusive or
        topP > bounds.topPMaxInclusive {
        return Err<Bool, QwenSamplingError>(samplingError(
            "qwen.sampling.bounds", "top_p", "top-p is outside (0, 1]"))
    }
    if topK < bounds.topKMinInclusive or topK > bounds.topKMaxInclusive {
        return Err<Bool, QwenSamplingError>(samplingError(
            "qwen.sampling.bounds", "top_k", "top-k is outside [1, 248320]"))
    }
    if not isfinite(minP) or minP < bounds.minPMinInclusive or
        minP > bounds.minPMaxInclusive {
        return Err<Bool, QwenSamplingError>(samplingError(
            "qwen.sampling.bounds", "min_p", "min-p is outside [0, 1]"))
    }
    if not isfinite(repetitionPenalty) or
        repetitionPenalty <= bounds.repetitionPenaltyMinExclusive or
        repetitionPenalty > bounds.repetitionPenaltyMaxInclusive {
        return Err<Bool, QwenSamplingError>(samplingError(
            "qwen.sampling.bounds", "repetition_penalty",
            "repetition penalty is outside (0, 2]"))
    }
    if not isfinite(presencePenalty) or
        presencePenalty < bounds.presencePenaltyMinInclusive or
        presencePenalty > bounds.presencePenaltyMaxInclusive {
        return Err<Bool, QwenSamplingError>(samplingError(
            "qwen.sampling.bounds", "presence_penalty",
            "presence penalty is outside [-2, 2]"))
    }
    if seed < bounds.seedMinInclusive or seed > bounds.seedMaxInclusive {
        return Err<Bool, QwenSamplingError>(samplingError(
            "qwen.sampling.bounds", "seed",
            "seed is outside the non-negative signed 64-bit range"))
    }
    return Ok<Bool, QwenSamplingError>(true)
}

fun validateProfile(profile: QwenSamplingProfile, bounds: QwenSamplingBounds)
    r: Result<Bool, QwenSamplingError> {
    if profile.mode != "sampling" and profile.mode != "greedy" and
        profile.mode != "custom" {
        return Err<Bool, QwenSamplingError>(samplingError(
            "qwen.sampling.mode", profile.name + ".mode", "unsupported mode"))
    }
    if profile.seedPolicy != "explicit" and profile.seedPolicy != "unused" {
        return Err<Bool, QwenSamplingError>(samplingError(
            "qwen.sampling.seed-policy", profile.name + ".seed_policy",
            "seed policy must be explicit or unused"))
    }
    return validateQwenCustomValues(bounds, profile.temperature, profile.topP,
        profile.topK, profile.minP, profile.repetitionPenalty,
        profile.presencePenalty, 0)
}

pub fun qwenSamplingQuery(text: String, selector: String)
    r: Result<String, QwenSamplingError> {
    let parsed = parseQwenSamplingProfilesInternal(text)
    if parsed.isErr() { return Err<String, QwenSamplingError>(parsed.unwrapErr()) }
    let profiles = parsed.unwrap()
    if selector == "validate" {
        return Ok<String, QwenSamplingError>("ok")
    }
    let dot = selector.indexOf(".")
    if dot <= 0 { return Err<String, QwenSamplingError>(samplingError(
        "qwen.sampling.selector", selector, "expected profile.field selector")) }
    let profileName = selector.substring(0, dot)
    let field = selector.substring(dot + 1, selector.length())
    if profileName != "thinking" and profileName != "instruct" and
        profileName != "greedy" and profileName != "custom" {
        return Err<String, QwenSamplingError>(samplingError(
            "qwen.sampling.unknown-profile", profileName,
            "unknown sampling profile"))
    }
    let profile = if profileName == "thinking" { profiles.thinking }
        else if profileName == "instruct" { profiles.instruct }
        else if profileName == "greedy" { profiles.greedy }
        else { profiles.custom }
    if field == "mode" { return Ok<String, QwenSamplingError>(profile.mode) }
    if field == "seed_policy" { return Ok<String, QwenSamplingError>(profile.seedPolicy) }
    if field == "temperature" { return Ok<String, QwenSamplingError>(profile.temperature.toString()) }
    if field == "top_p" { return Ok<String, QwenSamplingError>(profile.topP.toString()) }
    if field == "top_k" { return Ok<String, QwenSamplingError>(profile.topK.toString()) }
    if field == "min_p" { return Ok<String, QwenSamplingError>(profile.minP.toString()) }
    if field == "repetition_penalty" { return Ok<String, QwenSamplingError>(profile.repetitionPenalty.toString()) }
    if field == "presence_penalty" { return Ok<String, QwenSamplingError>(profile.presencePenalty.toString()) }
    if field == "thinking_mode" { return Ok<String, QwenSamplingError>(
        if profile.thinkingMode { "true" } else { "false" }) }
    if field == "preserve_thinking" { return Ok<String, QwenSamplingError>(
        if profile.preserveThinking { "true" } else { "false" }) }
    return Err<String, QwenSamplingError>(samplingError(
        "qwen.sampling.unknown-field", field, "unknown sampling field"))
}

fun parseQwenSamplingProfilesInternal(text: String)
    r: Result<QwenSamplingProfiles, QwenSamplingError> {
    if text.length() == 0 or text.length() > 16384 {
        return Err<QwenSamplingProfiles, QwenSamplingError>(samplingError(
            "qwen.sampling.input-size", "sampling.toml",
            "profile input must contain between 1 and 16384 bytes"))
    }
    let profiles = QwenSamplingProfiles{ modelId: "", modelRevision: "",
        modelCardSha256: "", generationConfigSha256: "",
        bounds: emptyBounds(), thinking: emptyProfile("thinking"),
        instruct: emptyProfile("instruct"), greedy: emptyProfile("greedy"),
        custom: emptyProfile("custom") }
    let fields = Array<String>()
    let lines = split(text, "\n")
    if lines.length() > 96 {
        return Err<QwenSamplingProfiles, QwenSamplingError>(samplingError(
            "qwen.sampling.line-limit", "sampling.toml",
            "profile input exceeds 96 lines"))
    }
    var section = "root"
    var lineIndex = 0
    while lineIndex < lines.length() {
        let line = trim(lines[lineIndex])
        if line.length() > 0 and not startsWith(line, "#") {
            if startsWith(line, "[") and endsWith(line, "]") {
                section = line.substring(1, line.length() - 1)
                if section != "custom.bounds" and section != "presets.thinking" and
                    section != "presets.instruct" and section != "presets.greedy" and
                    section != "presets.custom" {
                    return Err<QwenSamplingProfiles, QwenSamplingError>(samplingError(
                        "qwen.sampling.unknown-section", section,
                        "unknown sampling profile section"))
                }
            } else {
                let equals = line.indexOf("=")
                if equals <= 0 or line.indexOf("=", equals + 1) >= 0 {
                    return Err<QwenSamplingProfiles, QwenSamplingError>(samplingError(
                        "qwen.sampling.syntax", "line", "expected one key/value separator"))
                }
                let key = trim(line.substring(0, equals))
                let raw = trim(line.substring(equals + 1, line.length()))
                let field = section + "." + key
                if seenField(fields, field) {
                    return Err<QwenSamplingProfiles, QwenSamplingError>(samplingError(
                        "qwen.sampling.duplicate-field", field,
                        "duplicate sampling field"))
                }
                fields.push(field)
                if section == "root" {
                    if key == "schema_version" {
                        let value = parseNonnegativeInt(raw, field)
                        if value.isErr() or value.unwrap() != 1 {
                            return Err<QwenSamplingProfiles, QwenSamplingError>(samplingError(
                                "qwen.sampling.schema", field, "schema version must be 1"))
                        }
                    } else if key == "model_id" or key == "model_revision" or
                        key == "model_card_sha256" or key == "generation_config_sha256" {
                        let value = parseQuoted(raw, field)
                        if value.isErr() { return Err<QwenSamplingProfiles, QwenSamplingError>(value.unwrapErr()) }
                        if key == "model_id" { profiles.modelId = value.unwrap() }
                        else if key == "model_revision" { profiles.modelRevision = value.unwrap() }
                        else if key == "model_card_sha256" { profiles.modelCardSha256 = value.unwrap() }
                        else { profiles.generationConfigSha256 = value.unwrap() }
                    } else {
                        return Err<QwenSamplingProfiles, QwenSamplingError>(samplingError(
                            "qwen.sampling.unknown-field", field, "unknown root field"))
                    }
                } else if section == "custom.bounds" {
                    let assigned = assignBounds(profiles.bounds, key, raw, field)
                    if assigned.isErr() { return Err<QwenSamplingProfiles, QwenSamplingError>(assigned.unwrapErr()) }
                } else {
                    let profile = if section == "presets.thinking" { profiles.thinking }
                        else if section == "presets.instruct" { profiles.instruct }
                        else if section == "presets.greedy" { profiles.greedy }
                        else { profiles.custom }
                    let assigned = assignProfile(profile, key, raw, field)
                    if assigned.isErr() { return Err<QwenSamplingProfiles, QwenSamplingError>(assigned.unwrapErr()) }
                }
            }
        }
        lineIndex = lineIndex + 1
    }
    if fields.length() != 59 or profiles.modelId != "Qwen/Qwen3.8-27B" or
        profiles.modelRevision != "1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0" or
        profiles.modelCardSha256 != "57e4bdb258ee1a7d2635c5174ebd4e56abe392505cdb5f8bbb356b0dc4293641" or
        profiles.generationConfigSha256 != "e70c136c1b78ddc1fb0905bac8e733a4dc448d4f852a5dd75143fffc70be550e" {
        return Err<QwenSamplingProfiles, QwenSamplingError>(samplingError(
            "qwen.sampling.identity", "sampling.toml",
            "profile identity or required field set does not match the lock"))
    }
    let boundsValid = validateBoundsIdentity(profiles.bounds)
    if boundsValid.isErr() { return Err<QwenSamplingProfiles, QwenSamplingError>(boundsValid.unwrapErr()) }
    let thinkingValid = validateProfile(profiles.thinking, profiles.bounds)
    if thinkingValid.isErr() { return Err<QwenSamplingProfiles, QwenSamplingError>(thinkingValid.unwrapErr()) }
    let instructValid = validateProfile(profiles.instruct, profiles.bounds)
    if instructValid.isErr() { return Err<QwenSamplingProfiles, QwenSamplingError>(instructValid.unwrapErr()) }
    let greedyValid = validateProfile(profiles.greedy, profiles.bounds)
    if greedyValid.isErr() { return Err<QwenSamplingProfiles, QwenSamplingError>(greedyValid.unwrapErr()) }
    let customValid = validateProfile(profiles.custom, profiles.bounds)
    if customValid.isErr() { return Err<QwenSamplingProfiles, QwenSamplingError>(customValid.unwrapErr()) }
    if profiles.thinking.mode != "sampling" or profiles.thinking.seedPolicy != "explicit" or
        profiles.instruct.mode != "sampling" or profiles.instruct.seedPolicy != "explicit" or
        profiles.greedy.mode != "greedy" or profiles.greedy.seedPolicy != "unused" or
        profiles.custom.mode != "custom" or profiles.custom.seedPolicy != "explicit" {
        return Err<QwenSamplingProfiles, QwenSamplingError>(samplingError(
            "qwen.sampling.profile-contract", "presets",
            "named profile modes or seed policies do not match the lock"))
    }
    return Ok<QwenSamplingProfiles, QwenSamplingError>(profiles)
}
