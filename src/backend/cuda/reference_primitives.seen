/// QWN-040A fixed-width boundary for separately built reference kernels.
/// A token is borrowed from a live Seen-owned CudaStream and may be passed to
/// exactly one launch function. These declarations never retain or own it.

import accelerator.cuda.mod.{CudaStreamLaunchToken}
import accelerator.cuda.error.{CudaNativeStatus}

let QWEN_CUDA_REFERENCE_ABI_VERSION: UInt32 = 1 as UInt32

@repr(C)
@trivially_copyable
class QwenCudaBufferView {
    var abiVersion: UInt32
    var deviceOrdinal: Int32
    var address: UInt64
    var byteLength: UInt64
}

extern "C" fun seen_qwen_fill_f32(token: *const CudaStreamLaunchToken,
    output: QwenCudaBufferView, count: UInt64, value: Float32) r: CudaNativeStatus
extern "C" fun seen_qwen_add_f32(token: *const CudaStreamLaunchToken,
    left: QwenCudaBufferView, right: QwenCudaBufferView,
    output: QwenCudaBufferView, count: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_row_sum_f32(token: *const CudaStreamLaunchToken,
    input: QwenCudaBufferView, output: QwenCudaBufferView,
    rows: UInt64, columns: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_transpose_2d_f32(token: *const CudaStreamLaunchToken,
    input: QwenCudaBufferView, output: QwenCudaBufferView,
    rows: UInt64, columns: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_copy_f32(token: *const CudaStreamLaunchToken,
    input: QwenCudaBufferView, output: QwenCudaBufferView,
    count: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_embedding_gather_f32(
    token: *const CudaStreamLaunchToken, table: QwenCudaBufferView,
    tokenIds: QwenCudaBufferView, output: QwenCudaBufferView,
    tokenCount: UInt64, vocabularySize: UInt64, width: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_rms_norm_f32(token: *const CudaStreamLaunchToken,
    input: QwenCudaBufferView, weight: QwenCudaBufferView,
    output: QwenCudaBufferView, rows: UInt64, width: UInt64,
    epsilon: Float32) r: CudaNativeStatus
extern "C" fun seen_qwen_l2_norm_f32(token: *const CudaStreamLaunchToken,
    input: QwenCudaBufferView, output: QwenCudaBufferView,
    rows: UInt64, width: UInt64, epsilon: Float32) r: CudaNativeStatus
extern "C" fun seen_qwen_silu_f32(token: *const CudaStreamLaunchToken,
    input: QwenCudaBufferView, output: QwenCudaBufferView,
    count: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_swiglu_f32(token: *const CudaStreamLaunchToken,
    gate: QwenCudaBufferView, up: QwenCudaBufferView,
    output: QwenCudaBufferView, count: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_sigmoid_gate_f32(token: *const CudaStreamLaunchToken,
    input: QwenCudaBufferView, gate: QwenCudaBufferView,
    output: QwenCudaBufferView, count: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_partial_rope_f32(token: *const CudaStreamLaunchToken,
    input: QwenCudaBufferView, output: QwenCudaBufferView,
    tokens: UInt64, heads: UInt64, headDim: UInt64, rotaryDim: UInt64,
    positionOffset: UInt64, maxPosition: UInt64,
    theta: Float32) r: CudaNativeStatus
extern "C" fun seen_qwen_kv_append_f32(token: *const CudaStreamLaunchToken,
    keys: QwenCudaBufferView, values: QwenCudaBufferView,
    keyCache: QwenCudaBufferView, valueCache: QwenCudaBufferView,
    tokenCount: UInt64, kvHeads: UInt64, headDim: UInt64,
    startPosition: UInt64, capacity: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_greedy_argmax_f32(token: *const CudaStreamLaunchToken,
    logits: QwenCudaBufferView, tokenId: QwenCudaBufferView,
    rows: UInt64, width: UInt64, vocabularySize: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_top_k_f32(token: *const CudaStreamLaunchToken,
    logits: QwenCudaBufferView, tokenIds: QwenCudaBufferView,
    values: QwenCudaBufferView, rows: UInt64, width: UInt64,
    vocabularySize: UInt64, topK: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_causal_conv_silu_f32(
    token: *const CudaStreamLaunchToken, input: QwenCudaBufferView,
    weights: QwenCudaBufferView, history: QwenCudaBufferView,
    output: QwenCudaBufferView, tokenCount: UInt64, channels: UInt64,
    kernelLength: UInt64, startPosition: UInt64,
    processedPosition: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_gdn_recurrent_decode_f32(
    token: *const CudaStreamLaunchToken, query: QwenCudaBufferView,
    key: QwenCudaBufferView, value: QwenCudaBufferView,
    beta: QwenCudaBufferView, logDecay: QwenCudaBufferView,
    state: QwenCudaBufferView, output: QwenCudaBufferView,
    valueHeads: UInt64, keyDim: UInt64, valueDim: UInt64,
    startPosition: UInt64, processedPosition: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_gdn_recurrent_prefill_f32(
    token: *const CudaStreamLaunchToken, query: QwenCudaBufferView,
    key: QwenCudaBufferView, value: QwenCudaBufferView,
    beta: QwenCudaBufferView, logDecay: QwenCudaBufferView,
    state: QwenCudaBufferView, output: QwenCudaBufferView,
    tokenCount: UInt64, valueHeads: UInt64, keyDim: UInt64,
    valueDim: UInt64, startPosition: UInt64,
    processedPosition: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_gdn_gated_rms_norm_f32(
    token: *const CudaStreamLaunchToken, core: QwenCudaBufferView,
    gate: QwenCudaBufferView, weight: QwenCudaBufferView,
    output: QwenCudaBufferView, rows: UInt64, width: UInt64,
    epsilon: Float32) r: CudaNativeStatus
