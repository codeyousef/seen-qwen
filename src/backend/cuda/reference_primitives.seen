/// QWN-040A fixed-width boundary for separately built reference kernels.
/// A token is borrowed from a live Seen-owned CudaStream and may be passed to
/// exactly one launch function. These declarations never retain or own it.

import accelerator.cuda.mod.{CudaStreamLaunchToken}
import accelerator.cuda.error.{CudaNativeStatus}

let QWEN_CUDA_REFERENCE_ABI_VERSION: UInt32 = 1 as UInt32

@repr(C)
@trivially_copyable
class QwenCudaBufferView {
    var abiVersion: UInt32
    var deviceOrdinal: Int32
    var address: UInt64
    var byteLength: UInt64
}

extern "C" fun seen_qwen_fill_f32(token: *const CudaStreamLaunchToken,
    output: QwenCudaBufferView, count: UInt64, value: Float32) r: CudaNativeStatus
extern "C" fun seen_qwen_add_f32(token: *const CudaStreamLaunchToken,
    left: QwenCudaBufferView, right: QwenCudaBufferView,
    output: QwenCudaBufferView, count: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_row_sum_f32(token: *const CudaStreamLaunchToken,
    input: QwenCudaBufferView, output: QwenCudaBufferView,
    rows: UInt64, columns: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_transpose_2d_f32(token: *const CudaStreamLaunchToken,
    input: QwenCudaBufferView, output: QwenCudaBufferView,
    rows: UInt64, columns: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_copy_f32(token: *const CudaStreamLaunchToken,
    input: QwenCudaBufferView, output: QwenCudaBufferView,
    count: UInt64) r: CudaNativeStatus
extern "C" fun seen_qwen_embedding_gather_f32(
    token: *const CudaStreamLaunchToken, table: QwenCudaBufferView,
    tokenIds: QwenCudaBufferView, output: QwenCudaBufferView,
    tokenCount: UInt64, vocabularySize: UInt64, width: UInt64) r: CudaNativeStatus
