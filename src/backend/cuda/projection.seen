/// QWN-043A Qwen projection geometry mapped onto the packaged Seen cuBLASLt
/// ABI. Tensor storage remains token-major row-major; cuBLASLt observes the
/// same bytes as column-major transposes and computes Y^T = W * X^T.

import accelerator.cuda.mod.{CUDA_ABI_VERSION, CudaAlgorithm,
    CudaMatmulDescriptor, CudaStream, CublasLtHandle}
import accelerator.cuda.error.{CudaNativeStatus, CudaError, cudaError,
    cudaSucceeded}
import core.result.{Result}
import seen_qwen.backend.cuda.reference_primitives.{QWEN_CUDA_REFERENCE_ABI_VERSION,
    QwenCudaBufferView, seen_qwen_swiglu_low_precision,
    seen_qwen_greedy_argmax_low_precision}

let QWEN_CUDA_PROJECTION_F16: Int32 = 1 as Int32
let QWEN_CUDA_PROJECTION_BF16: Int32 = 2 as Int32

fun qwenProjectionError(deviceOrdinal: Int32, message: String) r: CudaError {
    return CudaError{ code: 1 as Int32, nativeCode: 0 as Int32,
        deviceOrdinal: deviceOrdinal, maturity: 2 as Int32,
        operation: "qwen.projection.select", message: message,
        sourceFile: "<qwen-cuda-projection>", sourceLine: 0,
        sourceColumn: 0 }
}

/// Construct the complete descriptor for X[tokens,input] times
/// W[output,input]^T into Y[tokens,output]. No allocation or CUDA operation is
/// performed. Leading dimensions describe the column-major views of the
/// caller-owned row-major buffers.
pub fun qwenCudaProjectionDescriptor(tokenCount: UInt64,
    inputWidth: UInt64, outputWidth: UInt64, dataType: Int32,
    workspaceLimitBytes: UInt64) r: Result<CudaMatmulDescriptor, CudaError> {
    let dimensionLimit = 0x7FFFFFFF as UInt64
    let workspaceLimit = 0x7FFFFFFFFFFFFFFF as UInt64
    if tokenCount == (0 as UInt64) or inputWidth == (0 as UInt64) or
        outputWidth == (0 as UInt64) or tokenCount > dimensionLimit or
        inputWidth > dimensionLimit or outputWidth > dimensionLimit {
        return Err<CudaMatmulDescriptor, CudaError>(qwenProjectionError(
            -1 as Int32, "projection dimensions are outside the bounded ABI"))
    }
    if dataType != QWEN_CUDA_PROJECTION_F16 and
        dataType != QWEN_CUDA_PROJECTION_BF16 {
        return Err<CudaMatmulDescriptor, CudaError>(qwenProjectionError(
            -1 as Int32, "projection dtype must be F16 or BF16"))
    }
    if workspaceLimitBytes > workspaceLimit {
        return Err<CudaMatmulDescriptor, CudaError>(qwenProjectionError(
            -1 as Int32, "projection workspace limit exceeds the bounded ABI"))
    }
    return Ok<CudaMatmulDescriptor, CudaError>(CudaMatmulDescriptor{
        abiVersion: CUDA_ABI_VERSION, dataType: dataType,
        transposeA: 1 as Int32, transposeB: 0 as Int32,
        m: outputWidth, n: tokenCount, k: inputWidth,
        leadingA: inputWidth as Int64, leadingB: inputWidth as Int64,
        leadingC: outputWidth as Int64,
        workspaceLimitBytes: workspaceLimitBytes })
}

/// Process-local, non-serializable selection. It borrows the Seen-owned
/// cuBLASLt handle only during creation and owns no CUDA allocation or handle.
/// Reuse is permitted only for the exact device and descriptor identity.
@move
pub class QwenCudaProjectionSelection {
    var descriptor: CudaMatmulDescriptor
    var algorithm: CudaAlgorithm
    var deviceOrdinal: Int32
    var active: Bool

    fun matches(deviceOrdinal: Int32, tokenCount: UInt64,
        inputWidth: UInt64, outputWidth: UInt64, dataType: Int32,
        workspaceLimitBytes: UInt64) r: Bool {
        return this.active and this.deviceOrdinal == deviceOrdinal and
            this.descriptor.abiVersion == CUDA_ABI_VERSION and
            this.descriptor.dataType == dataType and
            this.descriptor.transposeA == (1 as Int32) and
            this.descriptor.transposeB == (0 as Int32) and
            this.descriptor.m == outputWidth and
            this.descriptor.n == tokenCount and
            this.descriptor.k == inputWidth and
            this.descriptor.leadingA == inputWidth as Int64 and
            this.descriptor.leadingB == inputWidth as Int64 and
            this.descriptor.leadingC == outputWidth as Int64 and
            this.descriptor.workspaceLimitBytes == workspaceLimitBytes and
            this.algorithm.cacheIdentity != (0 as UInt64) and
            this.algorithm.workspaceBytes <= workspaceLimitBytes
    }

    fun close() r: Bool {
        if not this.active { return false }
        this.algorithm = CudaAlgorithm{ algorithmId: 0 as Int32,
            tileId: 0 as Int32, splitK: 0 as Int32,
            reductionScheme: 0 as Int32, workspaceBytes: 0 as UInt64,
            cacheIdentity: 0 as UInt64 }
        this.active = false
        return true
    }
}

pub fun selectQwenCudaProjection(handle: CublasLtHandle,
    deviceOrdinal: Int32, tokenCount: UInt64, inputWidth: UInt64,
    outputWidth: UInt64, dataType: Int32, workspaceLimitBytes: UInt64)
    r: Result<QwenCudaProjectionSelection, CudaError> {
    if handle.handle == (0 as UInt64) or handle.device != deviceOrdinal {
        return Err<QwenCudaProjectionSelection, CudaError>(qwenProjectionError(
            deviceOrdinal, "projection selection requires the live matching Seen handle"))
    }
    let made = qwenCudaProjectionDescriptor(tokenCount, inputWidth,
        outputWidth, dataType, workspaceLimitBytes)
    if made.isErr() {
        return Err<QwenCudaProjectionSelection, CudaError>(made.unwrapErr())
    }
    let descriptor = made.unwrap()
    let selected = handle.selectAlgorithm(descriptor)
    if selected.isErr() {
        return Err<QwenCudaProjectionSelection, CudaError>(selected.unwrapErr())
    }
    return Ok<QwenCudaProjectionSelection, CudaError>(
        QwenCudaProjectionSelection{ descriptor: descriptor,
            algorithm: selected.unwrap(), deviceOrdinal: deviceOrdinal,
            active: true })
}

fun qwenProjectionBytes(left: UInt64, right: UInt64) r: UInt64 {
    let limit = 0x7FFFFFFFFFFFFFFF as UInt64
    if left == (0 as UInt64) or right == (0 as UInt64) or
        left > limit / right { return 0 as UInt64 }
    let elements = left * right
    if elements > limit / (2 as UInt64) { return 0 as UInt64 }
    return elements * (2 as UInt64)
}

fun qwenProjectionViewValid(view: QwenCudaBufferView,
    deviceOrdinal: Int32, requiredBytes: UInt64) r: Bool {
    return view.abiVersion == QWEN_CUDA_REFERENCE_ABI_VERSION and
        view.deviceOrdinal == deviceOrdinal and view.address != (0 as UInt64) and
        requiredBytes != (0 as UInt64) and view.byteLength >= requiredBytes
}

extern "C" fun seen_cublaslt_select_algorithm(handle: UInt64,
    descriptor: *const CudaMatmulDescriptor,
    algorithm: *CudaAlgorithm) r: CudaNativeStatus
extern "C" fun seen_cublaslt_matmul(handle: UInt64,
    descriptor: *const CudaMatmulDescriptor,
    algorithm: *const CudaAlgorithm, a: *const Void, b: *const Void,
    c: *Void, workspace: *Void, stream: UInt64)
    r: CudaNativeStatus

/// Enqueue the exact pinned Qwen3.8 text MLP:
/// down_proj(SiLU(gate_proj(x)) * up_proj(x)). The three selections and every
/// buffer views are borrowed from caller-owned, preallocated device storage.
/// Gate and activation may be the same exact view. The executor owns the one
/// Seen handle and stream used for all four enqueues and closes them
/// deterministically; it never allocates in execute().
@move
pub class QwenCudaFfnExecutor {
    var handle: CublasLtHandle
    var stream: CudaStream
    var gateSelection: QwenCudaProjectionSelection
    var upSelection: QwenCudaProjectionSelection
    var downSelection: QwenCudaProjectionSelection
    var deviceOrdinal: Int32
    var active: Bool

    fun execute(input: QwenCudaBufferView, gateWeight: QwenCudaBufferView,
        upWeight: QwenCudaBufferView, downWeight: QwenCudaBufferView,
        gateOutput: QwenCudaBufferView, upOutput: QwenCudaBufferView,
        activation: QwenCudaBufferView, output: QwenCudaBufferView,
        workspace: QwenCudaBufferView) r: Result<Bool, CudaError> {
        let gate = this.gateSelection.descriptor
        let up = this.upSelection.descriptor
        let down = this.downSelection.descriptor
        if not this.active or gate.dataType != up.dataType or
            gate.dataType != down.dataType or gate.n != up.n or
            gate.n != down.n or gate.k != up.k or gate.m != up.m or
            down.k != gate.m or down.m != gate.k {
            return Err<Bool, CudaError>(qwenProjectionError(this.deviceOrdinal,
                "FFN executor is closed or internally incompatible"))
        }
        let inputBytes = qwenProjectionBytes(gate.n, gate.k)
        let intermediateBytes = qwenProjectionBytes(gate.n, gate.m)
        let gateWeightBytes = qwenProjectionBytes(gate.m, gate.k)
        let downWeightBytes = qwenProjectionBytes(down.m, down.k)
        let outputBytes = qwenProjectionBytes(down.n, down.m)
        if not qwenProjectionViewValid(input, this.deviceOrdinal, inputBytes) or
            not qwenProjectionViewValid(gateWeight, this.deviceOrdinal,
                gateWeightBytes) or
            not qwenProjectionViewValid(upWeight, this.deviceOrdinal,
                gateWeightBytes) or
            not qwenProjectionViewValid(downWeight, this.deviceOrdinal,
                downWeightBytes) or
            not qwenProjectionViewValid(gateOutput, this.deviceOrdinal,
                intermediateBytes) or
            not qwenProjectionViewValid(upOutput, this.deviceOrdinal,
                intermediateBytes) or
            not qwenProjectionViewValid(activation, this.deviceOrdinal,
                intermediateBytes) or
            not qwenProjectionViewValid(output, this.deviceOrdinal,
                outputBytes) or gateOutput.address == upOutput.address or
            activation.address == upOutput.address or
            (activation.address != gateOutput.address and
                activation.address == input.address) {
            return Err<Bool, CudaError>(qwenProjectionError(this.deviceOrdinal,
                "FFN received invalid or incompatible bounded buffer views"))
        }
        let workspaceRequired = this.gateSelection.algorithm.workspaceBytes
        var required = workspaceRequired
        if this.upSelection.algorithm.workspaceBytes > required {
            required = this.upSelection.algorithm.workspaceBytes
        }
        if this.downSelection.algorithm.workspaceBytes > required {
            required = this.downSelection.algorithm.workspaceBytes
        }
        if required > (0 as UInt64) and
            not qwenProjectionViewValid(workspace, this.deviceOrdinal, required) {
            return Err<Bool, CudaError>(qwenProjectionError(this.deviceOrdinal,
                "FFN workspace is absent, closed, or too small"))
        }
        var status = seen_cublaslt_matmul(this.handle.handle, &gate,
            &this.gateSelection.algorithm, gateWeight.address as *const Void,
            input.address as *const Void, gateOutput.address as *Void,
            workspace.address as *Void, this.stream.handle)
        if not cudaSucceeded(status) {
            return Err<Bool, CudaError>(cudaError(status))
        }
        status = seen_cublaslt_matmul(this.handle.handle, &up,
            &this.upSelection.algorithm, upWeight.address as *const Void,
            input.address as *const Void, upOutput.address as *Void,
            workspace.address as *Void, this.stream.handle)
        if not cudaSucceeded(status) {
            return Err<Bool, CudaError>(cudaError(status))
        }
        let borrowed = this.stream.borrowLaunchToken()
        if borrowed.isErr() { return Err<Bool, CudaError>(borrowed.unwrapErr()) }
        let token = borrowed.unwrap()
        status = seen_qwen_swiglu_low_precision(&token, gateOutput, upOutput,
            activation, gate.n * gate.m, gate.dataType)
        if not cudaSucceeded(status) {
            return Err<Bool, CudaError>(cudaError(status))
        }
        status = seen_cublaslt_matmul(this.handle.handle, &down,
            &this.downSelection.algorithm, downWeight.address as *const Void,
            activation.address as *const Void, output.address as *Void,
            workspace.address as *Void, this.stream.handle)
        if not cudaSucceeded(status) {
            return Err<Bool, CudaError>(cudaError(status))
        }
        return Ok<Bool, CudaError>(true)
    }

    fun close() r: Result<Bool, CudaError> {
        if not this.active { return Ok<Bool, CudaError>(false) }
        this.gateSelection.close(); this.upSelection.close()
        this.downSelection.close()
        let handleClosed = this.handle.close()
        let streamClosed = this.stream.close()
        this.active = false
        if handleClosed.isErr() {
            return Err<Bool, CudaError>(handleClosed.unwrapErr())
        }
        if streamClosed.isErr() {
            return Err<Bool, CudaError>(streamClosed.unwrapErr())
        }
        return Ok<Bool, CudaError>(true)
    }
}

fun qwenSelectFfnProjection(handle: UInt64,
    descriptor: CudaMatmulDescriptor, deviceOrdinal: Int32)
    r: Result<QwenCudaProjectionSelection, CudaError> {
    var algorithm = CudaAlgorithm{ algorithmId: 0 as Int32,
        tileId: 0 as Int32, splitK: 0 as Int32,
        reductionScheme: 0 as Int32, workspaceBytes: 0 as UInt64,
        cacheIdentity: 0 as UInt64 }
    let status = seen_cublaslt_select_algorithm(handle, &descriptor, &algorithm)
    if not cudaSucceeded(status) {
        return Err<QwenCudaProjectionSelection, CudaError>(cudaError(status))
    }
    return Ok<QwenCudaProjectionSelection, CudaError>(
        QwenCudaProjectionSelection{ descriptor: descriptor,
            algorithm: algorithm, deviceOrdinal: deviceOrdinal, active: true })
}

pub fun createQwenCudaFfnExecutor(deviceOrdinal: Int32, tokenCount: UInt64,
    hiddenWidth: UInt64, intermediateWidth: UInt64, dataType: Int32,
    workspaceLimitBytes: UInt64)
    r: Result<QwenCudaFfnExecutor, CudaError> {
    let gateDescriptor = qwenCudaProjectionDescriptor(tokenCount, hiddenWidth,
        intermediateWidth, dataType, workspaceLimitBytes)
    if gateDescriptor.isErr() {
        return Err<QwenCudaFfnExecutor, CudaError>(gateDescriptor.unwrapErr())
    }
    let downDescriptor = qwenCudaProjectionDescriptor(tokenCount,
        intermediateWidth, hiddenWidth, dataType, workspaceLimitBytes)
    if downDescriptor.isErr() {
        return Err<QwenCudaFfnExecutor, CudaError>(downDescriptor.unwrapErr())
    }
    let madeHandle = CublasLtHandle.create(deviceOrdinal)
    if madeHandle.isErr() {
        return Err<QwenCudaFfnExecutor, CudaError>(madeHandle.unwrapErr())
    }
    let madeStream = CudaStream.create(deviceOrdinal)
    if madeStream.isErr() {
        let _ = madeHandle.unwrap().close()
        return Err<QwenCudaFfnExecutor, CudaError>(madeStream.unwrapErr())
    }
    let handle = madeHandle.unwrap()
    let stream = madeStream.unwrap()
    let gate = qwenSelectFfnProjection(handle.handle, gateDescriptor.unwrap(),
        deviceOrdinal)
    if gate.isErr() {
        let _ = handle.close(); let _ = stream.close()
        return Err<QwenCudaFfnExecutor, CudaError>(gate.unwrapErr())
    }
    let up = qwenSelectFfnProjection(handle.handle, gateDescriptor.unwrap(),
        deviceOrdinal)
    if up.isErr() {
        gate.unwrap().close(); let _ = handle.close(); let _ = stream.close()
        return Err<QwenCudaFfnExecutor, CudaError>(up.unwrapErr())
    }
    let down = qwenSelectFfnProjection(handle.handle, downDescriptor.unwrap(),
        deviceOrdinal)
    if down.isErr() {
        gate.unwrap().close(); up.unwrap().close()
        let _ = handle.close(); let _ = stream.close()
        return Err<QwenCudaFfnExecutor, CudaError>(down.unwrapErr())
    }
    return Ok<QwenCudaFfnExecutor, CudaError>(QwenCudaFfnExecutor{
        handle: handle, stream: stream, gateSelection: gate.unwrap(),
        upSelection: up.unwrap(), downSelection: down.unwrap(),
        deviceOrdinal: deviceOrdinal, active: true })
}

fun qwenProjectionViewsOverlap(left: QwenCudaBufferView, leftBytes: UInt64,
    right: QwenCudaBufferView, rightBytes: UInt64) r: Bool {
    let limit = 0xFFFFFFFFFFFFFFFF as UInt64
    if leftBytes == (0 as UInt64) or rightBytes == (0 as UInt64) or
        left.address > limit - leftBytes or right.address > limit - rightBytes {
        return true
    }
    return left.address < right.address + rightBytes and
        right.address < left.address + leftBytes
}

/// Resident LM-head projection followed by deterministic greedy selection.
/// The executor owns one Seen handle/stream and process-local selection. Every
/// tensor remains caller-owned device storage; execute enqueues only and never
/// allocates, synchronizes, changes precision, or falls back.
@move
pub class QwenCudaLmHeadExecutor {
    var handle: CublasLtHandle
    var stream: CudaStream
    var selection: QwenCudaProjectionSelection
    var deviceOrdinal: Int32
    var active: Bool

    fun executeGreedy(hidden: QwenCudaBufferView,
        lmHeadWeight: QwenCudaBufferView, logits: QwenCudaBufferView,
        tokenIds: QwenCudaBufferView, workspace: QwenCudaBufferView)
        r: Result<Bool, CudaError> {
        let descriptor = this.selection.descriptor
        if not this.active or not this.selection.active or
            descriptor.dataType != QWEN_CUDA_PROJECTION_F16 and
                descriptor.dataType != QWEN_CUDA_PROJECTION_BF16 {
            return Err<Bool, CudaError>(qwenProjectionError(this.deviceOrdinal,
                "LM-head executor is closed or internally incompatible"))
        }
        let hiddenBytes = qwenProjectionBytes(descriptor.n, descriptor.k)
        let weightBytes = qwenProjectionBytes(descriptor.m, descriptor.k)
        let logitsBytes = qwenProjectionBytes(descriptor.n, descriptor.m)
        let limit = 0x7FFFFFFFFFFFFFFF as UInt64
        if descriptor.n > limit / (4 as UInt64) {
            return Err<Bool, CudaError>(qwenProjectionError(this.deviceOrdinal,
                "LM-head token output byte length overflows"))
        }
        let tokenBytes = descriptor.n * (4 as UInt64)
        if not qwenProjectionViewValid(hidden, this.deviceOrdinal, hiddenBytes) or
            not qwenProjectionViewValid(lmHeadWeight, this.deviceOrdinal,
                weightBytes) or
            not qwenProjectionViewValid(logits, this.deviceOrdinal, logitsBytes) or
            not qwenProjectionViewValid(tokenIds, this.deviceOrdinal, tokenBytes) or
            qwenProjectionViewsOverlap(hidden, hiddenBytes, lmHeadWeight,
                weightBytes) or
            qwenProjectionViewsOverlap(hidden, hiddenBytes, logits, logitsBytes) or
            qwenProjectionViewsOverlap(hidden, hiddenBytes, tokenIds, tokenBytes) or
            qwenProjectionViewsOverlap(lmHeadWeight, weightBytes, logits,
                logitsBytes) or
            qwenProjectionViewsOverlap(lmHeadWeight, weightBytes, tokenIds,
                tokenBytes) or
            qwenProjectionViewsOverlap(logits, logitsBytes, tokenIds, tokenBytes) {
            return Err<Bool, CudaError>(qwenProjectionError(this.deviceOrdinal,
                "LM-head received invalid or overlapping resident buffer views"))
        }
        let required = this.selection.algorithm.workspaceBytes
        if required > (0 as UInt64) and
            (not qwenProjectionViewValid(workspace, this.deviceOrdinal, required) or
             qwenProjectionViewsOverlap(workspace, required, hidden, hiddenBytes) or
             qwenProjectionViewsOverlap(workspace, required, lmHeadWeight,
                weightBytes) or
             qwenProjectionViewsOverlap(workspace, required, logits, logitsBytes) or
             qwenProjectionViewsOverlap(workspace, required, tokenIds, tokenBytes)) {
            return Err<Bool, CudaError>(qwenProjectionError(this.deviceOrdinal,
                "LM-head workspace is absent, overlapping, or too small"))
        }
        var status = seen_cublaslt_matmul(this.handle.handle, &descriptor,
            &this.selection.algorithm, lmHeadWeight.address as *const Void,
            hidden.address as *const Void, logits.address as *Void,
            workspace.address as *Void, this.stream.handle)
        if not cudaSucceeded(status) {
            return Err<Bool, CudaError>(cudaError(status))
        }
        let borrowed = this.stream.borrowLaunchToken()
        if borrowed.isErr() { return Err<Bool, CudaError>(borrowed.unwrapErr()) }
        let token = borrowed.unwrap()
        status = seen_qwen_greedy_argmax_low_precision(&token, logits,
            tokenIds, descriptor.n, descriptor.m, descriptor.m,
            descriptor.dataType)
        if not cudaSucceeded(status) {
            return Err<Bool, CudaError>(cudaError(status))
        }
        return Ok<Bool, CudaError>(true)
    }

    fun close() r: Result<Bool, CudaError> {
        if not this.active { return Ok<Bool, CudaError>(false) }
        this.selection.close()
        let handleClosed = this.handle.close()
        let streamClosed = this.stream.close()
        this.active = false
        if handleClosed.isErr() {
            return Err<Bool, CudaError>(handleClosed.unwrapErr())
        }
        if streamClosed.isErr() {
            return Err<Bool, CudaError>(streamClosed.unwrapErr())
        }
        return Ok<Bool, CudaError>(true)
    }
}

pub fun createQwenCudaLmHeadExecutor(deviceOrdinal: Int32,
    tokenCount: UInt64, hiddenWidth: UInt64, vocabularySize: UInt64,
    dataType: Int32, workspaceLimitBytes: UInt64)
    r: Result<QwenCudaLmHeadExecutor, CudaError> {
    let descriptor = qwenCudaProjectionDescriptor(tokenCount, hiddenWidth,
        vocabularySize, dataType, workspaceLimitBytes)
    if descriptor.isErr() {
        return Err<QwenCudaLmHeadExecutor, CudaError>(descriptor.unwrapErr())
    }
    let madeHandle = CublasLtHandle.create(deviceOrdinal)
    if madeHandle.isErr() {
        return Err<QwenCudaLmHeadExecutor, CudaError>(madeHandle.unwrapErr())
    }
    let madeStream = CudaStream.create(deviceOrdinal)
    if madeStream.isErr() {
        let _ = madeHandle.unwrap().close()
        return Err<QwenCudaLmHeadExecutor, CudaError>(madeStream.unwrapErr())
    }
    let handle = madeHandle.unwrap()
    let stream = madeStream.unwrap()
    let selection = selectQwenCudaProjection(handle, deviceOrdinal,
        tokenCount, hiddenWidth, vocabularySize, dataType,
        workspaceLimitBytes)
    if selection.isErr() {
        let _ = handle.close(); let _ = stream.close()
        return Err<QwenCudaLmHeadExecutor, CudaError>(selection.unwrapErr())
    }
    return Ok<QwenCudaLmHeadExecutor, CudaError>(QwenCudaLmHeadExecutor{
        handle: handle, stream: stream, selection: selection.unwrap(),
        deviceOrdinal: deviceOrdinal, active: true })
}
