///
Deterministic tensor catalog for the pinned Qwen3.8-27B safetensors index.

Model revision: 1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0
Index SHA-256: 77042094076611b69791a610065f28b7013b8c621795fa86ddccc8bac7d1b9df
Canonical catalog SHA-256:
5f466d43bae3059e54f0bfe183d0e82c822242f45a834d778414d3e5b5248f1f
Contract test: FEL-1397 / QWN-021B
///

import core.result.{Result}
import crypto.sha256.{sha256}
import formats.safetensors.{SafeTensorShardIndex, parseSafeTensorShardIndex}
import str.string.{StringBuilder}

extern "C" fun seen_string_release_owned(value: String) r: Void

let QWEN_TENSOR_REQUIRED_TEXT: Int = 1
let QWEN_TENSOR_REQUIRED_MTP: Int = 2
let QWEN_TENSOR_EXCLUDED_VISION: Int = 3

pub class QwenTensorCatalogError {
    var code: String
    var field: String
    var message: String
}

pub class QwenTensorCatalog {
    var shardIndex: SafeTensorShardIndex
    var categories: Array<Int>
    var requiredTextTensors: Int
    var requiredMtpTensors: Int
    var excludedVisionTensors: Int
    var fingerprint: String
    var closed: Bool

    fun length() r: Int {
        if this.closed { return 0 }
        return this.categories.length()
    }

    fun nameAt(index: Int) r: Result<String, QwenTensorCatalogError> {
        let valid = qwenCatalogIndexValid(this, index)
        if valid.isErr() {
            return Err<String, QwenTensorCatalogError>(valid.unwrapErr())
        }
        return Ok<String, QwenTensorCatalogError>(
            this.shardIndex.tensorNames[index])
    }

    fun shardAt(index: Int) r: Result<String, QwenTensorCatalogError> {
        let valid = qwenCatalogIndexValid(this, index)
        if valid.isErr() {
            return Err<String, QwenTensorCatalogError>(valid.unwrapErr())
        }
        return Ok<String, QwenTensorCatalogError>(
            this.shardIndex.shardNames[index])
    }

    fun categoryAt(index: Int) r: Result<String, QwenTensorCatalogError> {
        let valid = qwenCatalogIndexValid(this, index)
        if valid.isErr() {
            return Err<String, QwenTensorCatalogError>(valid.unwrapErr())
        }
        return Ok<String, QwenTensorCatalogError>(
            qwenTensorCategoryName(this.categories[index]))
    }

    fun categoryFor(name: String) r: Result<String, QwenTensorCatalogError> {
        if this.closed {
            return Err<String, QwenTensorCatalogError>(qwenCatalogError(
                "qwen.catalog.closed", "catalog",
                "tensor catalog is closed"))
        }
        var index = 0
        while index < this.shardIndex.tensorNames.length() {
            if this.shardIndex.tensorNames[index] == name {
                return Ok<String, QwenTensorCatalogError>(
                    qwenTensorCategoryName(this.categories[index]))
            }
            index = index + 1
        }
        return Err<String, QwenTensorCatalogError>(qwenCatalogError(
            "qwen.catalog.missing", "tensor_name",
            "tensor is absent from the pinned catalog"))
    }

    fun shouldExtractAt(index: Int) r: Result<Bool, QwenTensorCatalogError> {
        let valid = qwenCatalogIndexValid(this, index)
        if valid.isErr() {
            return Err<Bool, QwenTensorCatalogError>(valid.unwrapErr())
        }
        return Ok<Bool, QwenTensorCatalogError>(
            this.categories[index] != QWEN_TENSOR_EXCLUDED_VISION)
    }

    fun close() r: Void {
        if this.closed { return }
        this.categories.free()
        this.shardIndex.close()
        seen_string_release_owned(this.fingerprint)
        this.closed = true
    }
}

fun qwenCatalogError(code: String, field: String, message: String)
    r: QwenTensorCatalogError {
    return QwenTensorCatalogError{ code: code, field: field, message: message }
}

fun qwenTensorCategoryName(category: Int) r: String {
    if category == QWEN_TENSOR_REQUIRED_TEXT { return "text" }
    if category == QWEN_TENSOR_REQUIRED_MTP { return "mtp" }
    if category == QWEN_TENSOR_EXCLUDED_VISION { return "vision" }
    return "unsupported_unknown"
}

pub fun classifyQwenTensorName(name: String)
    r: Result<String, QwenTensorCatalogError> {
    if name == "lm_head.weight" or
        (name.length() > 21 and name.startsWith("model.language_model.")) {

        return Ok<String, QwenTensorCatalogError>("text")
    }
    if name.length() > 4 and name.startsWith("mtp.") {
        return Ok<String, QwenTensorCatalogError>("mtp")
    }
    if name.length() > 13 and name.startsWith("model.visual.") {
        return Ok<String, QwenTensorCatalogError>("vision")
    }
    return Err<String, QwenTensorCatalogError>(qwenCatalogError(
        "qwen.catalog.unknown", "tensor_name",
        "tensor name is outside the pinned text, MTP, and vision namespaces"))
}

fun qwenTensorCategoryCode(name: String)
    r: Result<Int, QwenTensorCatalogError> {
    let category = classifyQwenTensorName(name)
    if category.isErr() {
        return Err<Int, QwenTensorCatalogError>(category.unwrapErr())
    }
    if category.unwrap() == "text" {
        return Ok<Int, QwenTensorCatalogError>(QWEN_TENSOR_REQUIRED_TEXT)
    }
    if category.unwrap() == "mtp" {
        return Ok<Int, QwenTensorCatalogError>(QWEN_TENSOR_REQUIRED_MTP)
    }
    return Ok<Int, QwenTensorCatalogError>(QWEN_TENSOR_EXCLUDED_VISION)
}

fun qwenCatalogIndexValid(catalog: QwenTensorCatalog, index: Int)
    r: Result<Bool, QwenTensorCatalogError> {
    if catalog.closed {
        return Err<Bool, QwenTensorCatalogError>(qwenCatalogError(
            "qwen.catalog.closed", "catalog", "tensor catalog is closed"))
    }
    if index < 0 or index >= catalog.categories.length() {
        return Err<Bool, QwenTensorCatalogError>(qwenCatalogError(
            "qwen.catalog.index", "index",
            "tensor catalog index is outside the bounded catalog"))
    }
    return Ok<Bool, QwenTensorCatalogError>(true)
}

fun releaseQwenCatalogParts(index: SafeTensorShardIndex,
    categories: Array<Int>) r: Void {
    categories.free()
    index.close()
}

pub fun parseQwenTensorCatalog(indexText: String)
    r: Result<QwenTensorCatalog, QwenTensorCatalogError> {
    let parsed = parseSafeTensorShardIndex(indexText,
        1048576 as UInt64, 2048 as UInt64)
    if parsed.isErr() {
        return Err<QwenTensorCatalog, QwenTensorCatalogError>(qwenCatalogError(
            "qwen.catalog.index-json", "index",
            parsed.unwrapErr().message))
    }
    let shardIndex = parsed.unwrap()
    let categories = Array<Int>()
    if shardIndex.tensorNames.length() != 1199 {
        releaseQwenCatalogParts(shardIndex, categories)
        return Err<QwenTensorCatalog, QwenTensorCatalogError>(qwenCatalogError(
            "qwen.catalog.count", "weight_map",
            "the pinned catalog must contain exactly 1199 tensors"))
    }

    let canonical = StringBuilder.new()
    var requiredText = 0
    var requiredMtp = 0
    var excludedVision = 0
    var tensorIndex = 0
    while tensorIndex < shardIndex.tensorNames.length() {
        let name = shardIndex.tensorNames[tensorIndex]
        let classified = qwenTensorCategoryCode(name)
        if classified.isErr() {
            canonical.clear(); canonical.free()
            releaseQwenCatalogParts(shardIndex, categories)
            return Err<QwenTensorCatalog, QwenTensorCatalogError>(
                classified.unwrapErr())
        }
        let category = classified.unwrap()
        categories.push(category)
        if category == QWEN_TENSOR_REQUIRED_TEXT {
            requiredText = requiredText + 1
        } else if category == QWEN_TENSOR_REQUIRED_MTP {
            requiredMtp = requiredMtp + 1
        } else {
            excludedVision = excludedVision + 1
        }
        canonical.append(qwenTensorCategoryName(category))
        canonical.append("\t")
        canonical.append(name)
        canonical.append("\t")
        canonical.append(shardIndex.shardNames[tensorIndex])
        canonical.append("\n")
        tensorIndex = tensorIndex + 1
    }

    if requiredText != 851 or requiredMtp != 15 or excludedVision != 333 {
        canonical.clear(); canonical.free()
        releaseQwenCatalogParts(shardIndex, categories)
        return Err<QwenTensorCatalog, QwenTensorCatalogError>(qwenCatalogError(
            "qwen.catalog.class-count", "weight_map",
            "text, MTP, and vision tensor counts do not match the lock"))
    }

    let canonicalText = canonical.buildAndClear()
    canonical.free()
    let hashed = sha256(canonicalText)
    seen_string_release_owned(canonicalText)
    if hashed.isErr() {
        releaseQwenCatalogParts(shardIndex, categories)
        return Err<QwenTensorCatalog, QwenTensorCatalogError>(qwenCatalogError(
            "qwen.catalog.hash", "weight_map",
            "failed to hash the canonical tensor catalog"))
    }
    let fingerprint = hashed.unwrap()
    if fingerprint !=
        "5f466d43bae3059e54f0bfe183d0e82c822242f45a834d778414d3e5b5248f1f" {
        seen_string_release_owned(fingerprint)
        releaseQwenCatalogParts(shardIndex, categories)
        return Err<QwenTensorCatalog, QwenTensorCatalogError>(qwenCatalogError(
            "qwen.catalog.fingerprint", "weight_map",
            "tensor names or shard assignments differ from the pinned catalog"))
    }

    return Ok<QwenTensorCatalog, QwenTensorCatalogError>(QwenTensorCatalog{
        shardIndex: shardIndex,
        categories: categories,
        requiredTextTensors: requiredText,
        requiredMtpTensors: requiredMtp,
        excludedVisionTensors: excludedVision,
        fingerprint: fingerprint,
        closed: false,
    })
}
