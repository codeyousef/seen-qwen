import core.result.{Result}
import json.strict.{StrictJsonLimits, parseStrictJson}
import json.parser.{destroyJsonParseResult}
import json.value.{JsonValue}

pub class QwenConfigError {
    var code: String
    var field: String
    var message: String
}

pub class Qwen38Config {
    var layers: Int
    var linearAttentionLayers: Int
    var fullAttentionLayers: Int
    var hiddenSize: Int
    var intermediateSize: Int
    var vocabularySize: Int
    var maxPositions: Int
    var fullAttentionInterval: Int
    var attentionHeads: Int
    var attentionKvHeads: Int
    var attentionHeadDim: Int
    var rotaryDim: Int
    var gdnKeyHeads: Int
    var gdnValueHeads: Int
    var gdnKeyHeadDim: Int
    var gdnValueHeadDim: Int
    var gdnConvKernel: Int
    var mtpLayers: Int
}

pub class QwenHybridMiniContract {
    var deterministicSeed: Int
    var layers: Int
    var linearAttentionLayers: Int
    var fullAttentionLayers: Int
    var hiddenSize: Int
    var intermediateSize: Int
    var vocabularySize: Int
    var maxPositions: Int
    var attentionHeads: Int
    var attentionKvHeads: Int
    var attentionHeadDim: Int
    var rotaryDim: Int
    var gdnKeyHeads: Int
    var gdnValueHeads: Int
    var gdnKeyHeadDim: Int
    var gdnValueHeadDim: Int
    var gdnConvKernel: Int
    var mtpLayers: Int
}

fun qwenConfigError(code: String, field: String, message: String)
    r: QwenConfigError {
    return QwenConfigError{ code: code, field: field, message: message }
}

fun qwenExactString(object: JsonValue, field: String, expected: String) r: Bool {
    let value = object.get(field)
    let matches = not value.isNone() and value.unwrap().isString() and
        value.unwrap().getString() == expected
    value.free()
    return matches
}

fun qwenExactBool(object: JsonValue, field: String, expected: Bool) r: Bool {
    let value = object.get(field)
    let matches = not value.isNone() and value.unwrap().isBool() and
        value.unwrap().getBool() == expected
    value.free()
    return matches
}

fun qwenExactNumber(object: JsonValue, field: String, expected: Float) r: Bool {
    let value = object.get(field)
    let matches = not value.isNone() and value.unwrap().isNumber() and
        value.unwrap().getNumber() == expected
    value.free()
    return matches
}

fun qwenExactArrayString(array: JsonValue, index: Int, expected: String)
    r: Bool {
    let value = array.getAt(index)
    let matches = not value.isNone() and value.unwrap().isString() and
        value.unwrap().getString() == expected
    value.free()
    return matches
}

fun qwenExactInt(object: JsonValue, field: String, expected: Int) r: Bool {
    return qwenExactNumber(object, field, expected.toFloat())
}

pub fun qwenLayerIsFullAttention(layerIndex: Int)
    r: Result<Bool, QwenConfigError> {
    if layerIndex < 0 or layerIndex >= 64 {
        return Err<Bool, QwenConfigError>(qwenConfigError(
            "qwen.config.layer-index", "layer_types",
            "layer index must be between 0 and 63"))
    }
    return Ok<Bool, QwenConfigError>(layerIndex % 4 == 3)
}

fun validateQwenLayerSchedule(config: JsonValue) r: Result<Bool, QwenConfigError> {
    let layerTypes = config.get("layer_types")
    if layerTypes.isNone() or not layerTypes.unwrap().isArray() or
        layerTypes.unwrap().length() != 64 {
        layerTypes.free()
        return Err<Bool, QwenConfigError>(qwenConfigError(
            "qwen.config.layer-count", "text_config.layer_types",
            "exactly 64 layer types are required"))
    }
    var layer = 0
    while layer < 64 {
        let entry = layerTypes.unwrap().getAt(layer)
        let expected = if layer % 4 == 3 {
            "full_attention"
        } else {
            "linear_attention"
        }
        if entry.isNone() or not entry.unwrap().isString() or
            entry.unwrap().getString() != expected {
            entry.free(); layerTypes.free()
            return Err<Bool, QwenConfigError>(qwenConfigError(
                "qwen.config.layer-schedule", "text_config.layer_types",
                "the pinned 3:1 linear/full attention schedule is required"))
        }
        entry.free()
        layer = layer + 1
    }
    layerTypes.free()
    return Ok<Bool, QwenConfigError>(true)
}

fun validateQwenRopeGeometry(config: JsonValue) r: Result<Bool, QwenConfigError> {
    let ropeValue = config.get("rope_parameters")
    if ropeValue.isNone() or not ropeValue.unwrap().isObject() {
        ropeValue.free()
        return Err<Bool, QwenConfigError>(qwenConfigError(
            "qwen.config.rope", "text_config.rope_parameters",
            "the pinned RoPE object is required"))
    }
    let rope = ropeValue.unwrap()
    ropeValue.free()
    if not qwenExactString(rope, "rope_type", "default") or
        not qwenExactNumber(rope, "rope_theta", 10000000.0) or
        not qwenExactNumber(rope, "partial_rotary_factor", 0.25) or
        not qwenExactBool(rope, "mrope_interleaved", true) {
        return Err<Bool, QwenConfigError>(qwenConfigError(
            "qwen.config.rope", "text_config.rope_parameters",
            "RoPE type, theta, partial factor, and interleaving must match the lock"))
    }
    let sectionValue = rope.get("mrope_section")
    if sectionValue.isNone() or not sectionValue.unwrap().isArray() or
        sectionValue.unwrap().length() != 3 {
        sectionValue.free()
        return Err<Bool, QwenConfigError>(qwenConfigError(
            "qwen.config.rope-section", "text_config.rope_parameters.mrope_section",
            "the text MRoPE section must contain three entries"))
    }
    let section = sectionValue.unwrap()
    sectionValue.free()
    var index = 0
    while index < 3 {
        let value = section.getAt(index)
        let expected = if index < 2 { 11.0 } else { 10.0 }
        if value.isNone() or not value.unwrap().isNumber() or
            value.unwrap().getNumber() != expected {
            value.free()
            return Err<Bool, QwenConfigError>(qwenConfigError(
                "qwen.config.rope-section",
                "text_config.rope_parameters.mrope_section",
                "the pinned MRoPE section [11, 11, 10] is required"))
        }
        value.free()
        index = index + 1
    }
    return Ok<Bool, QwenConfigError>(true)
}

pub fun parseQwen38Config(text: String)
    r: Result<Qwen38Config, QwenConfigError> {
    let limits = StrictJsonLimits{
        maxInputBytes: 1048576,
        maxDepth: 24,
        maxValues: 8192,
        maxStringBytes: 65536,
    }
    let parsed = parseStrictJson(text, limits)
    limits.free()
    if parsed.isErr() {
        let message = parsed.unwrapErr().message
        parsed.unwrapErr().free()
        parsed.releaseContainer()
        return Err<Qwen38Config, QwenConfigError>(qwenConfigError(
            "qwen.config.json", "json", message))
    }
    let document = parsed.unwrap()
    parsed.releaseContainer()
    let rootValue = document.value
    if rootValue.isNone() or not rootValue.unwrap().isObject() {
        destroyJsonParseResult(document, true)
        return Err<Qwen38Config, QwenConfigError>(qwenConfigError(
            "qwen.config.root", "json", "configuration root must be an object"))
    }
    let root = rootValue.unwrap()
    let architectures = root.get("architectures")
    let identityValid = not architectures.isNone() and
        architectures.unwrap().isArray() and
        architectures.unwrap().length() == 1 and
        qwenExactArrayString(architectures.unwrap(), 0,
            "Qwen3_5ForConditionalGeneration")
    architectures.free()
    if not identityValid or not qwenExactString(root, "model_type", "qwen3_5") or
        not qwenExactBool(root, "language_model_only", false) or
        not qwenExactBool(root, "tie_word_embeddings", false) {
        destroyJsonParseResult(document, true)
        return Err<Qwen38Config, QwenConfigError>(qwenConfigError(
            "qwen.config.identity", "identity",
            "top-level identity does not match the frozen Qwen3.8-27B contract"))
    }
    let textConfigValue = root.get("text_config")
    if textConfigValue.isNone() or not textConfigValue.unwrap().isObject() {
        textConfigValue.free()
        destroyJsonParseResult(document, true)
        return Err<Qwen38Config, QwenConfigError>(qwenConfigError(
            "qwen.config.text", "text_config", "text_config must be an object"))
    }
    let config = textConfigValue.unwrap()
    textConfigValue.free()
    if not qwenExactString(config, "model_type", "qwen3_5_text") or
        not qwenExactString(config, "dtype", "bfloat16") or
        not qwenExactInt(config, "num_hidden_layers", 64) or
        not qwenExactInt(config, "hidden_size", 5120) or
        not qwenExactInt(config, "intermediate_size", 17408) or
        not qwenExactInt(config, "vocab_size", 248320) or
        not qwenExactInt(config, "max_position_embeddings", 262144) or
        not qwenExactInt(config, "full_attention_interval", 4) or
        not qwenExactInt(config, "mtp_num_hidden_layers", 1) or
        not qwenExactBool(config, "mtp_use_dedicated_embeddings", false) or
        not qwenExactBool(config, "tie_word_embeddings", false) {
        destroyJsonParseResult(document, true)
        return Err<Qwen38Config, QwenConfigError>(qwenConfigError(
            "qwen.config.text-identity", "text_config",
            "text identity or core geometry does not match the frozen contract"))
    }
    if not qwenExactInt(config, "num_attention_heads", 24) or
        not qwenExactInt(config, "num_key_value_heads", 4) or
        not qwenExactInt(config, "head_dim", 256) or
        not qwenExactNumber(config, "partial_rotary_factor", 0.25) or
        not qwenExactBool(config, "attention_bias", false) or
        not qwenExactNumber(config, "attention_dropout", 0.0) or
        not qwenExactBool(config, "attn_output_gate", true) or
        not qwenExactNumber(config, "rms_norm_eps", 0.000001) {
        destroyJsonParseResult(document, true)
        return Err<Qwen38Config, QwenConfigError>(qwenConfigError(
            "qwen.config.attention", "text_config",
            "full-attention geometry or semantics does not match the frozen contract"))
    }
    if not qwenExactInt(config, "linear_num_key_heads", 16) or
        not qwenExactInt(config, "linear_num_value_heads", 48) or
        not qwenExactInt(config, "linear_key_head_dim", 128) or
        not qwenExactInt(config, "linear_value_head_dim", 128) or
        not qwenExactInt(config, "linear_conv_kernel_dim", 4) or
        not qwenExactString(config, "mamba_ssm_dtype", "float32") or
        not qwenExactString(config, "output_gate_type", "swish") or
        not qwenExactString(config, "hidden_act", "silu") {
        destroyJsonParseResult(document, true)
        return Err<Qwen38Config, QwenConfigError>(qwenConfigError(
            "qwen.config.gdn", "text_config",
            "Gated DeltaNet geometry or semantics does not match the frozen contract"))
    }
    let layers = validateQwenLayerSchedule(config)
    if layers.isErr() {
        let error = layers.unwrapErr()
        layers.releaseContainer()
        destroyJsonParseResult(document, true)
        return Err<Qwen38Config, QwenConfigError>(error)
    }
    layers.releaseContainer()
    let rope = validateQwenRopeGeometry(config)
    if rope.isErr() {
        let error = rope.unwrapErr()
        rope.releaseContainer()
        destroyJsonParseResult(document, true)
        return Err<Qwen38Config, QwenConfigError>(error)
    }
    rope.releaseContainer()
    destroyJsonParseResult(document, true)
    return Ok<Qwen38Config, QwenConfigError>(Qwen38Config{
        layers: 64,
        linearAttentionLayers: 48,
        fullAttentionLayers: 16,
        hiddenSize: 5120,
        intermediateSize: 17408,
        vocabularySize: 248320,
        maxPositions: 262144,
        fullAttentionInterval: 4,
        attentionHeads: 24,
        attentionKvHeads: 4,
        attentionHeadDim: 256,
        rotaryDim: 64,
        gdnKeyHeads: 16,
        gdnValueHeads: 48,
        gdnKeyHeadDim: 128,
        gdnValueHeadDim: 128,
        gdnConvKernel: 4,
        mtpLayers: 1,
    })
}

fun validateHybridMiniSchedule(root: JsonValue) r: Result<Bool, QwenConfigError> {
    let layerTypes = root.get("layer_types")
    if layerTypes.isNone() or not layerTypes.unwrap().isArray() or
        layerTypes.unwrap().length() != 8 {
        layerTypes.free()
        return Err<Bool, QwenConfigError>(qwenConfigError(
            "qwen.mini.schedule", "layer_types",
            "exactly eight layer types are required"))
    }
    var layer = 0
    while layer < 8 {
        let value = layerTypes.unwrap().getAt(layer)
        let expected = if layer % 4 == 3 {
            "full_attention"
        } else {
            "linear_attention"
        }
        if value.isNone() or not value.unwrap().isString() or
            value.unwrap().getString() != expected {
            value.free(); layerTypes.free()
            return Err<Bool, QwenConfigError>(qwenConfigError(
                "qwen.mini.schedule", "layer_types",
                "the exact 3:1 GDN/full-attention schedule is required"))
        }
        value.free()
        layer = layer + 1
    }
    layerTypes.free()
    return Ok<Bool, QwenConfigError>(true)
}

fun validateHybridMiniArrays(root: JsonValue) r: Result<Bool, QwenConfigError> {
    let sectionValue = root.get("mrope_section")
    if sectionValue.isNone() or not sectionValue.unwrap().isArray() or
        sectionValue.unwrap().length() != 3 {
        sectionValue.free()
        return Err<Bool, QwenConfigError>(qwenConfigError(
            "qwen.mini.semantics", "mrope_section",
            "the exact MRoPE section [1, 1, 1] is required"))
    }
    var index = 0
    while index < 3 {
        let value = sectionValue.unwrap().getAt(index)
        if value.isNone() or not value.unwrap().isNumber() or
            value.unwrap().getNumber() != 1.0 {
            value.free(); sectionValue.free()
            return Err<Bool, QwenConfigError>(qwenConfigError(
                "qwen.mini.semantics", "mrope_section",
                "the exact MRoPE section [1, 1, 1] is required"))
        }
        value.free()
        index = index + 1
    }
    sectionValue.free()
    let requiredValue = root.get("required_namespaces")
    if requiredValue.isNone() or not requiredValue.unwrap().isArray() or
        requiredValue.unwrap().length() != 3 {
        requiredValue.free()
        return Err<Bool, QwenConfigError>(qwenConfigError(
            "qwen.mini.namespaces", "required_namespaces",
            "the exact text, LM-head, and MTP namespaces are required"))
    }
    let required = requiredValue.unwrap()
    requiredValue.free()
    if not qwenExactArrayString(required, 0, "model.language_model.*") or
        not qwenExactArrayString(required, 1, "lm_head.weight") or
        not qwenExactArrayString(required, 2, "mtp.*") {
        return Err<Bool, QwenConfigError>(qwenConfigError(
            "qwen.mini.namespaces", "required_namespaces",
            "the exact text, LM-head, and MTP namespaces are required"))
    }
    let excludedValue = root.get("excluded_namespaces")
    if excludedValue.isNone() or not excludedValue.unwrap().isArray() or
        excludedValue.unwrap().length() != 1 {
        excludedValue.free()
        return Err<Bool, QwenConfigError>(qwenConfigError(
            "qwen.mini.namespaces", "excluded_namespaces",
            "the visual namespace must be excluded"))
    }
    let excluded = excludedValue.unwrap()
    excludedValue.free()
    if not qwenExactArrayString(excluded, 0, "model.visual.*") {
        return Err<Bool, QwenConfigError>(qwenConfigError(
            "qwen.mini.namespaces", "excluded_namespaces",
            "the visual namespace must be excluded"))
    }
    return Ok<Bool, QwenConfigError>(true)
}

/// Parse the exact deterministic QWN-023 hybrid mini-model fixture contract.
pub fun parseQwenHybridMiniContract(text: String)
    r: Result<QwenHybridMiniContract, QwenConfigError> {
    let limits = StrictJsonLimits{
        maxInputBytes: 16384,
        maxDepth: 8,
        maxValues: 128,
        maxStringBytes: 4096,
    }
    let parsed = parseStrictJson(text, limits)
    limits.free()
    if parsed.isErr() {
        let message = parsed.unwrapErr().message
        parsed.unwrapErr().free()
        parsed.releaseContainer()
        return Err<QwenHybridMiniContract, QwenConfigError>(qwenConfigError(
            "qwen.mini.parse", "json", message))
    }
    let document = parsed.unwrap()
    parsed.releaseContainer()
    let rootValue = document.value
    if rootValue.isNone() or not rootValue.unwrap().isObject() {
        destroyJsonParseResult(document, true)
        return Err<QwenHybridMiniContract, QwenConfigError>(qwenConfigError(
            "qwen.mini.identity", "json", "contract root must be an object"))
    }
    let root = rootValue.unwrap()
    if root.length() != 39 or
        not qwenExactString(root, "schema", "seen-qwen-hybrid-mini-v1") or
        not qwenExactString(root, "fixture_id", "qwen3_8_hybrid_mini_v1") or
        not qwenExactBool(root, "qwen_compatible", false) or
        not qwenExactInt(root, "deterministic_seed", 20260827) or
        not qwenExactString(root, "weights_dtype", "float32") {
        destroyJsonParseResult(document, true)
        return Err<QwenHybridMiniContract, QwenConfigError>(qwenConfigError(
            "qwen.mini.identity", "identity",
            "fixture identity, seed, dtype, and field set must match the lock"))
    }
    if not qwenExactInt(root, "num_hidden_layers", 8) or
        not qwenExactInt(root, "linear_attention_layers", 6) or
        not qwenExactInt(root, "full_attention_layers", 2) or
        not qwenExactInt(root, "hidden_size", 48) or
        not qwenExactInt(root, "intermediate_size", 160) or
        not qwenExactInt(root, "vocab_size", 256) or
        not qwenExactInt(root, "max_position_embeddings", 128) or
        not qwenExactInt(root, "full_attention_interval", 4) {
        destroyJsonParseResult(document, true)
        return Err<QwenHybridMiniContract, QwenConfigError>(qwenConfigError(
            "qwen.mini.geometry", "geometry",
            "core mini-model geometry must match the lock"))
    }
    if not qwenExactInt(root, "num_attention_heads", 6) or
        not qwenExactInt(root, "num_key_value_heads", 1) or
        not qwenExactInt(root, "head_dim", 24) or
        not qwenExactNumber(root, "partial_rotary_factor", 0.25) or
        not qwenExactInt(root, "rotary_dim", 6) or
        not qwenExactNumber(root, "rope_theta", 10000000.0) or
        not qwenExactBool(root, "mrope_interleaved", true) or
        not qwenExactBool(root, "attention_bias", false) or
        not qwenExactNumber(root, "attention_dropout", 0.0) or
        not qwenExactBool(root, "attn_output_gate", true) or
        not qwenExactNumber(root, "rms_norm_eps", 0.000001) {
        destroyJsonParseResult(document, true)
        return Err<QwenHybridMiniContract, QwenConfigError>(qwenConfigError(
            "qwen.mini.semantics", "attention",
            "attention and RoPE semantics must match the lock"))
    }
    if not qwenExactInt(root, "linear_num_key_heads", 2) or
        not qwenExactInt(root, "linear_num_value_heads", 6) or
        not qwenExactInt(root, "linear_key_head_dim", 8) or
        not qwenExactInt(root, "linear_value_head_dim", 8) or
        not qwenExactInt(root, "linear_conv_kernel_dim", 4) or
        not qwenExactString(root, "mamba_ssm_dtype", "float32") or
        not qwenExactString(root, "output_gate_type", "swish") or
        not qwenExactString(root, "hidden_act", "silu") or
        not qwenExactInt(root, "mtp_num_hidden_layers", 1) or
        not qwenExactBool(root, "mtp_use_dedicated_embeddings", false) or
        not qwenExactBool(root, "tie_word_embeddings", false) {
        destroyJsonParseResult(document, true)
        return Err<QwenHybridMiniContract, QwenConfigError>(qwenConfigError(
            "qwen.mini.semantics", "gdn-mtp",
            "GDN, FFN, and MTP semantics must match the lock"))
    }
    let schedule = validateHybridMiniSchedule(root)
    if schedule.isErr() {
        let error = schedule.unwrapErr()
        schedule.releaseContainer()
        destroyJsonParseResult(document, true)
        return Err<QwenHybridMiniContract, QwenConfigError>(error)
    }
    schedule.releaseContainer()
    let arrays = validateHybridMiniArrays(root)
    if arrays.isErr() {
        let error = arrays.unwrapErr()
        arrays.releaseContainer()
        destroyJsonParseResult(document, true)
        return Err<QwenHybridMiniContract, QwenConfigError>(error)
    }
    arrays.releaseContainer()
    destroyJsonParseResult(document, true)
    return Ok<QwenHybridMiniContract, QwenConfigError>(QwenHybridMiniContract{
        deterministicSeed: 20260827,
        layers: 8,
        linearAttentionLayers: 6,
        fullAttentionLayers: 2,
        hiddenSize: 48,
        intermediateSize: 160,
        vocabularySize: 256,
        maxPositions: 128,
        attentionHeads: 6,
        attentionKvHeads: 1,
        attentionHeadDim: 24,
        rotaryDim: 6,
        gdnKeyHeads: 2,
        gdnValueHeads: 6,
        gdnKeyHeadDim: 8,
        gdnValueHeadDim: 8,
        gdnConvKernel: 4,
        mtpLayers: 1,
    })
}
