fun validateTokenizer(root: JsonValue) r: Bool {
    let maybe = artifactField(root, "tokenizer")
    if maybe.isNone() or not maybe.unwrap().isArray() or
        maybe.unwrap().length() != 7 { return false }
    let paths = expectedAssetPaths(); let sizes = expectedAssetBytes()
    let digests = expectedAssetDigests()
    var valid = true; var index = 0
    while index < 7 and valid {
        let entry = maybe.unwrap().getAt(index)
        if entry.isNone() { valid = false; break }
        let fields = assetFields()
        let exact = artifactExactFields(entry.unwrap(), fields)
        fields.free()
        valid = exact and stringEquals(entry.unwrap(), "path", paths[index]) and
            stringEquals(entry.unwrap(), "bytes", sizes[index]) and
            stringEquals(entry.unwrap(), "sha256", digests[index])
        index = index + 1
    }
    paths.free(); sizes.free(); digests.free()
    return valid
}

fun validateBackendMemoryAndCreator(root: JsonValue) r: Bool {
    let backendMaybe = artifactField(root, "intended_backend")
    let memoryMaybe = artifactField(root, "memory")
    let creatorMaybe = artifactField(root, "created_by")
    let profilesMaybe = artifactField(root, "compatible_profiles")
    if backendMaybe.isNone() or memoryMaybe.isNone() or
        creatorMaybe.isNone() or profilesMaybe.isNone() or
        not profilesMaybe.unwrap().isArray() or
        profilesMaybe.unwrap().length() != 0 { return false }
    let backend = backendMaybe.unwrap(); let backendNames = backendFields()
    let backendExact = artifactExactFields(backend, backendNames)
    backendNames.free()
    let memory = memoryMaybe.unwrap(); let memoryNames = memoryFields()
    let memoryExact = artifactExactFields(memory, memoryNames)
    memoryNames.free()
    let creator = creatorMaybe.unwrap(); let creatorNames = createdByFields()
    let creatorExact = artifactExactFields(creator, creatorNames)
    creatorNames.free()
    return backendExact and stringEquals(backend, "kind", "cuda") and
        stringEquals(backend, "target", "sm_89") and
        boolEquals(backend, "bound", false) and memoryExact and
        decimalFieldValid(memory, "weight_bytes", false) and
        stringEquals(memory, "persistent_state_bytes", "0") and
        stringEquals(memory, "max_profile_bytes", "0") and
        stringEquals(memory, "status", "not-runtime-sized") and
        creatorExact and stringEquals(creator, "seen_version", "0.19.4") and
        stringEquals(creator, "seen_commit",
            "a05932e231e33c7512be3432e9d88a938466f820") and
        stringEquals(creator, "compiler_sha256",
            "44a90884a9ff188718ed839aed4c8d692c8c520216c6a7b072ca6d0d35aa7fbc") and
        stringEquals(creator, "compatibility_sha256",
            "f39aebda1fdafc20d04b6c6a0072a491afea3f8f9ab836fd173ead0d1fe1ea33") and
        stringEquals(creator, "cpu_baseline", "x86-64")
}

fun computeEngineId(root: JsonValue) r: Result<String, QwenEngineArtifactError> {
    let format = artifactField(root, "format").unwrap()
    let quant = artifactField(root, "quantization").unwrap()
    let material = "seen-qwen-engine-artifact-v1\n" +
        "model_lock_sha256=" + artifactField(root, "model_lock_sha256").unwrap().getString() + "\n" +
        "source_lock_sha256=" + artifactField(root, "source_lock_sha256").unwrap().getString() + "\n" +
        "weights_sha256=" + artifactField(format, "weights_sha256").unwrap().getString() + "\n" +
        "policy_sha256=" + artifactField(quant, "policy_sha256").unwrap().getString() + "\n" +
        "compiler_sha256=44a90884a9ff188718ed839aed4c8d692c8c520216c6a7b072ca6d0d35aa7fbc\n"
    let hashed = sha256(material)
    seen_string_release_owned(material)
    if hashed.isErr() {
        return Err<String, QwenEngineArtifactError>(artifactError(
            "qwen.artifact.checksum", "engine_id", "failed to hash engine identity"))
    }
    return Ok<String, QwenEngineArtifactError>(hashed.unwrap())
}

pub class QwenEngineArtifact {
    var document: JsonParseResult
    var manifestSha256: String
    var closed: Bool

    fun engineId() r: Result<String, QwenEngineArtifactError> {
        if this.closed {
            return Err<String, QwenEngineArtifactError>(artifactError(
                "qwen.artifact.closed", "artifact", "engine artifact is closed"))
        }
        return Ok<String, QwenEngineArtifactError>(artifactField(
            this.document.value.unwrap(), "engine_id").unwrap().getString())
    }

    fun weightBytes() r: Result<String, QwenEngineArtifactError> {
        if this.closed {
            return Err<String, QwenEngineArtifactError>(artifactError(
                "qwen.artifact.closed", "artifact", "engine artifact is closed"))
        }
        let format = artifactField(this.document.value.unwrap(), "format").unwrap()
        return Ok<String, QwenEngineArtifactError>(
            artifactField(format, "weights_bytes").unwrap().getString())
    }

    fun close() r: Void {
        if this.closed { return }
        destroyJsonParseResult(this.document, true)
        seen_string_release_owned(this.manifestSha256)
        this.closed = true
    }
}

pub fun parseQwenEngineArtifact(text: String)
    r: Result<QwenEngineArtifact, QwenEngineArtifactError> {
    if text.length() < 2 or text.length() > 1048576 {
        return Err<QwenEngineArtifact, QwenEngineArtifactError>(artifactError(
            "qwen.artifact.limit", "manifest", "manifest is empty or exceeds 1 MiB"))
    }
    let parsed = parseStrictJson(text, StrictJsonLimits{
        maxInputBytes: 1048576, maxDepth: 12, maxValues: 512,
        maxStringBytes: 4096,
    })
    if parsed.isErr() {
        return Err<QwenEngineArtifact, QwenEngineArtifactError>(artifactError(
            "qwen.artifact.json", "manifest", "manifest is not strict bounded JSON"))
    }
    let document = parsed.unwrap()
    if document.value.isNone() or not document.value.unwrap().isObject() {
        destroyJsonParseResult(document, true)
        return Err<QwenEngineArtifact, QwenEngineArtifactError>(artifactError(
            "qwen.artifact.schema", "manifest", "manifest root must be an object"))
    }
    let root = document.value.unwrap(); let fields = rootFields()
    let exact = artifactExactFields(root, fields); fields.free()
    if not exact or not stringEquals(root, "schema",
            "seen-qwen-engine-artifact-v1") or
        not intEquals(root, "version", 1) or
        not stringEquals(root, "maturity", "offline-validated") or
        not digestFieldValid(root, "engine_id") or
        not digestFieldValid(root, "model_lock_sha256") or
        not digestFieldValid(root, "source_lock_sha256") or
        not stringEquals(root, "checksums_file", "checksums.sha256") {
        destroyJsonParseResult(document, true)
        return Err<QwenEngineArtifact, QwenEngineArtifactError>(artifactError(
            "qwen.artifact.schema", "manifest", "root identity differs from the closed v1 contract"))
    }
    if not validateFormat(root) or not validateModel(root) or
        not validateQuantization(root) or not validateTokenizer(root) or
        not validateBackendMemoryAndCreator(root) {
        destroyJsonParseResult(document, true)
        return Err<QwenEngineArtifact, QwenEngineArtifactError>(artifactError(
            "qwen.artifact.compatibility", "manifest", "artifact components or maturity are incompatible"))
    }
    let expected = computeEngineId(root)
    if expected.isErr() or expected.unwrap() !=
        artifactField(root, "engine_id").unwrap().getString() {
        if expected.isOkay() { seen_string_release_owned(expected.unwrap()) }
        destroyJsonParseResult(document, true)
        return Err<QwenEngineArtifact, QwenEngineArtifactError>(artifactError(
            "qwen.artifact.identity", "engine_id", "engine identity does not match content identities"))
    }
    seen_string_release_owned(expected.unwrap())
    let digest = sha256(text)
    if digest.isErr() {
        destroyJsonParseResult(document, true)
        return Err<QwenEngineArtifact, QwenEngineArtifactError>(artifactError(
            "qwen.artifact.checksum", "manifest", "failed to hash validated manifest"))
    }
    return Ok<QwenEngineArtifact, QwenEngineArtifactError>(QwenEngineArtifact{
        document: document, manifestSha256: digest.unwrap(), closed: false,
    })
}
