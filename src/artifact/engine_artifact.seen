///
/// Strict offline engine-artifact manifest for the first complete Qwen3.8-27B
/// text and MTP SQW. The parsed JSON document owns every returned string.
/// Runtime CUDA/profile certification is intentionally absent at this stage.
///

import core.result.{Result}
import crypto.sha256.{sha256}
import json.parser.{JsonParseResult, destroyJsonParseResult}
import json.strict.{StrictJsonLimits, parseStrictJson}
import json.value.{JsonValue}

extern "C" fun seen_string_release_owned(value: String) r: Void

pub class QwenEngineArtifactError {
    var code: String
    var field: String
    var message: String
    var exitCode: Int
    var retryable: Bool
}

fun artifactError(code: String, field: String, message: String)
    r: QwenEngineArtifactError {
    let exitCode = if code == "qwen.artifact.closed" { 11 } else { 2 }
    return QwenEngineArtifactError{ code: code, field: field,
        message: message, exitCode: exitCode, retryable: false }
}

fun artifactField(object: JsonValue, field: String) r: JsonValue? {
    if not object.isObject() { return null }
    var index = 0
    while index < object.length() {
        let key = object.keyAt(index)
        let value = object.valueAt(index)
        if key.isNone() or value.isNone() { return null }
        if key.unwrap() == field { return value.unwrap() }
        index = index + 1
    }
    return null
}

fun artifactExactFields(object: JsonValue, fields: Array<String>) r: Bool {
    if not object.isObject() or object.length() != fields.length() {
        return false
    }
    var index = 0
    while index < object.length() {
        let key = object.keyAt(index)
        let value = object.valueAt(index)
        if key.isNone() or value.isNone() { return false }
        var found = false
        var fieldIndex = 0
        while fieldIndex < fields.length() {
            if key.unwrap() == fields[fieldIndex] { found = true }
            fieldIndex = fieldIndex + 1
        }
        if not found { return false }
        index = index + 1
    }
    return true
}

fun rootFields() r: Array<String> {
    let values = Array<String>()
    values.push("schema"); values.push("version"); values.push("maturity")
    values.push("engine_id"); values.push("model_lock_sha256")
    values.push("source_lock_sha256"); values.push("format")
    values.push("model"); values.push("quantization")
    values.push("tokenizer"); values.push("intended_backend")
    values.push("memory"); values.push("compatible_profiles")
    values.push("created_by"); values.push("checksums_file")
    return values
}

fun formatFields() r: Array<String> {
    let values = Array<String>()
    values.push("sqw_version"); values.push("weights_file")
    values.push("weights_sha256"); values.push("sqw_whole_sha256")
    values.push("tensor_count"); values.push("weights_bytes")
    return values
}

fun modelFields() r: Array<String> {
    let values = Array<String>()
    values.push("id"); values.push("revision"); values.push("contract")
    values.push("layers"); values.push("vocab_size")
    values.push("native_context"); values.push("text_tensors")
    values.push("mtp_tensors"); values.push("vision_tensors")
    return values
}

fun quantFields() r: Array<String> {
    let values = Array<String>()
    values.push("policy_id"); values.push("policy_sha256")
    values.push("source_dtype"); values.push("runtime_codec")
    values.push("tensor_count"); values.push("lossy")
    values.push("quality_approved"); values.push("fallback")
    return values
}

fun assetFields() r: Array<String> {
    let values = Array<String>()
    values.push("path"); values.push("bytes"); values.push("sha256")
    return values
}

fun backendFields() r: Array<String> {
    let values = Array<String>()
    values.push("kind"); values.push("target"); values.push("bound")
    return values
}

fun memoryFields() r: Array<String> {
    let values = Array<String>()
    values.push("weight_bytes"); values.push("persistent_state_bytes")
    values.push("max_profile_bytes"); values.push("status")
    return values
}

fun createdByFields() r: Array<String> {
    let values = Array<String>()
    values.push("seen_version"); values.push("seen_commit")
    values.push("compiler_sha256"); values.push("compatibility_sha256")
    values.push("cpu_baseline")
    return values
}

fun stringEquals(object: JsonValue, field: String, expected: String) r: Bool {
    let value = artifactField(object, field)
    return not value.isNone() and value.unwrap().isString() and
        value.unwrap().getString() == expected
}

fun intEquals(object: JsonValue, field: String, expected: Int) r: Bool {
    let value = artifactField(object, field)
    return not value.isNone() and value.unwrap().isNumber() and
        value.unwrap().getNumber() == expected.toFloat() and
        value.unwrap().getInt() == expected
}

fun boolEquals(object: JsonValue, field: String, expected: Bool) r: Bool {
    let value = artifactField(object, field)
    return not value.isNone() and value.unwrap().isBool() and
        value.unwrap().getBool() == expected
}

fun digestValid(value: String) r: Bool {
    if value.length() != 64 { return false }
    var index = 0
    while index < value.length() {
        let byte = value.byteAt(index)
        if not (byte >= 48 and byte <= 57) and
            not (byte >= 97 and byte <= 102) { return false }
        index = index + 1
    }
    return true
}

fun decimalValid(value: String, allowZero: Bool) r: Bool {
    if value.length() < 1 or value.length() > 19 { return false }
    if value.length() > 1 and value.byteAt(0) == 48 { return false }
    if not allowZero and value == "0" { return false }
    var index = 0
    while index < value.length() {
        let byte = value.byteAt(index)
        if byte < 48 or byte > 57 { return false }
        index = index + 1
    }
    return true
}

fun digestFieldValid(object: JsonValue, field: String) r: Bool {
    let value = artifactField(object, field)
    return not value.isNone() and value.unwrap().isString() and
        digestValid(value.unwrap().getString())
}

fun decimalFieldValid(object: JsonValue, field: String, allowZero: Bool)
    r: Bool {
    let value = artifactField(object, field)
    return not value.isNone() and value.unwrap().isString() and
        decimalValid(value.unwrap().getString(), allowZero)
}

fun validateFormat(root: JsonValue) r: Bool {
    let maybe = artifactField(root, "format")
    if maybe.isNone() { return false }
    let object = maybe.unwrap(); let fields = formatFields()
    let exact = artifactExactFields(object, fields); fields.free()
    return exact and stringEquals(object, "sqw_version", "1.0") and
        stringEquals(object, "weights_file", "weights.sqw") and
        digestFieldValid(object, "weights_sha256") and
        digestFieldValid(object, "sqw_whole_sha256") and
        intEquals(object, "tensor_count", 866) and
        decimalFieldValid(object, "weights_bytes", false)
}

fun validateModel(root: JsonValue) r: Bool {
    let maybe = artifactField(root, "model")
    if maybe.isNone() { return false }
    let object = maybe.unwrap(); let fields = modelFields()
    let exact = artifactExactFields(object, fields); fields.free()
    return exact and stringEquals(object, "id", "Qwen/Qwen3.8-27B") and
        stringEquals(object, "revision",
            "1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0") and
        stringEquals(object, "contract", "seen-qwen38-text-v1") and
        intEquals(object, "layers", 64) and
        intEquals(object, "vocab_size", 248320) and
        intEquals(object, "native_context", 262144) and
        intEquals(object, "text_tensors", 851) and
        intEquals(object, "mtp_tensors", 15) and
        intEquals(object, "vision_tensors", 0)
}

fun validateQuantization(root: JsonValue) r: Bool {
    let maybe = artifactField(root, "quantization")
    if maybe.isNone() { return false }
    let object = maybe.unwrap(); let fields = quantFields()
    let exact = artifactExactFields(object, fields); fields.free()
    return exact and stringEquals(object, "policy_id", "bf16-bringup-v1") and
        digestFieldValid(object, "policy_sha256") and
        stringEquals(object, "source_dtype", "BF16") and
        stringEquals(object, "runtime_codec", "BF16") and
        intEquals(object, "tensor_count", 866) and
        boolEquals(object, "lossy", false) and
        boolEquals(object, "quality_approved", false) and
        stringEquals(object, "fallback", "prohibited")
}

fun expectedAssetPaths() r: Array<String> {
    let values = Array<String>()
    values.push("README.md"); values.push("chat_template.jinja")
    values.push("config.json"); values.push("generation_config.json")
    values.push("merges.txt"); values.push("tokenizer_config.json")
    values.push("vocab.json")
    return values
}

fun expectedAssetBytes() r: Array<String> {
    let values = Array<String>()
    values.push("65012"); values.push("8952"); values.push("4312")
    values.push("202"); values.push("3353259"); values.push("17928")
    values.push("6722759")
    return values
}

fun expectedAssetDigests() r: Array<String> {
    let values = Array<String>()
    values.push("57e4bdb258ee1a7d2635c5174ebd4e56abe392505cdb5f8bbb356b0dc4293641")
    values.push("c3cf9e34abf4f9e36c2d72165aa9c132d3e2a725b6c2586aaa3a8af9d7a81041")
    values.push("191e0af232104ed8b65258cf3fb2b842e288008baca7633c11b82a1ac7203aab")
    values.push("e70c136c1b78ddc1fb0905bac8e733a4dc448d4f852a5dd75143fffc70be550e")
    values.push("a9d356d7bdf1ef4949e3e748e95b8e10ad9d4e2e838eddc38a0a7b6b94d1db8d")
    values.push("b11349aafa7cdc6a320767cf7ceb29ed82f7eda5d65e8e0819e76f0ce947bf27")
