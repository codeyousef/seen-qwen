{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seenlang.dev/schemas/qwen-sensitivity-oracle-v1.json",
  "title": "Seen Qwen deterministic sensitivity oracle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "ordering", "model_id", "model_revision",
    "calibration_lock_sha256", "element_limit", "activation_records",
    "comparison_records"
  ],
  "properties": {
    "schema": {"const": "seen-qwen-sensitivity-oracle-v1"},
    "version": {"const": 1},
    "ordering": {"const": "lexicographic-record-id"},
    "model_id": {"const": "Qwen/Qwen3.8-27B"},
    "model_revision": {
      "const": "1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0"
    },
    "calibration_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "element_limit": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "activation_records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/activationRecord"}
    },
    "comparison_records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/comparisonRecord"}
    }
  },
  "$defs": {
    "finiteNumber": {"type": "number"},
    "activationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "values", "expected"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "values": {
          "type": "array", "minItems": 1, "maxItems": 1048576,
          "items": {"$ref": "#/$defs/finiteNumber"}
        },
        "expected": {"$ref": "#/$defs/activationExpected"}
      }
    },
    "activationExpected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count", "minimum", "maximum", "maximum_absolute", "mean",
        "mean_absolute", "root_mean_square"
      ],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "minimum": {"$ref": "#/$defs/finiteNumber"},
        "maximum": {"$ref": "#/$defs/finiteNumber"},
        "maximum_absolute": {"$ref": "#/$defs/finiteNumber"},
        "mean": {"$ref": "#/$defs/finiteNumber"},
        "mean_absolute": {"$ref": "#/$defs/finiteNumber"},
        "root_mean_square": {"$ref": "#/$defs/finiteNumber"}
      }
    },
    "comparisonRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "reference", "candidate", "expected"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "kind": {"enum": ["tensor-quantization", "layer-output"]},
        "reference": {
          "type": "array", "minItems": 1, "maxItems": 1048576,
          "items": {"$ref": "#/$defs/finiteNumber"}
        },
        "candidate": {
          "type": "array", "minItems": 1, "maxItems": 1048576,
          "items": {"$ref": "#/$defs/finiteNumber"}
        },
        "expected": {"$ref": "#/$defs/comparisonExpected"}
      }
    },
    "comparisonExpected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count", "maximum_absolute_error", "mean_absolute_error",
        "root_mean_square_error", "relative_l2_error",
        "relative_l2_defined", "cosine_similarity", "cosine_defined", "exact"
      ],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "maximum_absolute_error": {"$ref": "#/$defs/finiteNumber"},
        "mean_absolute_error": {"$ref": "#/$defs/finiteNumber"},
        "root_mean_square_error": {"$ref": "#/$defs/finiteNumber"},
        "relative_l2_error": {"$ref": "#/$defs/finiteNumber"},
        "relative_l2_defined": {"type": "boolean"},
        "cosine_similarity": {"$ref": "#/$defs/finiteNumber"},
        "cosine_defined": {"type": "boolean"},
        "exact": {"type": "boolean"}
      }
    }
  }
}
